@@SCENE
#version 330 core
// UPS - Seek Spectrum: the music player's spectrum strip (UPS_MusicPlayerControlVisual), drawn on top of its seek bar.
// Bars rise from the strip's bottom edge, low frequencies on the left: each the live level of one of the fountain
// engine's right-wing columns (48..95, evenly low to high). Each bar blends, over its own height, from the cover's foot
// colour to its top colour - its two most striking hue families (VisualizerStripColors.cs: the darker at the foot; a
// one-hue cover gives dark-to-bright shades of it), which UniPlaySong sends as the cover's first two colours. Read as
// sent (uCoverA, uCoverB), not brought to full brightness like the palette's: that flattened a light-to-dark pair into
// one colour, and a one-hue cover's dark foot is meant to be dark.
// Black is see-through: the renderer keys transparency from brightness, so nothing but the bars shows.
uniform vec2 uRes;
uniform sampler2D uColA;                  // per column: x = live level (0 .. ~1)
uniform vec3 uCoverA, uCoverB;           // the bottom and top colours, 0..1 (eased by the renderer)
out vec4 outColor;
// Height: the level, tilted up toward the highs (they run lower) and curved (a power under 1 lifts the quiet and middle
// most). On Mass Effect Rift Station the median bar went from 0.31 to 0.59 of the strip, the highs' from 0.21 to 0.53,
// and a bar sits full only 3% of the time - so the peaks still stand out.
const float BARS = 32.0, GAP = 0.25, GAIN = 1.15, TILT = 0.8, CURVE = 0.6;
void main() {
  float x = gl_FragCoord.x / uRes.x, y = gl_FragCoord.y / uRes.y;
  float b = floor(x * BARS), f = fract(x * BARS);
  float level = texelFetch(uColA, ivec2(48 + int(b * 48.0 / BARS), 0), 0).x;
  float h = clamp(pow(max(level * GAIN * (1.0 + TILT * (b + 0.5) / BARS), 0.0), CURVE), 0.0, 1.0);
  if (f < GAP * 0.5 || f > 1.0 - GAP * 0.5 || y > h) { outColor = vec4(0.0, 0.0, 0.0, 1.0); return; }
  float t = y / max(h, 1e-3);   // up this bar: 0 its foot, 1 its top
  vec3 col = mix(uCoverA, uCoverB, t);
  outColor = vec4(col, 1.0);
}
@@BLUR
#version 330 core
uniform sampler2D uSrc;
uniform vec2 uDir;      // one destination texel along the blur
uniform vec2 uDst;      // destination size
out vec4 outColor;
void main() {
  vec2 uv = gl_FragCoord.xy / uDst;
  float w[5] = float[](0.227, 0.194, 0.122, 0.054, 0.016);
  vec3 c = texture(uSrc, uv).rgb * w[0];
  for (int i = 1; i < 5; i++) { c += texture(uSrc, uv + uDir * float(i)).rgb * w[i]; c += texture(uSrc, uv - uDir * float(i)).rgb * w[i]; }
  outColor = vec4(c, 1.0);
}
@@COMP
#version 330 core
// the bars as drawn: no bloom or glow (nothing spills past the strip; no flashing)
uniform vec2 uRes;
uniform sampler2D uScene;
out vec4 outColor;
void main() { outColor = vec4(texture(uScene, gl_FragCoord.xy / uRes).rgb, 1.0); }
