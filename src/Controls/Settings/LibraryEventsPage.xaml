<UserControl x:Class="UniPlaySong.Controls.Settings.LibraryEventsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UniPlaySong"
             xmlns:ups="clr-namespace:UniPlaySong.Controls.Settings"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UniPlaySong;component/Controls/Settings/SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Both events read in the same four steps: when it fires, what it sounds like, whether a
         toast shows, how the toast looks. Each step's controls sit in the same 32px column, so the
         eye tracks one left edge down the whole event.

         Both expanders start open. They held opposite defaults before, which made the page look
         like one event with an afterthought under it. The folds stay, unlike ControlUp's - there
         each fold hid the entire page, whereas these hold a sound picker and four toast controls
         apiece and are worth collapsing once set.

         Toast field labels take UpsLabel. They were UpsHint, the 10px muted style used for the
         explanatory sentence directly above them, so a field's name rendered the same as prose. -->

    <ScrollViewer Style="{StaticResource UpsPage}">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">

            <TextBlock Text="Library Events" Style="{StaticResource UpsPageTitle}"/>
            <TextBlock Style="{StaticResource UpsPageSubtitle}" Text="Sounds and toasts when a game changes status in your library."/>

            <Expander Style="{StaticResource UpsSection}">
                <Expander.Header>
                    <TextBlock ups:TrackedCaps.Text="Completed" Style="{StaticResource UpsSectionTitle}"/>
                </Expander.Header>
                <StackPanel>

                    <!-- When it fires. -->
                    <CheckBox Style="{StaticResource UpsToggle}" Content="Play Fanfare on Completed Games"
                              IsChecked="{Binding Settings.EnableCompletionCelebration}"/>
                    <TextBlock Style="{StaticResource UpsHint}" Text="Play a celebration sound when you mark a game as 'Completed' in Playnite"/>

                    <CheckBox Style="{StaticResource UpsToggleChild}" Content="Also celebrate when marked as 'Beaten'"
                              IsChecked="{Binding Settings.CelebrateBeaten}"
                              IsEnabled="{Binding Settings.EnableCompletionCelebration}"/>
                    <TextBlock Style="{StaticResource UpsHintIndented}" Text="Fires the same fanfare for Playnite's built-in 'Beaten' status (main story finished), in addition to 'Completed'"/>

                    <!-- What it sounds like. -->
                    <StackPanel Margin="32,4,0,0" IsEnabled="{Binding Settings.EnableCompletionCelebration}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <RadioButton Style="{StaticResource UpsSegmentFirstTeal}" Content="Jingle Preset"
                                         GroupName="CelebrationSound"
                                         IsChecked="{Binding Settings.CelebrationSoundType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=BundledJingle}"/>
                            <RadioButton Style="{StaticResource UpsSegmentLast}" Content="Custom sound file (.wav recommended)"
                                         GroupName="CelebrationSound"
                                         IsChecked="{Binding Settings.CelebrationSoundType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=CustomFile}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="{Binding Settings.CelebrationSoundType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=BundledJingle}">
                            <ComboBox Style="{StaticResource UpsComboBox}" ItemsSource="{Binding CelebrationJingles}"
                                      ItemTemplate="{StaticResource UpsDisplayNameTemplate}"
                                      SelectedValuePath="File"
                                      SelectedValue="{Binding Settings.SelectedCelebrationJingle}"
                                      Width="300" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource UpsButton}" Content="Preview" Padding="10,4"
                                    Command="{Binding PreviewCelebrationSoundCommand}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="{Binding Settings.CelebrationSoundType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=CustomFile}">
                            <TextBox Style="{StaticResource UpsTextBox}" Width="350" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                     Text="{Binding Settings.CelebrationSoundPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Style="{StaticResource UpsButton}" Content="Browse..." Padding="10,4"
                                    Command="{Binding BrowseCelebrationSoundCommand}"/>
                            <Button Style="{StaticResource UpsButton}" Content="Preview" Padding="10,4" Margin="6,0,0,0"
                                    Command="{Binding PreviewCelebrationSoundCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Whether a toast shows, and how it looks. -->
                    <CheckBox Style="{StaticResource UpsToggleChildFlush}" Content="Show celebration toast notification"
                              IsChecked="{Binding Settings.ShowCelebrationToast}"
                              IsEnabled="{Binding Settings.EnableCompletionCelebration}"/>
                    <TextBlock Style="{StaticResource UpsHint}" Text="Displays a congratulatory toast popup with a glow animation when a game is marked completed. Complements the celebration fanfare sound."/>

                    <Grid Margin="32,0,0,0" IsEnabled="{Binding Settings.ShowCelebrationToast}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Duration" Style="{StaticResource UpsLabel}"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,5">
                            <Slider Minimum="3" Maximum="15" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding Settings.CelebrationToastDurationSeconds}"
                                    Width="150" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource UpsValue}" Margin="10,0,0,0"
                                       Text="{Binding Settings.CelebrationToastDurationSeconds, StringFormat='{}{0} seconds'}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Color theme" Style="{StaticResource UpsLabel}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource UpsComboBox}"
                                  SelectedIndex="{Binding Settings.CelebrationToastTheme, Converter={StaticResource CelebrationThemeConverter}}"
                                  Width="170" HorizontalAlignment="Left">
                            <ComboBoxItem Content="Gold (Default)"/>
                            <ComboBoxItem Content="Royal Purple"/>
                            <ComboBoxItem Content="Emerald"/>
                            <ComboBoxItem Content="Ruby"/>
                            <ComboBoxItem Content="Ice Blue"/>
                            <ComboBoxItem Content="Sunset"/>
                            <ComboBoxItem Content="Platinum"/>
                        </ComboBox>
                    </Grid>

                </StackPanel>
            </Expander>

            <Expander Style="{StaticResource UpsSection}">
                <Expander.Header>
                    <TextBlock ups:TrackedCaps.Text="Abandoned" Style="{StaticResource UpsSectionTitle}"/>
                </Expander.Header>
                <StackPanel>

                    <CheckBox Style="{StaticResource UpsToggle}" Content="Play Sound on Abandoned Games"
                              IsChecked="{Binding Settings.EnableAbandonedSound}"/>
                    <TextBlock Style="{StaticResource UpsHint}" Text="Play a distinct sound (and optional toast) when you mark a game as 'Abandoned' in Playnite. Separate from the Completed/Beaten fanfare so you can pick a game-over jingle instead."/>

                    <StackPanel Margin="32,4,0,0" IsEnabled="{Binding Settings.EnableAbandonedSound}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <RadioButton Style="{StaticResource UpsSegmentFirstTeal}" Content="Jingle Preset"
                                         GroupName="AbandonedSound"
                                         IsChecked="{Binding Settings.AbandonedSoundType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=BundledJingle}"/>
                            <RadioButton Style="{StaticResource UpsSegmentLast}" Content="Custom sound file (.wav recommended)"
                                         GroupName="AbandonedSound"
                                         IsChecked="{Binding Settings.AbandonedSoundType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=CustomFile}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="{Binding Settings.AbandonedSoundType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=BundledJingle}">
                            <ComboBox Style="{StaticResource UpsComboBox}" ItemsSource="{Binding AbandonedJingles}"
                                      ItemTemplate="{StaticResource UpsDisplayNameTemplate}"
                                      SelectedValuePath="File"
                                      SelectedValue="{Binding Settings.SelectedAbandonedJingle}"
                                      Width="300" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource UpsButton}" Content="Preview" Padding="10,4"
                                    Command="{Binding PreviewAbandonedSoundCommand}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="{Binding Settings.AbandonedSoundType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=CustomFile}">
                            <TextBox Style="{StaticResource UpsTextBox}" Width="350" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                     Text="{Binding Settings.AbandonedSoundPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Style="{StaticResource UpsButton}" Content="Browse..." Padding="10,4"
                                    Command="{Binding BrowseAbandonedSoundCommand}"/>
                            <Button Style="{StaticResource UpsButton}" Content="Preview" Padding="10,4" Margin="6,0,0,0"
                                    Command="{Binding PreviewAbandonedSoundCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <CheckBox Style="{StaticResource UpsToggleChildFlush}" Content="Show abandoned toast notification"
                              IsChecked="{Binding Settings.ShowAbandonedToast}"
                              IsEnabled="{Binding Settings.EnableAbandonedSound}"/>
                    <TextBlock Style="{StaticResource UpsHint}" Text="Displays a muted toast popup with a graveyard icon when a game is marked abandoned."/>

                    <Grid Margin="32,0,0,0" IsEnabled="{Binding Settings.ShowAbandonedToast}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Duration" Style="{StaticResource UpsLabel}"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,5">
                            <Slider Minimum="3" Maximum="15" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding Settings.AbandonedToastDurationSeconds}"
                                    Width="150" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource UpsValue}" Margin="10,0,0,0"
                                       Text="{Binding Settings.AbandonedToastDurationSeconds, StringFormat='{}{0} seconds'}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Color theme" Style="{StaticResource UpsLabel}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource UpsComboBox}"
                                  SelectedIndex="{Binding Settings.AbandonedToastTheme, Converter={StaticResource AbandonedThemeConverter}}"
                                  Width="170" HorizontalAlignment="Left" Margin="0,0,0,5">
                            <ComboBoxItem Content="Tombstone (Default)"/>
                            <ComboBoxItem Content="Dusk Blue"/>
                            <ComboBoxItem Content="Rust"/>
                            <ComboBoxItem Content="Ash"/>
                            <ComboBoxItem Content="Faded Crimson"/>
                            <ComboBoxItem Content="Shadow"/>
                        </ComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Message" Style="{StaticResource UpsLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource UpsTextBox}"
                                 Text="{Binding Settings.AbandonedToastMessage, UpdateSourceTrigger=PropertyChanged}"
                                 Width="400" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource UpsHintFlush}" Margin="0,3,0,0"
                                   Text="Use {gameName} as placeholder. Examples: &quot;Filed away without finishing {gameName}.&quot;, &quot;{gameName} has been flushed.&quot;, &quot;RIP {gameName}&quot;"/>
                    </Grid>

                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
