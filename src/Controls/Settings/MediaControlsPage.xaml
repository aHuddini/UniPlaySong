<UserControl x:Class="UniPlaySong.Controls.Settings.MediaControlsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UniPlaySong"
             xmlns:ups="clr-namespace:UniPlaySong.Controls.Settings"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UniPlaySong;component/Controls/Settings/SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource UpsPage}">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">

            <TextBlock Text="Media Controls" Style="{StaticResource UpsPageTitle}"/>
            <TextBlock Style="{StaticResource UpsPageSubtitle}" Text="Playback controls and Now-Playing readout UniPlaySong adds to Playnite."/>
                <CheckBox Style="{StaticResource UpsToggle}" Content="Show Media Controls on Panel (Desktop)"
                          IsChecked="{Binding Settings.ShowDesktopMediaControls}"
                          Command="{Binding SetRestartRequired}"
                          CommandParameter="{Binding RelativeSource={RelativeSource Self}}"/>
                <TextBlock Style="{StaticResource UpsHint}">
                    <Run Text="Displays the play/pause and skip buttons on Playnite's Top Panel."/>
                    <Run Text="Requires a Playnite restart to take effect."
                         Foreground="{StaticResource UpsWarn}" FontWeight="SemiBold"/>
                </TextBlock>
    
                <CheckBox Style="{StaticResource UpsToggle}" Content="Show Media Controls in Windows Taskbar's Thumbnail Preview."
                          IsChecked="{Binding Settings.ShowTaskbarMediaControls}"
                          Command="{Binding SetRestartRequired}"
                          CommandParameter="{Binding RelativeSource={RelativeSource Self}}"/>
                <TextBlock Style="{StaticResource UpsHint}">
                    <Run Text="Adds Media Controls to Playnite's taskbar hover preview."/>
                    <Run Text="Requires a Playnite restart to take effect."
                         Foreground="{StaticResource UpsWarn}" FontWeight="SemiBold"/>
                </TextBlock>
    

            <Border Style="{StaticResource UpsSectionBar}">
                <TextBlock ups:TrackedCaps.Text="Now Playing Ticker" Style="{StaticResource UpsSectionTitle}"/>
            </Border>
                <CheckBox Style="{StaticResource UpsToggle}" Content="Show Now Playing on Panel (Desktop)"
                          IsChecked="{Binding Settings.ShowNowPlayingInTopPanel}"
                          Command="{Binding SetRestartRequired}"
                          CommandParameter="{Binding RelativeSource={RelativeSource Self}}"/>
                <TextBlock Style="{StaticResource UpsHint}">
                    <Run Text="Displays the current song title, artist, and duration on Playnite's Top Panel."/>
                    <Run Text="Requires a Playnite restart to take effect."
                         Foreground="{StaticResource UpsWarn}" FontWeight="SemiBold"/>
                </TextBlock>
    
                <CheckBox Style="{StaticResource UpsToggleChild}" Content="Hide Now Playing for default music"
                          IsChecked="{Binding Settings.HideNowPlayingForDefaultMusic}"
                          IsEnabled="{Binding Settings.ShowNowPlayingInTopPanel}"
                          />
                <TextBlock Text="When enabled, the Now Playing panel is hidden when a game has no downloaded music and default/fallback music is playing"
                           Style="{StaticResource UpsHintIndented}"/>
    
                <CheckBox Style="{StaticResource UpsToggleChild}" Content="Show [Default] indicator in Now Playing"
                          IsChecked="{Binding Settings.ShowDefaultMusicIndicator}"
                          IsEnabled="{Binding Settings.ShowNowPlayingInTopPanel}"
                          />
                <TextBlock Text="When enabled, shows [Default] prefix in the Now Playing ticker when default/fallback music is playing"
                           Style="{StaticResource UpsHintIndented}"/>
    

            <!-- A card, not a bar: the one block here that is output rather than input, so it
                 earns being set apart. No description - the thing itself is the explanation.

                 The Loaded/Unloaded handlers live on the card because they drove the Border that
                 used to wrap this; the preview stops updating without them. -->
            <Border Style="{StaticResource UpsCard}"
                    Loaded="NowPlayingPreview_OnLoaded" Unloaded="NowPlayingPreview_OnUnloaded">
                <StackPanel>
                    <TextBlock Text="Preview" Style="{StaticResource UpsCardTitle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Current Song: " Style="{StaticResource UpsParamLabel}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentSongDisplay}" FontSize="11" FontWeight="Normal"
                                   Foreground="{StaticResource UpsTextMuted}" FontStyle="Italic"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Grid Width="64" Height="64" Margin="0,0,10,0">
                            <Border Background="#22000000" CornerRadius="3"/>
                            <TextBlock Style="{StaticResource UpsLabel}" Text="&#x266A;" FontSize="28" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Opacity="0.5"
                                       Visibility="{Binding PreviewHasNoArt, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Image Source="{Binding PreviewNowPlayingArtPath}" Stretch="UniformToFill"
                                   Visibility="{Binding PreviewHasArt, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource UpsLabel}" Text="{Binding PreviewNowPlayingTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                            <TextBlock Style="{StaticResource UpsLabel}" Text="{Binding PreviewNowPlayingArtist}" Opacity="0.75" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                            <!-- Spotify-only metadata; each row collapses when empty (game music leaves these blank). -->
                            <TextBlock Style="{StaticResource UpsLabel}" Text="{Binding PreviewNowPlayingAlbum}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxWidth="280"
                                       Visibility="{Binding PreviewHasAlbum, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Style="{StaticResource UpsLabel}" Text="{Binding PreviewNowPlayingGenre}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxWidth="280"
                                       Visibility="{Binding PreviewHasGenre, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Style="{StaticResource UpsLabel}" Text="{Binding PreviewNowPlayingDuration}" FontSize="11" Opacity="0.6"
                                       Visibility="{Binding PreviewHasDuration, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
    

        </StackPanel>
    </ScrollViewer>
</UserControl>