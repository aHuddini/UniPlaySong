<UserControl x:Class="UniPlaySong.Controls.Settings.MediaControlsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UniPlaySong"
             xmlns:ups="clr-namespace:UniPlaySong.Controls.Settings"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UniPlaySong;component/Controls/Settings/SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource UpsPage}">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">

            <TextBlock Text="Media Controls" Style="{StaticResource UpsPageTitle}"/>
            <TextBlock Style="{StaticResource UpsPageSubtitle}" Text="Playback controls UniPlaySong adds to Playnite."/>
                <CheckBox Style="{StaticResource UpsToggle}" Content="Show Media Controls on Panel (Desktop)"
                          IsChecked="{Binding Settings.ShowDesktopMediaControls}"/>
                <TextBlock Style="{StaticResource UpsHint}"
                           Text="Adds UniPlaySong's buttons to Playnite's Top Panel. Pick which ones below. Takes effect straight away."/>

                <CheckBox Style="{StaticResource UpsToggleChild}" Content="Play/Pause button"
                          IsChecked="{Binding Settings.ShowPlayPauseButton}"
                          IsEnabled="{Binding Settings.ShowDesktopMediaControls}"/>
                <CheckBox Style="{StaticResource UpsToggleChild}" Content="Skip button"
                          IsChecked="{Binding Settings.ShowSkipButton}"
                          IsEnabled="{Binding Settings.ShowDesktopMediaControls}"/>
                <CheckBox Style="{StaticResource UpsToggleChild}" Content="Calm Down button"
                          IsChecked="{Binding Settings.ShowCalmDownButton}"
                          IsEnabled="{Binding Settings.ShowDesktopMediaControls}"/>
                <TextBlock Style="{StaticResource UpsHintIndented}"
                           Text="A moon button that turns Calm Down Mode on and off."/>

                <CheckBox Style="{StaticResource UpsToggle}" Content="Show Media Controls in Windows Taskbar's Thumbnail Preview."
                          IsChecked="{Binding Settings.ShowTaskbarMediaControls}"
                          Command="{Binding SetRestartRequired}"
                          CommandParameter="{Binding RelativeSource={RelativeSource Self}}"/>
                <TextBlock Style="{StaticResource UpsHint}">
                    <Run Text="Adds Media Controls to Playnite's taskbar hover preview."/>
                    <Run Text="Requires a Playnite restart to take effect."
                         Foreground="{StaticResource UpsWarn}" FontWeight="SemiBold"/>
                </TextBlock>

                <CheckBox Style="{StaticResource UpsToggle}" Content="Auto-hide controls that can't be used"
                          IsChecked="{Binding Settings.AutoHideMediaControls}"/>
                <TextBlock Style="{StaticResource UpsHint}"
                           Text="Saves Top Panel space. While no music is loaded, the items picked below are hidden; Skip also hides when there is only one song. Paused music keeps its controls."/>
                <StackPanel IsEnabled="{Binding Settings.AutoHideMediaControls}">
                    <TextBlock Style="{StaticResource UpsHintIndented}" Margin="24,4,0,0" FontWeight="SemiBold"
                               Text="What to hide"/>
                    <!-- Three even columns, so the six items sit in two tidy rows at the child indent. Sub-option
                         (violet) switches with normal-weight labels: they only matter while auto-hide is on. -->
                    <UniformGrid Columns="3" Margin="24,0,0,14">
                        <CheckBox Style="{StaticResource UpsToggleChildFlush}" Content="Play/Pause"
                                  FontWeight="Normal" Margin="0,4,12,0"
                                  IsChecked="{Binding Settings.AutoHidePlayPause}"/>
                        <CheckBox Style="{StaticResource UpsToggleChildFlush}" Content="Skip (and with one song)"
                                  FontWeight="Normal" Margin="0,4,12,0"
                                  IsChecked="{Binding Settings.AutoHideSkip}"/>
                        <CheckBox Style="{StaticResource UpsToggleChildFlush}" Content="Calm Down"
                                  FontWeight="Normal" Margin="0,4,12,0"
                                  IsChecked="{Binding Settings.AutoHideCalmDown}"/>
                        <CheckBox Style="{StaticResource UpsToggleChildFlush}" Content="Spectrum"
                                  FontWeight="Normal" Margin="0,4,12,0"
                                  IsChecked="{Binding Settings.AutoHideSpectrum}"/>
                        <CheckBox Style="{StaticResource UpsToggleChildFlush}" Content="Peak meter"
                                  FontWeight="Normal" Margin="0,4,12,0"
                                  IsChecked="{Binding Settings.AutoHidePeakMeter}"/>
                        <CheckBox Style="{StaticResource UpsToggleChildFlush}" Content="Progress bar"
                                  FontWeight="Normal" Margin="0,4,12,0"
                                  IsChecked="{Binding Settings.AutoHideProgress}"/>
                    </UniformGrid>
                    <CheckBox Style="{StaticResource UpsToggleChild}" Content="Also hide while only default music plays"
                              IsChecked="{Binding Settings.AutoHideForDefaultMusic}"/>
                    <TextBlock Style="{StaticResource UpsHintIndented}"
                               Text="Treats default music (a game with no songs of its own) the same as no music."/>
                </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>