<UserControl x:Class="UniPlaySong.Controls.Settings.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UniPlaySong"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UniPlaySong;component/Controls/Settings/SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <Grid Margin="0,0,0,20">
                <TextBlock Text="General Settings" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>
            
            <CheckBox Content="Enable Music"
                      IsChecked="{Binding Settings.EnableMusic}"
                      Margin="0,5"/>
            <TextBlock Text="When enabled, music will automatically play when selecting games (console-like preview experience)"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,10"/>

            <CheckBox Content="Suppress Playnite Native Background Music"
                      IsChecked="{Binding Settings.SuppressPlayniteBackgroundMusic}"
                      Margin="0,5"/>
            <TextBlock Text="Default: Enabled. Prevents Playnite's built-in vanilla music from playing in the background during fullscreen mode."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,2"/>
            <TextBlock Text="WARNING: Disabling this option will allow Playnite's vanilla theme music to play simultaneously alongside UniPlaySong music, causing annoying audio issues. This WILL negatively impact themes like ANIKI Remake and other fullscreen themes that include their own music. It is strongly recommended to keep this option enabled to ensure proper plugin functionality."
                       FontSize="11"
                       Foreground="#FFD44040"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="20,0,0,10"/>

            <Separator Margin="0,15"/>

            <!-- Music Library Tagging -->
            <Expander IsExpanded="False" Margin="0,0,0,10">
                <Expander.Header>
                    <TextBlock Text="Media Controls (Desktop)" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">
                <CheckBox Content="Show Media Controls on Panel (Desktop)"
                          IsChecked="{Binding Settings.ShowDesktopMediaControls}"
                          Command="{Binding SetRestartRequired}"
                          CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                          Margin="0,5"/>
                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,10">
                    <Run Foreground="Gray">Displays the play/pause and skip buttons on Playnite's Top Panel.</Run>
                    <Run Foreground="Orange">Requires Playnite restart to take effect.</Run>
                </TextBlock>
    
                <CheckBox Content="Show Media Controls in Windows Taskbar's Thumbnail Preview."
                          IsChecked="{Binding Settings.ShowTaskbarMediaControls}"
                          Command="{Binding SetRestartRequired}"
                          CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                          Margin="0,5"/>
                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,10">
                    <Run Foreground="Gray">Adds Media Controls to Playnite's taskbar hover preview.</Run>
                    <Run Foreground="Orange">Requires Playnite restart to take effect.</Run>
                </TextBlock>
    
                <CheckBox Content="Show Now Playing on Panel (Desktop)"
                          IsChecked="{Binding Settings.ShowNowPlayingInTopPanel}"
                          Command="{Binding SetRestartRequired}"
                          CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                          Margin="0,5"/>
                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,2">
                    <Run Foreground="Gray">Displays the current song title, artist, and duration on Playnight's Top Panel.</Run>
                    <Run Foreground="Orange">Requires Playnite restart to take effect.</Run>
                </TextBlock>
    
                <CheckBox Content="Hide Now Playing for default music"
                          IsChecked="{Binding Settings.HideNowPlayingForDefaultMusic}"
                          IsEnabled="{Binding Settings.ShowNowPlayingInTopPanel}"
                          Margin="20,5,0,0"/>
                <TextBlock Text="When enabled, the Now Playing panel is hidden when a game has no downloaded music and default/fallback music is playing"
                           FontSize="11"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Margin="40,0,0,10"/>
    
                <CheckBox Content="Show [Default] indicator in Now Playing"
                          IsChecked="{Binding Settings.ShowDefaultMusicIndicator}"
                          IsEnabled="{Binding Settings.ShowNowPlayingInTopPanel}"
                          Margin="20,0,0,0"/>
                <TextBlock Text="When enabled, shows [Default] prefix in the Now Playing ticker when default/fallback music is playing"
                           FontSize="11"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Margin="40,0,0,10"/>
    
                <!-- Current Song Display (non-serialized, display-only) -->
                <StackPanel Orientation="Horizontal" Margin="20,0,0,10">
                    <TextBlock Text="Current Song: "
                               FontSize="11"
                               Foreground="Gray"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentSongDisplay}"
                               FontSize="11"
                               Foreground="LightGray"
                               FontStyle="Italic"
                               VerticalAlignment="Center"/>
                </StackPanel>
    
                <!-- Live now-playing preview card (album art + title/artist), display-only.
                     Mirrors the data theme devs pull via {PluginSettings}. -->
                <Border Margin="20,0,0,10" Padding="8" CornerRadius="4"
                        BorderThickness="1" BorderBrush="#33888888" Background="#11888888"
                        HorizontalAlignment="Left"
                        Loaded="NowPlayingPreview_OnLoaded" Unloaded="NowPlayingPreview_OnUnloaded">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="64" Height="64" Margin="0,0,10,0">
                            <Border Background="#22000000" CornerRadius="3"/>
                            <TextBlock Text="&#x266A;" FontSize="28" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Opacity="0.5"
                                       Visibility="{Binding PreviewHasNoArt, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Image Source="{Binding PreviewNowPlayingArtPath}" Stretch="UniformToFill"
                                   Visibility="{Binding PreviewHasArt, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding PreviewNowPlayingTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                            <TextBlock Text="{Binding PreviewNowPlayingArtist}" Opacity="0.75" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                            <!-- Spotify-only metadata; each row collapses when empty (game music leaves these blank). -->
                            <TextBlock Text="{Binding PreviewNowPlayingAlbum}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxWidth="280"
                                       Visibility="{Binding PreviewHasAlbum, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding PreviewNowPlayingGenre}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxWidth="280"
                                       Visibility="{Binding PreviewHasGenre, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding PreviewNowPlayingDuration}" FontSize="11" Opacity="0.6"
                                       Visibility="{Binding PreviewHasDuration, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
    
                </StackPanel>
            </Expander>

            <Expander IsExpanded="False" Margin="0,0,0,10">
                <Expander.Header>
                    <TextBlock Text="Music Library Tagging" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">
    
                <CheckBox Content="Auto-tag games on library update"
                          IsChecked="{Binding Settings.AutoTagOnLibraryUpdate}"
                          Margin="0,5"/>
                <TextBlock Text="When enabled, games will be automatically tagged with '[UPS] Has Music' or '[UPS] No Music' when you update your library. Use Playnite's filter to find games by tag."
                           FontSize="11"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Margin="20,0,0,10"/>
    
                <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                    <Button Content="Scan &amp; Tag All Games"
                            Width="160"
                            Margin="0,0,10,0"
                            Command="{Binding ScanAndTagAllGamesCommand}"/>
                    <Button Content="Remove All Tags"
                            Width="140"
                            Command="{Binding RemoveAllMusicTagsCommand}"/>
                </StackPanel>
    
                </StackPanel>
            </Expander>

            <Expander IsExpanded="False" Margin="0,0,0,10">
                <Expander.Header>
                    <TextBlock Text="Performance" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">
                <CheckBox Content="Enable Song List Cache"
                          IsChecked="{Binding Settings.EnableSongListCache}"
                          Margin="0,5"/>
                <TextBlock Text="When enabled, music directory lists are cached in memory during a running Playnite session (Desktop Mode = one session, switch to Fullscreen Mode = brand new session). Cache is automatically cleared when you download, modify, or delete music, and is reset when Playnite restarts."
                           FontSize="11"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Margin="20,0,0,10"/>
                <TextBlock Text="⚠️ Keep this disabled if you don't notice any performance issues with game switching in your library. Manually added music files (outside UniPlaySong) won't appear until you restart Playnite."
                           FontSize="11"
                           Foreground="#FFB74D"
                           TextWrapping="Wrap"
                           Margin="20,0,0,15"/>
    
                <!-- Note: "Release Audio When Idle" lives on the Experimental tab (v1.5.4) -->
    
                </StackPanel>
            </Expander>

            <Separator Margin="0,15"/>

            <!-- Troubleshooting -->
            <TextBlock Text="Troubleshooting" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <CheckBox Content="Enable Debug Logging"
                      IsChecked="{Binding Settings.EnableDebugLogging}"
                      Margin="0,5"/>
            <TextBlock Text="When enabled, writes detailed debug information to UniPlaySong.log in the extension folder. Disable for normal use to reduce log file size."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,10"/>

            <Button Content="Open Log Folder"
                    Width="160"
                    Margin="0,5,0,15"
                    HorizontalAlignment="Left"
                    Command="{Binding OpenLogFolderCommand}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
