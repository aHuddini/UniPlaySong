<UserControl x:Class="UniPlaySong.Controls.Settings.ReverbPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UniPlaySong"
             xmlns:ups="clr-namespace:UniPlaySong.Controls.Settings"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UniPlaySong;component/Controls/Settings/SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Reverb off the old Live Effects tab, where its thirteen parameters sat inside one
         expander among ten others. The preset picker stays at the top because most people
         never need the sliders; Advanced Tuning stays folded because it can be dangerous. -->

    <ScrollViewer Style="{StaticResource UpsPage}">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">

            <TextBlock Text="Reverb" Style="{StaticResource UpsPageTitle}"/>
            <TextBlock Style="{StaticResource UpsPageSubtitle}"
                       Text="Space and ambience. Based on the libSoX algorithm Audacity uses, so its presets carry across."/>

            <CheckBox Content="Enable reverb"
                      Style="{StaticResource UpsToggle}"
                      IsChecked="{Binding Settings.ReverbEnabled}"
                      IsEnabled="{Binding Settings.LiveEffectsEnabled}"/>
            <TextBlock Style="{StaticResource UpsHint}"
                       Text="Needs Live Effects switched on, over on the Effects page."/>

            <Border Style="{StaticResource UpsSectionBar}">
                <TextBlock ups:TrackedCaps.Text="Preset" Style="{StaticResource UpsSectionTitle}"/>
            </Border>

            <StackPanel IsEnabled="{Binding Settings.LiveEffectsEnabled}">
                <ComboBox Style="{StaticResource UpsComboBox}" Width="240" HorizontalAlignment="Left" Margin="0,4,0,0"
                          SelectedIndex="{Binding Settings.SelectedReverbPreset, Converter={StaticResource ReverbPresetConverter}}">
                    <ComboBoxItem Content="Custom"/>
                    <!-- General purpose (Audacity) -->
                    <ComboBoxItem Content="Acoustic"/>
                    <ComboBoxItem Content="Ambience"/>
                    <ComboBoxItem Content="Artificial"/>
                    <ComboBoxItem Content="Clean"/>
                    <ComboBoxItem Content="Modern"/>
                    <!-- Vocals (Audacity) -->
                    <ComboBoxItem Content="Vocal I"/>
                    <ComboBoxItem Content="Vocal II"/>
                    <ComboBoxItem Content="Dance Vocal"/>
                    <ComboBoxItem Content="Modern Vocal"/>
                    <ComboBoxItem Content="Voice Tail"/>
                    <!-- Room sizes (Audacity) -->
                    <ComboBoxItem Content="Bathroom"/>
                    <ComboBoxItem Content="Small Room Bright"/>
                    <ComboBoxItem Content="Small Room Dark"/>
                    <ComboBoxItem Content="Medium Room"/>
                    <ComboBoxItem Content="Large Room"/>
                    <ComboBoxItem Content="Church Hall"/>
                    <ComboBoxItem Content="Cathedral"/>
                    <ComboBoxItem Content="Big Cave"/>
                    <!-- Living / entertainment (UniPlaySong) -->
                    <ComboBoxItem Content="Living Room"/>
                    <ComboBoxItem Content="Home Theater"/>
                    <ComboBoxItem Content="Late Night TV"/>
                    <ComboBoxItem Content="Lounge / Cafe"/>
                    <ComboBoxItem Content="Jazz Club"/>
                    <ComboBoxItem Content="Night Club"/>
                    <ComboBoxItem Content="Concert Hall"/>
                    <!-- Creative / stylistic (UniPlaySong) -->
                    <ComboBoxItem Content="Dreamy"/>
                    <ComboBoxItem Content="Lo-Fi"/>
                    <ComboBoxItem Content="Underwater"/>
                    <ComboBoxItem Content="Sci-Fi Corridor"/>
                    <ComboBoxItem Content="Vinyl Warmth"/>
                    <ComboBoxItem Content="Vaporwave"/>
                </ComboBox>
                <TextBlock Style="{StaticResource UpsHintFlush}" Margin="0,6,0,4"
                           Text="Audacity's own presets plus a set of UniPlaySong rooms. Moving any slider below switches this to Custom."/>
            </StackPanel>

            <Expander Style="{StaticResource UpsSection}">
                <Expander.Header>
                    <TextBlock ups:TrackedCaps.Text="The Room" Style="{StaticResource UpsSectionTitle}"/>
                </Expander.Header>
                <StackPanel IsEnabled="{Binding Settings.LiveEffectsEnabled}">

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="Room size" Style="{StaticResource UpsLabel}" Width="120"/>
                        <Slider Minimum="0" Maximum="100" Width="200" VerticalAlignment="Center"
                                Value="{Binding Settings.ReverbRoomSize}"
                                SmallChange="5" LargeChange="10" TickFrequency="10"/>
                        <TextBlock Style="{StaticResource UpsValue}" Margin="12,0,0,0"
                                   Text="{Binding Settings.ReverbRoomSize, StringFormat='{}{0}%'}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource UpsHintFlush}" Margin="0,2,0,10"
                               Text="How big the space is. 0% is tight and short, 100% is cathedral. Default 75%."/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="Reverberance" Style="{StaticResource UpsLabel}" Width="120"/>
                        <Slider Minimum="0" Maximum="100" Width="200" VerticalAlignment="Center"
                                Value="{Binding Settings.ReverbReverberance}"
                                SmallChange="5" LargeChange="10" TickFrequency="10"/>
                        <TextBlock Style="{StaticResource UpsValue}" Margin="12,0,0,0"
                                   Text="{Binding Settings.ReverbReverberance, StringFormat='{}{0}%'}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource UpsHintFlush}" Margin="0,2,0,10"
                               Text="How long the tail runs. This is the one to reach for when you want the effect to be obvious. Default 50%."/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="Pre-delay" Style="{StaticResource UpsLabel}" Width="120"/>
                        <Slider Minimum="0" Maximum="200" Width="200" VerticalAlignment="Center"
                                Value="{Binding Settings.ReverbPreDelay}"
                                SmallChange="5" LargeChange="20" TickFrequency="20"/>
                        <TextBlock Style="{StaticResource UpsValue}" Margin="12,0,0,0"
                                   Text="{Binding Settings.ReverbPreDelay, StringFormat='{}{0} ms'}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource UpsHintFlush}" Margin="0,2,0,10"
                               Text="The gap before the reverb arrives, which reads as distance. 0 ms is right up close, 100 ms and up is a large room. Default 10 ms."/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="Stereo width" Style="{StaticResource UpsLabel}" Width="120"/>
                        <Slider Minimum="0" Maximum="100" Width="200" VerticalAlignment="Center"
                                Value="{Binding Settings.ReverbStereoWidth}"
                                SmallChange="5" LargeChange="10" TickFrequency="10"/>
                        <TextBlock Style="{StaticResource UpsValue}" Margin="12,0,0,0"
                                   Text="{Binding Settings.ReverbStereoWidth, StringFormat='{}{0}%'}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource UpsHintFlush}" Margin="0,2,0,4"
                               Text="How far the tail spreads across the stereo field. Default 100%."/>

                </StackPanel>
            </Expander>

            <Expander Style="{StaticResource UpsSection}">
                <Expander.Header>
                    <TextBlock ups:TrackedCaps.Text="Balance" Style="{StaticResource UpsSectionTitle}"/>
                </Expander.Header>
                <StackPanel IsEnabled="{Binding Settings.LiveEffectsEnabled}">

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="Wet / dry mix" Style="{StaticResource UpsLabel}" Width="120"/>
                        <Slider Minimum="0" Maximum="100" Width="200" VerticalAlignment="Center"
                                Value="{Binding Settings.ReverbMix}"
                                SmallChange="5" LargeChange="10" TickFrequency="10"/>
                        <TextBlock Style="{StaticResource UpsValue}" Margin="12,0,0,0"
                                   Text="{Binding Settings.ReverbMix, StringFormat='{}{0}%'}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource UpsHintFlush}" Margin="0,2,0,10"
                               Text="The crossfade between untouched and fully wet. Default 50%."/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="Wet gain" Style="{StaticResource UpsLabel}" Width="120"/>
                        <Slider Minimum="-20" Maximum="10" Width="200" VerticalAlignment="Center"
                                Value="{Binding Settings.ReverbWetGain}"
                                SmallChange="1" LargeChange="3" TickFrequency="5"/>
                        <TextBlock Style="{StaticResource UpsValue}" Margin="12,0,0,0"
                                   Text="{Binding Settings.ReverbWetGain, StringFormat='{}{0} dB'}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource UpsHintFlush}" Margin="0,2,0,10"
                               Text="Level of the reverb itself. Default -6 dB."/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="Dry gain" Style="{StaticResource UpsLabel}" Width="120"/>
                        <Slider Minimum="-20" Maximum="0" Width="200" VerticalAlignment="Center"
                                Value="{Binding Settings.ReverbDryGain}"
                                SmallChange="1" LargeChange="3" TickFrequency="2"/>
                        <TextBlock Style="{StaticResource UpsValue}" Margin="12,0,0,0"
                                   Text="{Binding Settings.ReverbDryGain, StringFormat='{}{0} dB'}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource UpsHintFlush}" Margin="0,2,0,4"
                               Text="Level of the original signal underneath. Default 0 dB."/>

                </StackPanel>
            </Expander>

            <Expander Style="{StaticResource UpsSection}">
                <Expander.Header>
                    <TextBlock ups:TrackedCaps.Text="Tone" Style="{StaticResource UpsSectionTitle}"/>
                </Expander.Header>
                <StackPanel IsEnabled="{Binding Settings.LiveEffectsEnabled}">

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="Damping" Style="{StaticResource UpsLabel}" Width="120"/>
                        <Slider Minimum="0" Maximum="100" Width="200" VerticalAlignment="Center"
                                Value="{Binding Settings.ReverbDamping}"
                                SmallChange="5" LargeChange="10" TickFrequency="10"/>
                        <TextBlock Style="{StaticResource UpsValue}" Margin="12,0,0,0"
                                   Text="{Binding Settings.ReverbDamping, StringFormat='{}{0}%'}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource UpsHintFlush}" Margin="0,2,0,10"
                               Text="High-frequency absorption, the way soft furnishings eat the top end. Higher is a darker tail. Default 50%."/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="Tone low" Style="{StaticResource UpsLabel}" Width="120"/>
                        <Slider Minimum="0" Maximum="100" Width="200" VerticalAlignment="Center"
                                Value="{Binding Settings.ReverbToneLow}"
                                SmallChange="5" LargeChange="10" TickFrequency="10"/>
                        <TextBlock Style="{StaticResource UpsValue}" Margin="12,0,0,0"
                                   Text="{Binding Settings.ReverbToneLow, StringFormat='{}{0}%'}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource UpsHintFlush}" Margin="0,2,0,10"
                               Text="Bass in the tail. Pull it down if the reverb sounds boomy. Default 100%."/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="Tone high" Style="{StaticResource UpsLabel}" Width="120"/>
                        <Slider Minimum="0" Maximum="100" Width="200" VerticalAlignment="Center"
                                Value="{Binding Settings.ReverbToneHigh}"
                                SmallChange="5" LargeChange="10" TickFrequency="10"/>
                        <TextBlock Style="{StaticResource UpsValue}" Margin="12,0,0,0"
                                   Text="{Binding Settings.ReverbToneHigh, StringFormat='{}{0}%'}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource UpsHintFlush}" Margin="0,2,0,4"
                               Text="Treble in the tail. Pull it down for a darker room. Default 100%."/>

                </StackPanel>
            </Expander>

            <Expander Style="{StaticResource UpsSection}">
                <Expander.Header>
                    <TextBlock ups:TrackedCaps.Text="Advanced Tuning" Style="{StaticResource UpsSectionTitle}"/>
                </Expander.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource UpsHintFlush}"
                               Text="The algorithm's own internals, rather than the room being modelled. For people who know what these do."/>

                    <CheckBox Content="Enable advanced tuning"
                              Style="{StaticResource UpsToggle}"
                              IsChecked="{Binding Settings.AdvancedReverbTuningEnabled}"
                              IsEnabled="{Binding Settings.LiveEffectsEnabled}"/>
                    <TextBlock Style="{StaticResource UpsDangerNote}"
                               Text="These can produce very loud output — loud enough to hurt your hearing or your speakers. Turn your volume down before you touch them."/>

                    <StackPanel Margin="32,0,0,0" IsEnabled="{Binding Settings.AdvancedReverbTuningEnabled}">

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Wet multiplier" Style="{StaticResource UpsLabel}" Width="120"/>
                            <Slider Minimum="1" Maximum="25" Width="200" VerticalAlignment="Center"
                                    Value="{Binding Settings.ReverbWetGainMultiplier}"
                                    SmallChange="1" LargeChange="5" TickFrequency="5"/>
                            <TextBlock Style="{StaticResource UpsValue}" Margin="12,0,0,0"
                                       Text="{Binding Settings.ReverbWetGainMultiplier, StringFormat='0.{0:D2}'}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource UpsHintFlush}" Margin="0,2,0,10"
                                   Text="Scales the whole reverb intensity, 0.01 to 0.25. Default 0.03. Past 0.15 it gets very loud."/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="HF damp min" Style="{StaticResource UpsLabel}" Width="120"/>
                            <Slider Minimum="10" Maximum="40" Width="200" VerticalAlignment="Center"
                                    Value="{Binding Settings.ReverbHfDampingMin}"
                                    SmallChange="5" LargeChange="10" TickFrequency="10"/>
                            <TextBlock Style="{StaticResource UpsValue}" Margin="12,0,0,0"
                                       Text="{Binding Settings.ReverbHfDampingMin, StringFormat='0.{0:D2}'}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource UpsHintFlush}" Margin="0,2,0,10"
                                   Text="What damping actually means at the 0% end of the slider above. Lower is brighter. Default 0.20."/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="HF damp max" Style="{StaticResource UpsLabel}" Width="120"/>
                            <Slider Minimum="30" Maximum="70" Width="200" VerticalAlignment="Center"
                                    Value="{Binding Settings.ReverbHfDampingMax}"
                                    SmallChange="5" LargeChange="10" TickFrequency="10"/>
                            <TextBlock Style="{StaticResource UpsValue}" Margin="12,0,0,0"
                                       Text="{Binding Settings.ReverbHfDampingMax, StringFormat='0.{0:D2}'}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource UpsHintFlush}" Margin="0,2,0,4"
                                   Text="And what it means at the 100% end. Higher is darker. Default 0.50."/>

                    </StackPanel>
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
