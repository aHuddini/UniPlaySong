<UserControl x:Class="UniPlaySong.Controls.Settings.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UniPlaySong"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UniPlaySong;component/Controls/Settings/SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">

            <!-- Header -->
            <TextBlock Text="UniPlaySong" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Version " FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding PluginVersion}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="Gray" Margin="0,0,0,15">
                A console-like game music preview experience for Playnite. Music plays while browsing your library, with controller-friendly song management and fade transitions between selections.
            </TextBlock>

            <!-- Supported Audio Formats -->
            <Border BorderBrush="#FF888888" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,20" Background="#1A888888">
                <StackPanel>
                    <TextBlock Text="Supported Audio Formats" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="0,0,0,8">
                        Formats tested with UPS's audio system. Drop files matching these extensions into a game's music folder.
                    </TextBlock>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2">• MP3</TextBlock>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2">• OGG Vorbis</TextBlock>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2">• FLAC</TextBlock>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8">• WAV</TextBlock>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2">Retro chiptune (via bundled Game Music Emu):</TextBlock>
                    <TextBlock FontSize="12" Margin="10,0,0,2"><Run FontWeight="SemiBold">• .vgm / .vgz</Run> — Sega Genesis / Mega Drive / Sega CD</TextBlock>
                    <TextBlock FontSize="12" Margin="10,0,0,2"><Run FontWeight="SemiBold">• .nsf</Run> — NES / Famicom</TextBlock>
                    <TextBlock FontSize="12" Margin="10,0,0,2"><Run FontWeight="SemiBold">• .spc</Run> — SNES / Super Famicom</TextBlock>
                    <TextBlock FontSize="12" Margin="10,0,0,2"><Run FontWeight="SemiBold">• .hes</Run> — NEC TurboGrafx-16 / PC Engine (requires sibling .m3u for multi-track playback or splitting)</TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="10,2,0,0">
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Officially Supported Themes -->
            <Border BorderBrush="#FF4A9EFF" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,20" Background="#1A4A9EFF">
                <StackPanel>
                    <TextBlock Text="Officially Supported Fullscreen Themes" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8">
                        These themes are tested against every UniPlaySong release and use the plugin's theme-integration API (UPS_MusicControl) to pause music during intro sequences, login screens, and overlays:
                    </TextBlock>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2">• ANIKI REMAKE</TextBlock>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8">• PS5 Experience (by saVantCZ) — enable "Theme compatibility" in Settings → Theme Support</TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray">
                        See Settings → Theme Support for the compatibility toggles (overlay/video music pausing, and the PS5-Experience fix).
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Changelog (current version only; older history on GitHub) -->
            <Border BorderBrush="#FF6FB36F" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,20" Background="#1A6FB36F">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="What's New in " FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="v" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="{Binding PluginVersion}" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="0,0,0,10">
                        The list below covers only the current release. For full version history, see the installer manifest on GitHub.
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6">
                        <Run FontWeight="SemiBold">Fixed:</Run> Preview buttons only played once per settings session — clicking Preview again now works without reopening this window.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6">
                        <Run FontWeight="SemiBold">Changed:</Run> Removed the System beep sound option. If you had it selected, that sound now uses the bundled jingle.
                    </TextBlock>

                    <TextBlock FontSize="11">
                        Full version history:
                        <Hyperlink NavigateUri="https://github.com/aHuddini/UniPlaySong/blob/main/Manifest/installer.yaml" RequestNavigate="AboutHyperlink_RequestNavigate">UniPlaySong installer manifest on GitHub</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Troubleshooting / Known Quirks -->
            <Border BorderBrush="#FFE0A040" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,20" Background="#1AE0A040">
                <StackPanel>
                    <TextBlock Text="Troubleshooting / Known Quirks" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="0,0,0,10">
                        These are real-world edge cases UPS users have hit. If you run into one, the workaround is listed below the description.
                    </TextBlock>

                    <TextBlock Text="Windows may not auto-sleep while Playnite is running" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="10,0,0,10">
                        UPS holds the audio device open between songs to avoid stutter, and Windows can read that as active audio. If your PC doesn't sleep on its own, exit Playnite when you step away.
                    </TextBlock>

                    <TextBlock Text="Pause on Focus Loss can be unreliable" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="10,0,0,10">
                        If music gets stuck silent after exiting a game, try disabling "Ignore brief focus loss (alt-tab)" first. If it still happens, send a log file via Settings → Backup → Export Markdown Snapshot.
                    </TextBlock>

                    <TextBlock Text="Active Theme Music requires theme support" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="10,0,0,10">
                        This option needs the theme to include a <Run FontFamily="Consolas">UPS_BackgroundAudio</Run> audio file. If you want to use it, ask the theme's developer to add one — or pick a different default music source.
                    </TextBlock>

                </StackPanel>
            </Border>

            <!-- Bundled Music Credits -->
            <Border BorderBrush="#FF8888FF" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,20" Background="#1A8888FF">
                <StackPanel>
                    <TextBlock Text="Bundled Music Credits" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8">
                        The Bundled Ambient default-music option ships these tracks. Full license details in NOTICES.txt.
                    </TextBlock>
                    <TextBlock FontSize="12" Margin="0,0,0,2"><Run FontWeight="SemiBold">• Shades of Orange</Run> — Dave Miles, via Zapsplat (Standard License, Attribution)</TextBlock>
                    <TextBlock FontSize="12" Margin="0,0,0,2"><Run FontWeight="SemiBold">• ANIKI REMAKE — Hub OST / Login OST</Run> — Mike Aniki (used with explicit permission)</TextBlock>
                    <TextBlock FontSize="12" Margin="0,0,0,2"><Run FontWeight="SemiBold">• Dark Ambient Soundscape Music / Dark Space Ambient</Run> — Tunetank (Pixabay Content License)</TextBlock>
                    <TextBlock FontSize="12" Margin="0,0,0,2"><Run FontWeight="SemiBold">• Ambient Background 2</Run> — DELOSound / Roman Dolmatov (Pixabay Content License)</TextBlock>
                </StackPanel>
            </Border>

            <!-- Thanks / people credits -->
            <Border BorderBrush="#FF8888FF" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,20" Background="#1A8888FF">
                <StackPanel>
                    <TextBlock Text="Thanks" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6">
                        <Run FontWeight="SemiBold">Mike Aniki</Run> — for the work on fully integrating UniPlaySong with ANIKI REMAKE, and for requesting and testing the theme-integration features that came out of it.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6">
                        <Run FontWeight="SemiBold">Justin Delano (JDD)</Run> — for integrating UniPlaySong with PlayniteAchievements, so achievement unlocks can trigger UPS sounds.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,0">
                        <Run FontWeight="SemiBold">Everyone who reported a bug</Run> — users taking the time to write up what broke, and often test the fix, is how a lot of this plugin got sorted out. Thank you.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Setup Instructions -->
            <TextBlock Text="Setup" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="0,0,0,10">
                Most features work out of the box. A few optional features require external tools, which you install yourself:
            </TextBlock>

            <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,4,0,2">yt-dlp and Deno (for YouTube music downloads)</TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="20,0,0,6">
                Download yt-dlp.exe and deno.exe. Place both in the same folder (Deno is the JavaScript runtime yt-dlp uses for YouTube's player extraction). Then point the plugin to yt-dlp.exe in the Setup tab.
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="20,0,0,10">
                <TextBlock FontSize="11" Foreground="Gray" Text="Downloads: "/>
                <TextBlock FontSize="11">
                    <Hyperlink NavigateUri="https://github.com/yt-dlp/yt-dlp/releases" RequestNavigate="AboutHyperlink_RequestNavigate">yt-dlp</Hyperlink>
                </TextBlock>
                <TextBlock FontSize="11" Foreground="Gray" Text=" | "/>
                <TextBlock FontSize="11">
                    <Hyperlink NavigateUri="https://deno.com/" RequestNavigate="AboutHyperlink_RequestNavigate">Deno</Hyperlink>
                </TextBlock>
            </StackPanel>

            <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,4,0,2">FFmpeg (for normalization, conversion, and waveform editing)</TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="20,0,0,6">
                Download FFmpeg and point the plugin to ffmpeg.exe in the Setup tab. Required for music downloads, plus audio normalization, bulk format conversion, silence trim, and amplify.
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="20,0,0,10">
                <TextBlock FontSize="11" Foreground="Gray" Text="Download: "/>
                <TextBlock FontSize="11">
                    <Hyperlink NavigateUri="https://ffmpeg.org/download.html" RequestNavigate="AboutHyperlink_RequestNavigate">ffmpeg.org</Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Links -->
            <Separator Margin="0,5,0,15"/>
            <TextBlock Text="Links" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                <TextBlock Text="GitHub: " FontSize="12" Width="100"/>
                <TextBlock FontSize="12">
                    <Hyperlink NavigateUri="https://github.com/aHuddini/UniPlaySong" RequestNavigate="AboutHyperlink_RequestNavigate">github.com/aHuddini/UniPlaySong</Hyperlink>
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                <TextBlock Text="Report a bug: " FontSize="12" Width="100"/>
                <TextBlock FontSize="12">
                    <Hyperlink NavigateUri="https://github.com/aHuddini/UniPlaySong/issues" RequestNavigate="AboutHyperlink_RequestNavigate">Open an issue on GitHub</Hyperlink>
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                <TextBlock Text="Support: " FontSize="12" Width="100"/>
                <TextBlock FontSize="12">
                    <Hyperlink NavigateUri="https://ko-fi.com/Z8Z11SG2IK" RequestNavigate="AboutHyperlink_RequestNavigate">Ko-fi</Hyperlink>
                </TextBlock>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
