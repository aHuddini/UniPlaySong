<UserControl x:Class="UniPlaySong.Controls.Settings.ToastNotificationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UniPlaySong"
             xmlns:ups="clr-namespace:UniPlaySong.Controls.Settings"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UniPlaySong;component/Controls/Settings/SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer Style="{StaticResource UpsPage}">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">
            <TextBlock Text="Toast Notification Settings" Style="{StaticResource UpsPageTitle}"/>
            <TextBlock Text="Customize the appearance and behavior of toast notifications shown in fullscreen/controller mode." Style="{StaticResource UpsPageSubtitle}"/>

            <!-- Test Toast Button -->
            <Border Style="{StaticResource UpsCard}" CornerRadius="4" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <Border Style="{StaticResource UpsSectionBar}"><TextBlock ups:TrackedCaps.Text="Preview" Style="{StaticResource UpsSectionTitle}"/></Border>
                    <TextBlock Text="Test the current toast settings to see how they look."
                               Style="{StaticResource UpsHintFlush}"
                               Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource UpsButton}" Content="Show Test Toast"
                                Width="140"
                                Margin="0,0,10,0"
                                Command="{Binding ShowTestToastCommand}"/>
                        <Button Style="{StaticResource UpsButton}" Content="Show Error Toast"
                                Width="140"
                                Command="{Binding ShowTestErrorToastCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Blur Effect Settings -->
            <Border Style="{StaticResource UpsSectionBar}"><TextBlock ups:TrackedCaps.Text="Blur Effect" Style="{StaticResource UpsSectionTitle}"/></Border>
            <TextBlock Text="Acrylic blur effect creates a frosted glass appearance. Requires Windows 10 1803 or later."
                       Style="{StaticResource UpsHintFlush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <CheckBox Style="{StaticResource UpsToggle}" Content="Enable Acrylic Blur Effect"
                      IsChecked="{Binding Settings.EnableToastAcrylicBlur}"/>

            <!-- Blur Opacity -->
            <StackPanel Orientation="Horizontal" Margin="0,15,0,5">
                <TextBlock Style="{StaticResource UpsLabel}" Text="Blur Opacity: " VerticalAlignment="Center" Width="120"/>
                <TextBlock Style="{StaticResource UpsLabel}" Text="{Binding Settings.ToastBlurOpacity}"
                           VerticalAlignment="Center"
                           Width="35"/>
                <Slider Minimum="0" Maximum="255"
                        Value="{Binding Settings.ToastBlurOpacity}"
                        Width="200"
                        SmallChange="5"
                        LargeChange="20"
                        TickFrequency="32"
                        TickPlacement="BottomRight"
                        Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock Text="Higher = more opaque/darker. Lower = more transparent (more blur visible). 0 = fully transparent. Default: 221"
                       Style="{StaticResource UpsHint}"
                       TextWrapping="Wrap"
                       Margin="32,0,0,10"/>

            <!-- Blur Mode -->
            <StackPanel Orientation="Horizontal" Margin="0,15,0,5">
                <TextBlock Style="{StaticResource UpsLabel}" Text="Blur Mode: " VerticalAlignment="Center" Width="120"/>
                <ComboBox Style="{StaticResource UpsComboBox}" SelectedIndex="{Binding Settings.ToastBlurMode}" Width="200">
                    <ComboBoxItem Content="Basic Blur (Less Intense)"/>
                    <ComboBoxItem Content="Acrylic Blur (More Intense)"/>
                </ComboBox>
            </StackPanel>
            <TextBlock Text="Acrylic blur has a frosted glass effect with noise texture and supports tint color. Basic blur is smoother but does NOT support tint color (Windows API limitation)."
                       Style="{StaticResource UpsHint}"
                       TextWrapping="Wrap"
                       Margin="32,0,0,15"/>

            <!-- Blur Tint Color Section (Acrylic mode only) -->
            <Border Style="{StaticResource UpsSectionBar}"><TextBlock ups:TrackedCaps.Text="Tint Color (Acrylic Mode Only)" Style="{StaticResource UpsSectionTitle}"/></Border>

            <!-- Color Preview and Hex Input -->
            <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                <TextBlock Style="{StaticResource UpsLabel}" Text="Color: " VerticalAlignment="Center" Width="120"/>
                <Border Width="40" Height="24" CornerRadius="4" BorderBrush="#555" BorderThickness="1" Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Background="{Binding Settings.ToastBlurTintColor, Converter={StaticResource HexToColorConverter}}"/>
                <TextBlock Style="{StaticResource UpsLabel}" Text="#" VerticalAlignment="Center"/>
                <TextBox Style="{StaticResource UpsTextBox}" Text="{Binding Settings.ToastBlurTintColor, UpdateSourceTrigger=PropertyChanged}"
                         Width="80"
                         MaxLength="6"
                         VerticalContentAlignment="Center"/>
            </StackPanel>

            <!-- Quick Color Presets -->
            <StackPanel Orientation="Horizontal" Margin="0,5,0,15">
                <TextBlock Style="{StaticResource UpsLabel}" Text="Presets: " VerticalAlignment="Center" Width="120"/>
                <Button Style="{StaticResource UpsButton}" Content="Dark" Width="50" Margin="0,0,5,0" Padding="5,2"
                        Command="{Binding SetToastColorCommand}" CommandParameter="1E1E1E"
                        ToolTip="Dark gray (#1E1E1E)"/>
                <Button Style="{StaticResource UpsButton}" Content="Black" Width="50" Margin="0,0,5,0" Padding="5,2"
                        Command="{Binding SetToastColorCommand}" CommandParameter="000000"
                        ToolTip="Pure black (#000000)"/>
                <Button Style="{StaticResource UpsButton}" Content="Blue" Width="50" Margin="0,0,5,0" Padding="5,2"
                        Command="{Binding SetToastColorCommand}" CommandParameter="1A237E"
                        ToolTip="Dark blue (#1A237E)"/>
                <Button Style="{StaticResource UpsButton}" Content="Purple" Width="50" Margin="0,0,5,0" Padding="5,2"
                        Command="{Binding SetToastColorCommand}" CommandParameter="4A148C"
                        ToolTip="Dark purple (#4A148C)"/>
                <Button Style="{StaticResource UpsButton}" Content="Green" Width="50" Margin="0,0,5,0" Padding="5,2"
                        Command="{Binding SetToastColorCommand}" CommandParameter="1B5E20"
                        ToolTip="Dark green (#1B5E20)"/>
                <Button Style="{StaticResource UpsButton}" Content="Red" Width="50" Padding="5,2"
                        Command="{Binding SetToastColorCommand}" CommandParameter="B71C1C"
                        ToolTip="Dark red (#B71C1C)"/>
            </StackPanel>

            <!-- RGB Sliders with Brightness -->
            <Border Style="{StaticResource UpsCard}" CornerRadius="4" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Style="{StaticResource UpsCardTitle}" Text="RGB Color Mixer" Margin="0,0,0,10"/>

                    <!-- Brightness -->
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                        <TextBlock Text="Brightness:" VerticalAlignment="Center" Width="70" FontSize="12" Foreground="#FFD93D"/>
                        <Button Style="{StaticResource UpsButton}" Content="-" Width="30" Margin="0,0,5,0" Padding="5,2"
                                Command="{Binding AdjustBrightnessCommand}" CommandParameter="-20"
                                ToolTip="Darken color"/>
                        <Button Style="{StaticResource UpsButton}" Content="--" Width="30" Margin="0,0,10,0" Padding="5,2"
                                Command="{Binding AdjustBrightnessCommand}" CommandParameter="-50"
                                ToolTip="Darken more"/>
                        <Button Style="{StaticResource UpsButton}" Content="+" Width="30" Margin="0,0,5,0" Padding="5,2"
                                Command="{Binding AdjustBrightnessCommand}" CommandParameter="20"
                                ToolTip="Lighten color"/>
                        <Button Style="{StaticResource UpsButton}" Content="++" Width="30" Padding="5,2"
                                Command="{Binding AdjustBrightnessCommand}" CommandParameter="50"
                                ToolTip="Lighten more"/>
                    </StackPanel>

                    <!-- Red -->
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                        <TextBlock Text="R:" VerticalAlignment="Center" Width="25" FontSize="12" Foreground="#FF6B6B"/>
                        <TextBlock Style="{StaticResource UpsLabel}" Text="{Binding ToastColorRed}" VerticalAlignment="Center" Width="35"/>
                        <Slider Minimum="0" Maximum="255"
                                Value="{Binding ToastColorRed}"
                                Width="200"
                                SmallChange="1"
                                LargeChange="16"/>
                    </StackPanel>

                    <!-- Green -->
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                        <TextBlock Text="G:" VerticalAlignment="Center" Width="25" FontSize="12" Foreground="#69DB7C"/>
                        <TextBlock Style="{StaticResource UpsLabel}" Text="{Binding ToastColorGreen}" VerticalAlignment="Center" Width="35"/>
                        <Slider Minimum="0" Maximum="255"
                                Value="{Binding ToastColorGreen}"
                                Width="200"
                                SmallChange="1"
                                LargeChange="16"/>
                    </StackPanel>

                    <!-- Blue -->
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                        <TextBlock Text="B:" VerticalAlignment="Center" Width="25" FontSize="12" Foreground="#74C0FC"/>
                        <TextBlock Style="{StaticResource UpsLabel}" Text="{Binding ToastColorBlue}" VerticalAlignment="Center" Width="35"/>
                        <Slider Minimum="0" Maximum="255"
                                Value="{Binding ToastColorBlue}"
                                Width="200"
                                SmallChange="1"
                                LargeChange="16"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Use the RGB sliders, brightness buttons, or presets to pick a tint color. Only works with Acrylic blur mode."
                       Style="{StaticResource UpsHintFlush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,15"/>

            <!-- Size Settings -->
            <Border Style="{StaticResource UpsSectionBar}"><TextBlock ups:TrackedCaps.Text="Size &amp; Position" Style="{StaticResource UpsSectionTitle}"/></Border>

            <!-- Width -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                <TextBlock Style="{StaticResource UpsLabel}" Text="Width: " VerticalAlignment="Center" Width="120"/>
                <TextBlock Style="{StaticResource UpsLabel}" Text="{Binding Settings.ToastWidth, StringFormat='{}{0:F0}'}"
                           VerticalAlignment="Center"
                           Width="40"/>
                <TextBlock Style="{StaticResource UpsLabel}" Text="px" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider Minimum="200" Maximum="800"
                        Value="{Binding Settings.ToastWidth}"
                        Width="200"
                        SmallChange="10"
                        LargeChange="50"
                        TickFrequency="100"
                        TickPlacement="BottomRight"/>
            </StackPanel>

            <!-- Min Height -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                <TextBlock Style="{StaticResource UpsLabel}" Text="Min Height: " VerticalAlignment="Center" Width="120"/>
                <TextBlock Style="{StaticResource UpsLabel}" Text="{Binding Settings.ToastMinHeight, StringFormat='{}{0:F0}'}"
                           VerticalAlignment="Center"
                           Width="40"/>
                <TextBlock Style="{StaticResource UpsLabel}" Text="px" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider Minimum="50" Maximum="200"
                        Value="{Binding Settings.ToastMinHeight}"
                        Width="200"
                        SmallChange="5"
                        LargeChange="20"
                        TickFrequency="25"
                        TickPlacement="BottomRight"/>
            </StackPanel>

            <!-- Max Height -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                <TextBlock Style="{StaticResource UpsLabel}" Text="Max Height: " VerticalAlignment="Center" Width="120"/>
                <TextBlock Style="{StaticResource UpsLabel}" Text="{Binding Settings.ToastMaxHeight, StringFormat='{}{0:F0}'}"
                           VerticalAlignment="Center"
                           Width="40"/>
                <TextBlock Style="{StaticResource UpsLabel}" Text="px" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider Minimum="100" Maximum="400"
                        Value="{Binding Settings.ToastMaxHeight}"
                        Width="200"
                        SmallChange="10"
                        LargeChange="50"
                        TickFrequency="50"
                        TickPlacement="BottomRight"/>
            </StackPanel>

            <!-- Corner Radius -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                <TextBlock Style="{StaticResource UpsLabel}" Text="Corner Radius: " VerticalAlignment="Center" Width="120"/>
                <TextBlock Style="{StaticResource UpsLabel}" Text="{Binding Settings.ToastCornerRadius, StringFormat='{}{0:F0}'}"
                           VerticalAlignment="Center"
                           Width="40"/>
                <TextBlock Style="{StaticResource UpsLabel}" Text="px" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider Minimum="0" Maximum="32"
                        Value="{Binding Settings.ToastCornerRadius}"
                        Width="200"
                        SmallChange="1"
                        LargeChange="4"
                        TickFrequency="4"
                        TickPlacement="BottomRight"/>
            </StackPanel>
            <TextBlock Text="0 = square corners, higher = more rounded. Default: 8"
                       Style="{StaticResource UpsHintFlush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <!-- Edge Margin -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                <TextBlock Style="{StaticResource UpsLabel}" Text="Edge Margin: " VerticalAlignment="Center" Width="120"/>
                <TextBlock Style="{StaticResource UpsLabel}" Text="{Binding Settings.ToastEdgeMargin}"
                           VerticalAlignment="Center"
                           Width="40"/>
                <TextBlock Style="{StaticResource UpsLabel}" Text="px" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider Minimum="0" Maximum="100"
                        Value="{Binding Settings.ToastEdgeMargin}"
                        Width="200"
                        SmallChange="5"
                        LargeChange="10"
                        TickFrequency="10"
                        TickPlacement="BottomRight"/>
            </StackPanel>
            <TextBlock Text="Distance from screen edge where toast appears. Default: 30"
                       Style="{StaticResource UpsHintFlush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,15"/>

            <!-- Timing Settings -->
            <Border Style="{StaticResource UpsSectionBar}"><TextBlock ups:TrackedCaps.Text="Timing" Style="{StaticResource UpsSectionTitle}"/></Border>

            <!-- Duration -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                <TextBlock Style="{StaticResource UpsLabel}" Text="Duration: " VerticalAlignment="Center" Width="120"/>
                <TextBlock Style="{StaticResource UpsLabel}" Text="{Binding Settings.ToastDurationMs, StringFormat='{}{0:F0}'}"
                           VerticalAlignment="Center"
                           Width="50"/>
                <TextBlock Style="{StaticResource UpsLabel}" Text="ms" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider Minimum="1000" Maximum="10000"
                        Value="{Binding Settings.ToastDurationMs}"
                        Width="200"
                        SmallChange="250"
                        LargeChange="1000"
                        TickFrequency="1000"
                        TickPlacement="BottomRight"/>
            </StackPanel>
            <TextBlock Text="How long the toast stays on screen (in milliseconds). 1000 = 1 second. Default: 4000 (4 seconds)"
                       Style="{StaticResource UpsHintFlush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,15"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
