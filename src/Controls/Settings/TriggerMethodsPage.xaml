<UserControl x:Class="UniPlaySong.Controls.Settings.TriggerMethodsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UniPlaySong"
             xmlns:ups="clr-namespace:UniPlaySong.Controls.Settings"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UniPlaySong;component/Controls/Settings/SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The old "Play Methods" block. Every setting here answers the same question — which
         games get their own music — and every one of them falls through to default music
         when it does not match, which is why Default Music is its own page next door. -->

    <ScrollViewer Style="{StaticResource UpsPage}">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">

            <TextBlock Text="Trigger Methods" Style="{StaticResource UpsPageTitle}"/>
            <TextBlock Style="{StaticResource UpsPageSubtitle}"
                       Text="Which games get their own music. Anything that does not match falls through to default music."/>

            <Border Style="{StaticResource UpsSectionBar}">
                <TextBlock ups:TrackedCaps.Text="Which Games" Style="{StaticResource UpsSectionTitle}"/>
            </Border>

            <CheckBox Content="Installed games only"
                      Style="{StaticResource UpsToggle}"
                      IsChecked="{Binding Settings.MusicOnlyForInstalledGames}"/>
            <TextBlock Style="{StaticResource UpsHint}"
                       Text="Uninstalled games use default music instead — or stay silent, if default music is off."/>

            <CheckBox Content="Only on explicit selection (Fullscreen)"
                      Style="{StaticResource UpsToggle}"
                      IsChecked="{Binding Settings.PlayOnlyOnGameSelect}"/>
            <TextBlock Style="{StaticResource UpsHint}"
                       Text="Game music waits until you press A on a game. Default music covers D-pad browsing; press B to go back to it."/>

            <!-- Collapsed: three ways to narrow the same thing, and most setups use none of
                 them. Leaving them open pushes Radio Mode below the fold. -->
            <Expander Style="{StaticResource UpsSection}">
                <Expander.Header>
                    <TextBlock ups:TrackedCaps.Text="Match Filters" Style="{StaticResource UpsSectionTitle}"/>
                </Expander.Header>
                <StackPanel>

                    <CheckBox Content="Nostalgia Mode"
                              Style="{StaticResource UpsToggle}"
                              IsChecked="{Binding Settings.NostalgiaMode}"/>
                    <TextBlock Style="{StaticResource UpsHint}"
                               Text="Game music only for games at the completion statuses you pick. Select &quot;Completed&quot; to hear only the games you have finished."/>
                    <StackPanel Orientation="Horizontal" Margin="32,0,0,14"
                                IsEnabled="{Binding Settings.NostalgiaMode}">
                        <Button Style="{StaticResource UpsButton}" Content="Select statuses..."
                                Command="{Binding SelectNostalgiaStatusesCommand}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding NostalgiaStatusSummary}"
                                   Style="{StaticResource UpsValue}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <CheckBox Content="Game property filter"
                              Style="{StaticResource UpsToggle}"
                              IsChecked="{Binding Settings.GamePropFilterEnabled}"/>
                    <TextBlock Style="{StaticResource UpsHint}"
                               Text="Game music only for the platforms, genres or sources you pick — a game matching any one of them qualifies. Select &quot;PC&quot; to hear music only while browsing PC games."/>
                    <StackPanel Margin="32,0,0,14" IsEnabled="{Binding Settings.GamePropFilterEnabled}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Style="{StaticResource UpsButton}" Content="Platforms..." Width="104"
                                    Command="{Binding SelectGamePropFilterPlatformsCommand}"/>
                            <TextBlock Text="{Binding GamePropFilterPlatformSummary}"
                                       Style="{StaticResource UpsValue}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Style="{StaticResource UpsButton}" Content="Genres..." Width="104"
                                    Command="{Binding SelectGamePropFilterGenresCommand}"/>
                            <TextBlock Text="{Binding GamePropFilterGenreSummary}"
                                       Style="{StaticResource UpsValue}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource UpsButton}" Content="Sources..." Width="104"
                                    Command="{Binding SelectGamePropFilterSourcesCommand}"/>
                            <TextBlock Text="{Binding GamePropFilterSourceSummary}"
                                       Style="{StaticResource UpsValue}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <CheckBox Content="Filter Mode"
                              Style="{StaticResource UpsToggle}"
                              IsChecked="{Binding Settings.FilterModeEnabled}"/>
                    <TextBlock Style="{StaticResource UpsHint}"
                               Text="Game music only while one of Playnite's own filter presets is active. Make a preset called &quot;RPGs&quot; and music plays only while it is applied — on All Games, everything falls through to default music."/>

                </StackPanel>
            </Expander>

            <!-- Not collapsed: Radio Mode overrides every setting above it, so hiding it behind
                 a fold would let someone tune filters that Radio Mode is quietly ignoring. -->
            <Border Style="{StaticResource UpsSectionBar}">
                <TextBlock ups:TrackedCaps.Text="Radio Mode" Style="{StaticResource UpsSectionTitle}"/>
            </Border>

            <CheckBox Content="Radio Mode"
                      Style="{StaticResource UpsToggle}"
                      IsChecked="{Binding Settings.RadioModeEnabled}"/>
            <TextBlock Style="{StaticResource UpsHint}"
                       Text="Ignores game selection entirely and plays continuously from one pool, like background radio. Overrides both game music and default music while it is on."/>

            <StackPanel Margin="32,0,0,0" IsEnabled="{Binding Settings.RadioModeEnabled}">

                <RadioButton Content="Full library — every song you have downloaded"
                             Style="{StaticResource UpsRadio}"
                             IsChecked="{Binding Settings.RadioMusicSource, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=FullLibrary}"/>

                <RadioButton Content="Custom folder"
                             Style="{StaticResource UpsRadio}"
                             IsChecked="{Binding Settings.RadioMusicSource, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=CustomFolder}"/>
                <StackPanel Orientation="Horizontal" Margin="24,2,0,0">
                    <TextBox Style="{StaticResource UpsTextBox}" Width="330" Margin="0,0,10,0"
                             Text="{Binding Settings.RadioCustomFolderPath}" IsReadOnly="True"/>
                    <Button Style="{StaticResource UpsButton}" Content="Browse..." Width="86"
                            Command="{Binding BrowseForRadioCustomFolder}"/>
                </StackPanel>
                <TextBlock Style="{StaticResource UpsHintFlush}" Margin="24,4,0,10"
                           Text="Shuffles any audio files in that folder. Left empty, it falls back to your Default Music folder."/>

                <RadioButton Content="Custom game rotation"
                             Style="{StaticResource UpsRadio}"
                             IsChecked="{Binding Settings.RadioMusicSource, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=CustomRotation}"/>

                <RadioButton Content="Completion status pool"
                             Style="{StaticResource UpsRadio}"
                             IsChecked="{Binding Settings.RadioMusicSource, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=CompletionStatusPool}"/>

                <RadioButton Style="{StaticResource UpsRadio}"
                             IsChecked="{Binding Settings.RadioMusicSource, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Spotify}"
                             Command="{Binding SetRestartRequired}"
                             CommandParameter="{Binding RelativeSource={RelativeSource Self}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Official Spotify logomark. Brand green #1DB954, geometry from resources. -->
                        <Path Data="{StaticResource SpotifyLogoGeometry}"
                              Fill="#1DB954" Stretch="Uniform"
                              Width="15" Height="15" Margin="0,0,7,0"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Spotify desktop app" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <TextBlock Style="{StaticResource UpsHintFlush}" Margin="24,2,0,10"
                           Text="Plays the open Spotify app as continuous background music instead of a UPS pool. UPS pauses and resumes it on game launch, video, focus loss and lock, but does not play its audio itself — so the visualizer and fades do not apply. Restart Playnite after selecting this."/>

            </StackPanel>

            <TextBlock Style="{StaticResource UpsHintFlush}" Margin="32,0,0,0"
                       Text="Full library shuffles everything you have downloaded. The other pool sources reuse whatever you configured on the Default Music page."/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
