<UserControl x:Class="UniPlaySong.Controls.Settings.QuickStartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UniPlaySong"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UniPlaySong;component/Controls/Settings/SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
    <!-- Opaque slate palette, deliberately NOT translucent white.
         The page previously used #14FFFFFF / #1FFFFFFF / #26FFFFFF — white at 7-14%
         opacity — which does not have a colour of its own: it simply lightens whatever
         the theme paints behind it, so every panel came out the same washed grey and
         the status bar read as "a white bar". These are solid, biased slightly blue so
         the panels sit apart from Playnite's neutral chrome instead of tinting it.
         Change these four and the whole tab follows. -->
    <!-- The tab's own ground. Every other tab in this window leaves its background
         transparent and inherits the Playnite theme, which is why the area behind the
         tiles kept reading as the theme's pale surface no matter what colour the
         panels were — the panels were the only thing being painted. Setting this is
         what actually overrides the theme for this tab. Darker than QsTile so the rows
         sit ON something rather than blending into it. -->
    <SolidColorBrush x:Key="QsGround" Color="#12171E"/>

    <!-- Primary text. This page paints its own dark ground, so it has to own its text colour to
         match: anything left to inherit takes the host theme's foreground, which is chosen for the
         theme's background rather than for QsGround. Checkboxes were the visible casualty — their
         labels came out near-black on the dark surface. Local Foreground values on individual
         elements still win over this, so the dim greys below are unaffected. -->
    <SolidColorBrush x:Key="QsText" Color="#E4E9EF"/>
    <SolidColorBrush x:Key="QsPanel" Color="#232D3A"/>
    <SolidColorBrush x:Key="QsTile" Color="#1A222C"/>
    <SolidColorBrush x:Key="QsTileHover" Color="#243040"/>
    <SolidColorBrush x:Key="QsStroke" Color="#31404F"/>
    <SolidColorBrush x:Key="QsStrokeHover" Color="#4A5F73"/>

    <!-- Applied-profile row. Green to agree with the ACTIVE badge and the rail, but
         heavily darkened toward the tile colour: a saturated green fill behind
         11px body text would cost more contrast than the highlight is worth. -->
    <SolidColorBrush x:Key="QsTileActive" Color="#1B3226"/>
    <SolidColorBrush x:Key="QsStrokeActive" Color="#4E8C5E"/>

    <!-- Section heading with a left accent bar, so the mode groups read as distinct
         bands rather than another line of bold text. -->
    <Style x:Key="QsSectionHeader" TargetType="Border">
        <Setter Property="BorderBrush" Value="#4CC2FF"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="Padding" Value="10,2,0,2"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- Card surface for a profile row. The hover state lifts the border to the accent
         and brightens the fill, so the whole row reads as the target rather than just
         the Apply button. -->
    <Style x:Key="QsCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource QsTile}"/>
        <Setter Property="BorderBrush" Value="{StaticResource QsStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,7"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource QsTileHover}"/>
                <!-- Neutral hover, so the only coloured signal on a row is the active state. -->
                <Setter Property="BorderBrush" Value="{StaticResource QsStrokeHover}"/>
            </Trigger>

            <!-- The applied profile lights the WHOLE row, not just its 4px rail: a
                 green-tinted fill and a green border, so it reads as selected at a
                 glance instead of needing the eye to find a thin stripe.

                 Listed after the hover trigger deliberately — later triggers win in
                 WPF, so hovering the active row does not wash the green back out.
                 The tint is dark enough that the body text keeps its contrast. -->
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="{StaticResource QsTileActive}"/>
                <Setter Property="BorderBrush" Value="{StaticResource QsStrokeActive}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="QsProfileTile">
        <Border Style="{StaticResource QsCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Active rail: a fixed 4px column so every row aligns whether or not it is
                         lit. Wider than the 3px section-header bars because this one
                         carries state, not structure. -->
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="6,0,0,6"
                        Background="{Binding IsActive, Converter={StaticResource ActiveRailConverter}}"/>

                <StackPanel Grid.Column="1" Margin="14,12,16,12" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource QsText}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#9AA0A6"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Apply" Width="76" Padding="8,5"
                        Margin="0,0,14,0" VerticalAlignment="Center"
                        Command="{Binding DataContext.ApplyQuickStartProfile, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}"/>
            </Grid>
        </Border>
    </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Pick a way of listening in one click. Tiles are distinct playback
         behaviours, not bundles of checkboxes — variations that differ by a single setting are
         the checkboxes below instead, which is what keeps the tile count down.

         Layout is full-width rows with card styling, chosen over a card GRID: Playnite's
         settings window is often narrow, and a grid collapses to one column there — giving up
         the grid's only advantage while leaving the descriptions cramped. Rows keep the
         description readable at every width and still get the rounded surface, hover lift and
         accent rail that make it read as a set of choices rather than a list of settings.

         The tile template is defined once as a resource and reused by both mode lists; it was
         duplicated per list before, so a styling change had to be made twice and could drift. -->

    <ScrollViewer Background="{StaticResource QsGround}" Padding="20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  TextElement.Foreground="{StaticResource QsText}">
        <!-- Padding on the ScrollViewer, not Margin here, so QsGround fills the whole
             tab instead of leaving a theme-coloured gutter around the edge. -->
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="Quick Start" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"
                       Foreground="{StaticResource QsText}"/>
            <!-- Says who the tab is FOR, not just what it does. Without this it reads as
                 another settings screen, when the point is that it replaces having to read
                 the other fifteen. -->
            <TextBlock Text="For getting up and running without going through every tab. Pick how you want music to behave and UniPlaySong sets the rest up for you."
                       FontSize="12" Foreground="#B8C2CC"
                       TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock Text="Everything here can still be changed by hand on the other tabs afterwards — and applying an option only touches the playback settings it covers, so your volume, tool paths, pause rules and effects are left alone."
                       FontSize="11" Foreground="#7A8085"
                       TextWrapping="Wrap" Margin="0,0,0,16"/>

            <!-- Status strip: what is active, and the two ways back out. -->
            <Border Background="{StaticResource QsPanel}" BorderBrush="{StaticResource QsStroke}" BorderThickness="1"
                    CornerRadius="6" Padding="14,11" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ACTIVE PROFILE" FontSize="9" Foreground="#7A8085"
                                   FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <StackPanel Orientation="Horizontal">
                            <!-- Colour-coded status: green when the applied profile is
                                 intact, amber once one of its settings has been changed,
                                 grey when none is applied. The word is shown as well as the
                                 colour, so the state is not conveyed by colour alone. -->
                            <Border Background="{Binding ActiveProfileBrush}" CornerRadius="3"
                                    Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                    Visibility="{Binding ActiveProfileState, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="{Binding ActiveProfileState}" FontSize="9"
                                           FontWeight="Bold" Foreground="#101214"/>
                            </Border>
                            <TextBlock Text="{Binding ActiveProfileLabel}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{Binding ActiveProfileBrush}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Undo" Padding="10,4" FontSize="11" MinWidth="60"
                                ToolTip="Step back the last profile you applied."
                                Command="{Binding UndoQuickStart}"
                                IsEnabled="{Binding CanUndoQuickStart}"/>
                        <!-- Steps back to the settings from before ANY profile, not just the
                             last one, and clears the active profile. Not a factory reset. -->
                        <Button Content="Reset to my settings" Margin="8,0,0,0" Padding="10,4" FontSize="11"
                                ToolTip="Go back to your settings from before you used Quick Start."
                                Command="{Binding RestoreQuickStartOriginal}"
                                IsEnabled="{Binding CanRestoreQuickStartOriginal}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource QsSectionHeader}">
                <StackPanel>
                    <TextBlock Text="Fullscreen" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource QsText}"/>
                    <TextBlock Text="Couch and controller." FontSize="11" Foreground="#7A8085"/>
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding FullscreenProfiles}"
                          ItemTemplate="{StaticResource QsProfileTile}" Margin="0,0,0,20"/>

            <Border Style="{StaticResource QsSectionHeader}">
                <StackPanel>
                    <TextBlock Text="Desktop" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource QsText}"/>
                    <TextBlock Text="Mouse and keyboard. Select to Play is Fullscreen-only, so it is not offered here."
                               FontSize="11" Foreground="#7A8085" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding DesktopProfiles}"
                          ItemTemplate="{StaticResource QsProfileTile}" Margin="0,0,0,20"/>

            <Border Style="{StaticResource QsSectionHeader}">
                <StackPanel>
                    <TextBlock Text="Options" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource QsText}"/>
                    <TextBlock Text="Your current settings. A profile that decides one of these keeps its own choice."
                               FontSize="11" Foreground="#7A8085" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Foreground set on each of these four rather than left to inherit: a CheckBox takes
                 its own from the host theme's CheckBox style, which outranks the inherited value
                 set on the ScrollViewer above. -->
            <CheckBox Content="Only play music for installed games" Foreground="{StaticResource QsText}"
                      IsChecked="{Binding QuickStartInstalledOnly}" Margin="0,4"/>
            <TextBlock Text="Uninstalled games fall back to your default music. Radio Mode ignores this."
                       FontSize="11" Foreground="#7A8085" TextWrapping="Wrap" Margin="24,0,0,10"/>

            <CheckBox Content="Keep playing during games" Foreground="{StaticResource QsText}"
                      IsChecked="{Binding QuickStartPlayThroughGames}" Margin="0,4"/>
            <TextBlock Text="Radio Mode only — the mix carries on instead of pausing when a game starts."
                       FontSize="11" Foreground="#7A8085" TextWrapping="Wrap" Margin="24,0,0,10"/>

            <CheckBox Content="Spotify as the radio source" Foreground="{StaticResource QsText}"
                      IsChecked="{Binding QuickStartUseSpotify}" Margin="0,4"/>
            <TextBlock Text="Radio Mode plays from Spotify instead of your library. Spotify must be running. Does not turn Radio Mode on by itself."
                       FontSize="11" Foreground="#7A8085" TextWrapping="Wrap" Margin="24,0,0,10"/>

            <CheckBox Content="Live Effects reverb" Foreground="{StaticResource QsText}"
                      IsChecked="{Binding QuickStartAddReverb}" Margin="0,4"/>
            <TextBlock Text="Turns on Live Effects with the Huddini Rehearsal preset, and switches to the NAudio engine. Tune it on the Live Effects tab."
                       FontSize="11" Foreground="#7A8085" TextWrapping="Wrap" Margin="24,0,0,14"/>

            <TextBlock Text="A track that is already playing runs to its end. Select a different game to hear a new profile straight away."
                       FontSize="11" Foreground="#C8A24B" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
