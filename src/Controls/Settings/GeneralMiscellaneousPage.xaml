<UserControl x:Class="UniPlaySong.Controls.Settings.GeneralMiscellaneousPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UniPlaySong"
             xmlns:ups="clr-namespace:UniPlaySong.Controls.Settings"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UniPlaySong;component/Controls/Settings/SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- General settings that belong to no single page. Kept deliberately small: things land here
         because they are genuinely cross-cutting, not because a home was hard to find. -->

    <ScrollViewer Style="{StaticResource UpsPage}">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">

            <TextBlock Text="Miscellaneous" Style="{StaticResource UpsPageTitle}"/>
            <TextBlock Style="{StaticResource UpsPageSubtitle}"
                       Text="Settings that do not belong to one of the other General pages."/>

            <Border Style="{StaticResource UpsSectionBar}">
                <TextBlock ups:TrackedCaps.Text="Desktop Sidebar" Style="{StaticResource UpsSectionTitle}"/>
            </Border>

            <CheckBox Style="{StaticResource UpsToggle}" Content="Show a UniPlaySong button in the sidebar"
                      IsChecked="{Binding Settings.ShowSettingsSidebarButton}"
                      Command="{Binding SetRestartRequired}"
                      CommandParameter="{Binding RelativeSource={RelativeSource Self}}"/>
            <TextBlock Style="{StaticResource UpsHint}">
                <Run Text="Puts a UniPlaySong icon in the Desktop sidebar for quick access to these settings."/>
                <Run Text="Restart required."
                     Foreground="{StaticResource UpsWarn}" FontWeight="SemiBold"/>
            </TextBlock>

            <Border Style="{StaticResource UpsSectionBar}">
                <TextBlock ups:TrackedCaps.Text="Spotify" Style="{StaticResource UpsSectionTitle}"/>
            </Border>

            <CheckBox Style="{StaticResource UpsToggle}" Content="Open Spotify on startup if it is not running"
                      IsChecked="{Binding Settings.AutoLaunchSpotifyOnStartup}"/>
            <TextBlock Style="{StaticResource UpsHint}" TextWrapping="Wrap"
                       Text="Only when Spotify is your Radio Mode or Default Music source, so music can start without opening it yourself."/>

            <StackPanel Orientation="Horizontal" Margin="20,6,0,0"
                        IsEnabled="{Binding Settings.AutoLaunchSpotifyOnStartup}">
                <TextBlock Style="{StaticResource UpsLabel}" Text="Spotify path (optional): " VerticalAlignment="Center"/>
                <TextBox Style="{StaticResource UpsTextBox}" Text="{Binding Settings.SpotifyExePath, UpdateSourceTrigger=PropertyChanged}"
                         Width="300" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                <Button Style="{StaticResource UpsButton}" Content="Browse..." Command="{Binding BrowseSpotifyExeCommand}" Padding="10,4"/>
            </StackPanel>
            <TextBlock Style="{StaticResource UpsHint}" TextWrapping="Wrap" Margin="32,3,0,0"
                       Text="Leave empty for standard installs. Point this at Spotify.exe or its shortcut only if you use the Microsoft Store version or installed it somewhere unusual."/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
