<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:UniPlaySong">

    <!--
    Shared resources for the settings pages.

    Every settings tab used to live inside UniPlaySongSettingsView.xaml and resolve these
    from that one root. Splitting the tabs into their own UserControls breaks that chain:
    StaticResource walks up the visual tree, so a page hosted anywhere else finds nothing.
    That failure is a runtime XamlParseException, not a build error, so it would surface as
    a settings window that refuses to open rather than a red squiggle.

    Each extracted page merges this dictionary. The converters are stateless, so the extra
    instance per page costs nothing.
    -->

    <local:AudioStateConverter x:Key="AudioStateConverter"/>
    <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    <local:ReverbPresetConverter x:Key="ReverbPresetConverter"/>
    <local:StylePresetConverter x:Key="StylePresetConverter"/>
    <local:EffectChainPresetConverter x:Key="EffectChainPresetConverter"/>
    <local:HexToColorConverter x:Key="HexToColorConverter"/>
    <local:VizPresetConverter x:Key="VizPresetConverter"/>
    <local:VizColorThemeConverter x:Key="VizColorThemeConverter"/>
    <local:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
    <local:ProgressBarPositionConverter x:Key="ProgressBarPositionConverter"/>
    <local:CelebrationThemeConverter x:Key="CelebrationThemeConverter"/>
    <local:AbandonedThemeConverter x:Key="AbandonedThemeConverter"/>
    <local:FadeCurveTypeConverter x:Key="FadeCurveTypeConverter"/>
    <local:SidebarGlowModeConverter x:Key="SidebarGlowModeConverter"/>
    <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    <local:ActiveRailConverter x:Key="ActiveRailConverter"/>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    <!-- Section divider: bolder + accent-tinted so settings sections read as distinct blocks
         instead of blending together. Implicit style applies to every Separator on every page. -->
    <Style TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="#4EC9B0"/>
        <Setter Property="Opacity" Value="0.75"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================================
         Settings page look.

         Taken from the Quick Start tab rather than invented next to it: that tab is the design
         this rework follows, and two slate palettes in one window drift apart on the first tweak.

         Every text style sets Foreground explicitly and none rely on inheritance. That is not
         belt-and-braces — a page paints its own dark ground here, and an inherited colour LOSES to
         the host theme's implicit TextBlock style, so anything left to inherit renders in a colour
         chosen for Playnite's background and can land near-black on ours. Quick Start shipped that
         bug: its profile names had no Foreground while the Summary line right beneath them did.
         ================================================================================ -->

    <SolidColorBrush x:Key="UpsGround"     Color="#12171E"/>
    <SolidColorBrush x:Key="UpsSurface"    Color="#1A222C"/>
    <SolidColorBrush x:Key="UpsSurfaceHi"  Color="#232D3A"/>
    <SolidColorBrush x:Key="UpsStroke"     Color="#31404F"/>
    <SolidColorBrush x:Key="UpsStrokeHi"   Color="#4A5F73"/>
    <SolidColorBrush x:Key="UpsAccent"     Color="#4CC2FF"/>
    <SolidColorBrush x:Key="UpsOn"         Color="#4E8C5E"/>
    <SolidColorBrush x:Key="UpsOnStroke"   Color="#5FA772"/>
    <SolidColorBrush x:Key="UpsText"       Color="#E4E9EF"/>
    <SolidColorBrush x:Key="UpsTextMuted"  Color="#93A1B0"/>
    <SolidColorBrush x:Key="UpsTextFaint"  Color="#6B7A88"/>
    <SolidColorBrush x:Key="UpsWarn"       Color="#C8A24B"/>
    <SolidColorBrush x:Key="UpsDanger"     Color="#E08070"/>

    <!-- The page ground is a slow diagonal rather than a flat fill. Two reasons: a flat ground
         gives a translucent card nothing to sit on, so glass reads as plain grey; and a large
         unbroken block of one colour looks like an unpainted surface rather than a chosen one.
         The range is tiny on purpose — this should never be legible as a gradient. -->
    <LinearGradientBrush x:Key="UpsGroundGlass" StartPoint="0,0" EndPoint="0.85,1">
        <GradientStop Offset="0"   Color="#1A212B"/>
        <GradientStop Offset="0.5" Color="#161C25"/>
        <GradientStop Offset="1"   Color="#131922"/>
    </LinearGradientBrush>

    <!-- Page root. Padding sits here rather than on the inner panel so the ground fills the whole
         page instead of leaving a theme-coloured gutter round the edge. -->
    <Style x:Key="UpsPage" TargetType="ScrollViewer">
        <Setter Property="Background" Value="{StaticResource UpsGroundGlass}"/>
        <Setter Property="Padding" Value="22,18,22,24"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource UpsText}"/>
    </Style>

    <Style x:Key="UpsPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource UpsText}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="UpsPageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource UpsTextMuted}"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,18"/>
    </Style>

    <!-- Section heading with a left accent bar, so groups of settings read as bands rather than
         another line of bold text. -->
    <Style x:Key="UpsSectionBar" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource UpsAccent}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="Padding" Value="10,1,0,1"/>
        <Setter Property="Margin" Value="0,14,0,10"/>
    </Style>

    <!-- Small, dimmed and tracked uppercase, so the heading reads as a band marker rather than
         competing with the setting labels under it. The old 13.5 sat 4% off the 13px labels,
         which is not a hierarchy level — the eye read the whole page as one tier.
         Set the string via TrackedCaps.Text, not Text: WPF has no text-transform or
         letter-spacing, and that attached property supplies both. -->
    <Style x:Key="UpsSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource UpsTextMuted}"/>
    </Style>

    <!-- A collapsible section. Same accent bar and tracked caps as UpsSectionBar, plus a
         disclosure chevron, so a collapsed page still reads as the same design rather than as a
         different kind of control.

         Expanded by default: the settings are the point of the page, and these pages are short
         enough after the split that opening to a wall of closed headings would cost a click per
         section for nothing. Set IsExpanded="False" on any section that is genuinely secondary.

         The ToggleButton carries its own template — without one it picks up the host theme's
         button chrome and the header renders as a raised grey button across the page. -->
    <Style x:Key="UpsSection" TargetType="Expander">
        <Setter Property="IsExpanded" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <!-- Content must be fed from Header explicitly. Without it the button has
                             nothing to present and the heading renders as a bare bar and chevron
                             — which builds and runs perfectly happily. -->
                        <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      Cursor="Hand" Focusable="True" HorizontalAlignment="Left">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"
                                            BorderBrush="{StaticResource UpsAccent}"
                                            BorderThickness="3,0,0,0"
                                            Padding="10,1,0,1" Margin="0,14,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                            <!-- Points right when closed, down when open. -->
                                            <Path x:Name="Chevron" Data="M 0,0 L 4,3.5 L 0,7 Z"
                                                  Fill="{StaticResource UpsTextFaint}"
                                                  VerticalAlignment="Center" Margin="8,0,0,0"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0"/>
                                                </Path.RenderTransform>
                                            </Path>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chevron" Property="Fill"
                                                    Value="{StaticResource UpsAccent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Indent lines the hint up with the toggle's LABEL, not its switch, so the setting and its
         explanation read as one block. 24 track + 8 gap. -->
    <Style x:Key="UpsHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource UpsTextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="32,1,0,12"/>
    </Style>

    <Style x:Key="UpsHintIndented" TargetType="TextBlock" BasedOn="{StaticResource UpsHint}">
        <Setter Property="Margin" Value="56,1,0,12"/>
    </Style>

    <Style x:Key="UpsWarning" TargetType="TextBlock" BasedOn="{StaticResource UpsHint}">
        <Setter Property="Foreground" Value="{StaticResource UpsWarn}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="UpsDangerNote" TargetType="TextBlock" BasedOn="{StaticResource UpsHint}">
        <Setter Property="Foreground" Value="{StaticResource UpsDanger}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="UpsLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource UpsText}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="UpsValue" TargetType="TextBlock" BasedOn="{StaticResource UpsLabel}">
        <Setter Property="Foreground" Value="{StaticResource UpsAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Prose. Wider than a hint and at full strength, for pages that explain rather than configure. -->
    <Style x:Key="UpsBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource UpsText}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- A Hyperlink left unstyled renders in WPF's default navy, which is close to unreadable on
         UpsGround. Accent for the resting state, brighter on hover. -->
    <Style x:Key="UpsLink" TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{StaticResource UpsAccent}"/>
        <Setter Property="TextDecorations" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#8FDCFF"/>
                <Setter Property="TextDecorations" Value="Underline"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================================
         Cards.

         Informational pages (About and its siblings) are built from these rather than from
         section bars. A run of prose under flat headings reads as one wall of text no matter how
         the headings are set; a tinted, bordered box makes each block a distinct object you can
         skip or land on, and the tint says what KIND of block it is before you read a word.

         Settings pages are the opposite case — there the rows are the objects, and cards around
         them would just add noise. Use UpsSectionBar / UpsSection there.

         Tints are the palette's hues at low saturation over the page ground, not the saturated
         borders this replaces; a #FF8888FF border was fighting the slate rather than sitting in
         it. Keep the background near UpsSurface so text contrast never depends on the hue.
         ================================================================================ -->
    <!-- Glazed, not flat. Each fill runs a bright sliver across the top few percent — the lit
         edge of a pane catching light — then falls to a translucent tint. Alpha is real here
         (0xD8, ~85%) so the ground's diagonal shows through and the card sits ON something.

         Note this reverses the warning left on the Quick Start palette, and deliberately. That
         warning was about translucent panels over the HOST THEME's background: white at 7-14%
         has no colour of its own, so every panel came out the same washed grey over an unknown
         ground. These sit over a ground we paint ourselves, so the result is predictable — the
         technique was never the problem, not owning the backdrop was.

         WPF has no backdrop blur. Real acrylic is a Win32 window attribute, and BlurEffect blurs
         the element rather than what is behind it. This is the honest approximation: translucency
         plus a lit edge, which is what reads as glass anyway at this size. -->
    <!-- Card face. A broad diagonal, light corner to dark corner, as if one light source were off
         the top-left. Proportional offsets are correct HERE — the gradient is meant to span the
         whole card, so it scales with it by design. (The earlier bug was a small percentage doing
         the job of a fixed size; that is now the border's job, and a border is 1px by
         construction.)

         Alpha near 0xE6 so the ground's own diagonal shows through and the card sits ON something
         rather than being pasted over it. -->
    <!-- Darker than the ground they sit on, which is the point: these read as smoked glass laid
         on a lighter surface, not as panels cut from it. The bevel's lit top-left corner and the
         drop shadow are what keep them raised rather than reading as holes — a recess would want
         the opposite bevel and no shadow. Alpha stays near 0xE6 so the ground's diagonal still
         shows through the tint. -->
    <LinearGradientBrush x:Key="UpsGlassNeutral" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#E6161D28"/>
        <GradientStop Offset="1" Color="#E60B0F16"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="UpsGlassAccent" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#E6111F2B"/>
        <GradientStop Offset="1" Color="#E6080F16"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="UpsGlassGood" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#E6102018"/>
        <GradientStop Offset="1" Color="#E607100C"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="UpsGlassWarn" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#E61E180D"/>
        <GradientStop Offset="1" Color="#E6100C06"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="UpsGlassInfo" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#E615172A"/>
        <GradientStop Offset="1" Color="#E60A0B18"/>
    </LinearGradientBrush>

    <!-- Bevelled edges. The border is a gradient rather than a flat colour: lit along the top,
         falling to shadow at the bottom, so the card reads as a raised panel.

         Chosen over the glass sheen for two reasons. It speaks the same language as the toggle
         cap, which is already a moulded bevel, so the window has one vocabulary instead of two.
         And a border is one pixel by construction — it cannot develop the size-with-the-card
         problem the proportional sheen had, on any card, ever.

         The glass brushes above are kept and still used for the fill, so the two treatments
         compose: bevelled edge, glazed face. -->
    <!-- Diagonal, so the lit corner is top-LEFT and the shadowed one bottom-right — one light
         source, consistent with the card face and the toggle cap. A purely vertical bevel lights
         the whole top edge evenly, which reads as a printed line; lighting a corner reads as an
         object.

         Four stops rather than three: the hot highlight is held briefly at the start and the mid
         tone occupies most of the run, so the edge is defined all the way round. Glassmorphism
         guides typically fade the border to zero opacity mid-run, which works over vibrant
         photographic backdrops where the fill defines the card — over near-black slate the border
         IS the definition, so it stays visible throughout. -->
    <LinearGradientBrush x:Key="UpsBevelNeutral" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#93A6B8"/>
        <GradientStop Offset="0.12" Color="#63768A"/>
        <GradientStop Offset="0.55" Color="#3A4757"/>
        <GradientStop Offset="1"    Color="#1E262F"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="UpsBevelAccent" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#7FC6E2"/>
        <GradientStop Offset="0.12" Color="#4E9CBC"/>
        <GradientStop Offset="0.55" Color="#2C6580"/>
        <GradientStop Offset="1"    Color="#173846"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="UpsBevelGood" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#8CCFA3"/>
        <GradientStop Offset="0.12" Color="#5FA97A"/>
        <GradientStop Offset="0.55" Color="#3A7550"/>
        <GradientStop Offset="1"    Color="#1E402B"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="UpsBevelWarn" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#E0BC70"/>
        <GradientStop Offset="0.12" Color="#B99548"/>
        <GradientStop Offset="0.55" Color="#7E6329"/>
        <GradientStop Offset="1"    Color="#453516"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="UpsBevelInfo" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"    Color="#9C9CD0"/>
        <GradientStop Offset="0.12" Color="#7373A8"/>
        <GradientStop Offset="0.55" Color="#47477A"/>
        <GradientStop Offset="1"    Color="#272745"/>
    </LinearGradientBrush>

    <Style x:Key="UpsCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource UpsGlassNeutral}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UpsBevelNeutral}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <!-- Neutral and shallow. This is separation, not the bloom the toggles were told to drop:
             a card is one of three or four on a page rather than one of fifteen, the colour is
             black rather than a hue, and it signals depth rather than state. -->
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="9" ShadowDepth="2"
                                  Direction="270" Opacity="0.38"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Reference / capability -->
    <Style x:Key="UpsCardAccent" TargetType="Border" BasedOn="{StaticResource UpsCard}">
        <Setter Property="Background" Value="{StaticResource UpsGlassAccent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UpsBevelAccent}"/>
    </Style>

    <!-- Release notes, anything that reads as "new" -->
    <Style x:Key="UpsCardGood" TargetType="Border" BasedOn="{StaticResource UpsCard}">
        <Setter Property="Background" Value="{StaticResource UpsGlassGood}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UpsBevelGood}"/>
    </Style>

    <!-- Caveats, quirks, anything with a "but" in it -->
    <Style x:Key="UpsCardWarn" TargetType="Border" BasedOn="{StaticResource UpsCard}">
        <Setter Property="Background" Value="{StaticResource UpsGlassWarn}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UpsBevelWarn}"/>
    </Style>

    <!-- Credit, licensing, people -->
    <Style x:Key="UpsCardInfo" TargetType="Border" BasedOn="{StaticResource UpsCard}">
        <Setter Property="Background" Value="{StaticResource UpsGlassInfo}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UpsBevelInfo}"/>
    </Style>

    <!-- A card's own heading. Sits inside the box, so the box does not need a section bar too. -->
    <Style x:Key="UpsCardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource UpsText}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Bulleted line inside a card. -->
    <Style x:Key="UpsBullet" TargetType="TextBlock" BasedOn="{StaticResource UpsBody}">
        <Setter Property="Margin" Value="2,0,0,3"/>
    </Style>

    <!-- ================================================================================
         Toggle switch — a panel-mounted rocker, not a flat iOS pill.

         The track is a recessed groove: its gradient runs dark at the top so the lip reads as
         casting a shadow into the channel. The knob is the opposite, lit from above and dropping
         a shadow onto the groove, which is what makes it sit proud of the surface rather than
         printed on it. On, the groove lights from within and gains a faint bloom, the way an
         indicator behind a translucent panel would.

         Sized against the 12.5px label beside it: an 18px track is a shade taller than the text's
         line box, so the two read as one row. The earlier 21px version towered over the label.

         Keyed, never implicit. An implicit CheckBox style would replace whatever the Playnite
         theme sets for every checkbox in the window, including ones outside these pages.
         ================================================================================ -->

    <!-- Machined cap: a hot specular at the top edge falling to shadow underneath. The range is
         deliberately wide — anything subtler flattens out at 18px and the knob reads as a dot. -->
    <LinearGradientBrush x:Key="UpsKnobFace" StartPoint="0.3,0" EndPoint="0.7,1">
        <GradientStop Offset="0"    Color="#FFFFFF"/>
        <GradientStop Offset="0.30" Color="#E8EFF6"/>
        <GradientStop Offset="0.62" Color="#B2C0CE"/>
        <GradientStop Offset="1"    Color="#75838F"/>
    </LinearGradientBrush>

    <!-- Empty channel. Dark at the lip, opening out below. -->
    <LinearGradientBrush x:Key="UpsGrooveOff" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0"    Color="#0F151C"/>
        <GradientStop Offset="0.55" Color="#1E2733"/>
        <GradientStop Offset="1"    Color="#2C3843"/>
    </LinearGradientBrush>

    <!-- Brighter than the off groove by a wide margin, because with the bloom gone this fill is
         what carries the on state at a glance. -->
    <LinearGradientBrush x:Key="UpsGrooveOn" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0"    Color="#154759"/>
        <GradientStop Offset="0.55" Color="#1E7391"/>
        <GradientStop Offset="1"    Color="#3BACD1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="UpsOnRim" Color="#1F5F76"/>
    <SolidColorBrush x:Key="UpsLedOn" Color="#A7E8FF"/>

    <!-- Hover. Three surfaces move together — the cap face, its rim, and the hairline along the
         track's top lip — because any one of them alone is too quiet to notice at 24x13. The
         track's own fill is deliberately left alone: it carries the on/off state, and a hover
         that recoloured it would read as the setting having changed. -->
    <LinearGradientBrush x:Key="UpsKnobFaceHover" StartPoint="0.3,0" EndPoint="0.7,1">
        <GradientStop Offset="0"    Color="#FFFFFF"/>
        <GradientStop Offset="0.30" Color="#F6FAFE"/>
        <GradientStop Offset="0.62" Color="#D2DEEA"/>
        <GradientStop Offset="1"    Color="#94A3B2"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="UpsLipSheen" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0"   Color="#00FFFFFF"/>
        <GradientStop Offset="0.5" Color="#62FFFFFF"/>
        <GradientStop Offset="1"   Color="#00FFFFFF"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="UpsLipSheenHover" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0"   Color="#00FFFFFF"/>
        <GradientStop Offset="0.5" Color="#B8FFFFFF"/>
        <GradientStop Offset="1"   Color="#00FFFFFF"/>
    </LinearGradientBrush>

    <!-- Sub-option on state. A nested toggle only means anything while its parent is on, so it
         gets its own colour rather than repeating the parent's. Deep blue sits beside the cyan
         parent without leaving the cool family, and reads a stop or two quieter, which is what
         keeps a sub-option from looking like a second kind of primary. -->
    <LinearGradientBrush x:Key="UpsGrooveOnSub" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0"    Color="#16273F"/>
        <GradientStop Offset="0.55" Color="#22406B"/>
        <GradientStop Offset="1"    Color="#3A63A0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="UpsOnRimSub" Color="#1E355C"/>
    <SolidColorBrush x:Key="UpsLedOnSub" Color="#A8C6F0"/>

    <Style x:Key="UpsToggle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource UpsText}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <!-- SemiBold so the label separates from its hint by weight, not only by colour. -->
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,7,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- The template repurposes these three to carry the ON colours, so a derived style can
             recolour the switch without restating the whole template. The off groove is fixed,
             so Background and BorderBrush are free to mean "on". -->
        <Setter Property="Background" Value="{StaticResource UpsGrooveOn}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UpsOnRim}"/>
        <Setter Property="Tag" Value="{StaticResource UpsLedOn}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <!-- A Border takes one child, so the surfaces are siblings in a Grid and
                             stack in document order: groove, dark inset lip, lit hairline, cap.
                             SnapsToDevicePixels + UseLayoutRounding keep every edge on a whole
                             pixel — at 24x13 a half-pixel rim is a smudge. -->
                        <Grid Width="24" Height="13" VerticalAlignment="Center">

                            <Border x:Name="Track" CornerRadius="0"
                                    Background="{StaticResource UpsGrooveOff}"
                                    BorderBrush="#0B1015" BorderThickness="1"
                                    SnapsToDevicePixels="True" UseLayoutRounding="True"/>

                            <!-- Hard inset lip, zero blur. WPF has no inset shadow, so this is a
                                 solid band pinned under the top edge — which is all the CSS
                                 equivalent draws anyway, and it stays crisp at this size. -->
                            <Border x:Name="InsetLip" Height="2.5" VerticalAlignment="Top"
                                    Margin="1,1,1,0" IsHitTestVisible="False"
                                    Background="#20000000"/>

                            <!-- Hairline catching the light along the top lip. Sits above the
                                 inset band so the groove reads as an edge, not a gradient. -->
                            <Border x:Name="Lip" Height="1" VerticalAlignment="Top"
                                    Margin="2,0,2,0" IsHitTestVisible="False"
                                    Background="{StaticResource UpsLipSheen}"/>

                            <Border x:Name="Thumb" Width="12" Height="10" CornerRadius="0"
                                    Background="{StaticResource UpsKnobFace}"
                                    BorderBrush="#4B5764" BorderThickness="0.75"
                                    HorizontalAlignment="Left" Margin="1.5,0,0,0"
                                    SnapsToDevicePixels="True">
                                <!-- Nearly hard: 1px of blur is enough to separate the cap from
                                     the groove without the halo a page full of these would make. -->
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="1"
                                                      ShadowDepth="0.8" Direction="270" Opacity="0.4"/>
                                </Border.Effect>
                                <Grid>
                                    <!-- Moulded bevel: lit top edge, shaded bottom edge. -->
                                    <Border Height="1" VerticalAlignment="Top" Margin="1,0,1,0"
                                            Background="#69FFFFFF"/>
                                    <Border Height="1" VerticalAlignment="Bottom" Margin="1,0,1,0"
                                            Background="#56000000"/>
                                    <!-- Gloss over the upper 45% of the cap. -->
                                    <Border VerticalAlignment="Top" Height="4.5">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0" Color="#54FFFFFF"/>
                                                <GradientStop Offset="1" Color="#00FFFFFF"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <!-- Indicator sunk INTO the cap. This is where the on state
                                         gets its spark without any light spilling onto the page. -->
                                    <Ellipse x:Name="Led" Width="3" Height="3" Fill="#6B7885"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Opacity="0.45"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <ContentPresenter x:Name="Label"
                                          Margin="8,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background"
                                    Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Track" Property="BorderBrush"
                                    Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <!-- No bloom on the on state. A page carries a dozen or more of these,
                                 and a dozen soft green halos turn a list of settings into a
                                 smear. On reads from the fill and the knob's position, which are
                                 both hard-edged. It is also a dozen fewer blur passes. -->
                            <!-- The knob throws, it does not glide. Two reasons beyond taste: a
                                 real panel switch snaps, and a slide animation only runs on the
                                 transition INTO checked — so every toggle already on when the
                                 window opens would sit at the wrong end and then visibly jump
                                 into place. An alignment swap is correct the instant it renders. -->
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,1.5,0"/>
                            <Setter TargetName="Led" Property="Fill"
                                    Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Led" Property="Opacity" Value="1"/>
                        </Trigger>
                        <!-- After the IsChecked trigger, so on a lit switch the hover still wins
                             for the surfaces it touches. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Background" Value="{StaticResource UpsKnobFaceHover}"/>
                            <Setter TargetName="Thumb" Property="BorderBrush" Value="#A9BAC9"/>
                            <Setter TargetName="Lip" Property="Background" Value="{StaticResource UpsLipSheenHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.35"/>
                            <Setter TargetName="Label" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================================
         Radio button — the exclusive-choice sibling of the toggle.

         Stays circular where the toggle is square: the shape is the affordance, and a round well
         has meant "one of these" since physical panels. Same construction otherwise — recessed
         groove, bevelled rim, a lit indicator when selected — so the two read as one family.
         ================================================================================ -->
    <LinearGradientBrush x:Key="UpsWellFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0"   Color="#0E141A"/>
        <GradientStop Offset="0.6" Color="#1B232E"/>
        <GradientStop Offset="1"   Color="#28323D"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="UpsWellRim" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"   Color="#5A6A7A"/>
        <GradientStop Offset="0.5" Color="#2C3743"/>
        <GradientStop Offset="1"   Color="#141A21"/>
    </LinearGradientBrush>

    <Style x:Key="UpsRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource UpsText}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="14" Height="14" VerticalAlignment="Center">
                            <Ellipse x:Name="Well"
                                     Fill="{StaticResource UpsWellFace}"
                                     Stroke="{StaticResource UpsWellRim}" StrokeThickness="1"/>
                            <Ellipse x:Name="Dot" Width="6" Height="6"
                                     Fill="{StaticResource UpsAccent}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Opacity="0"/>
                        </Grid>
                        <ContentPresenter x:Name="Label" Margin="8,0,0,0"
                                          VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Well" Property="Stroke" Value="#8CA0B4"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Well" Property="Opacity" Value="0.35"/>
                            <Setter TargetName="Label" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text input. A recess rather than a raised panel — the inverse of the button, which is what
         an input should read as. Left unstyled it renders as WPF's stark white box, which on this
         ground is the brightest thing on the page by a wide margin and pulls the eye off the
         setting it belongs to. -->
    <Style x:Key="UpsTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource UpsText}"/>
        <Setter Property="CaretBrush" Value="{StaticResource UpsAccent}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource UpsAccent}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="7,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource UpsWellFace}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UpsWellRim}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Well" CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Well" Property="BorderBrush" Value="{StaticResource UpsAccent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Well" Property="BorderBrush" Value="{StaticResource UpsStrokeHi}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Well" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================================
         Button. Same bevelled panel as the cards, at control scale.
         ================================================================================ -->
    <LinearGradientBrush x:Key="UpsButtonFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#2B3644"/>
        <GradientStop Offset="1" Color="#1D2530"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="UpsButtonFaceHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#384656"/>
        <GradientStop Offset="1" Color="#26303C"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="UpsButtonRim" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0"   Color="#7C8EA0"/>
        <GradientStop Offset="0.5" Color="#3C4959"/>
        <GradientStop Offset="1"   Color="#212934"/>
    </LinearGradientBrush>

    <Style x:Key="UpsButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource UpsText}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" CornerRadius="4"
                            Background="{StaticResource UpsButtonFace}"
                            BorderBrush="{StaticResource UpsButtonRim}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource UpsButtonFaceHover}"/>
                        </Trigger>
                        <!-- Pressed inverts the bevel, so the panel reads as pushed in. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource UpsWellFace}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A nested toggle: one that only means anything while its parent is on. Indented, and lit
         violet rather than cyan so a glance down the page separates the sub-options from the
         settings they hang off. -->
    <Style x:Key="UpsToggleChild" TargetType="CheckBox" BasedOn="{StaticResource UpsToggle}">
        <Setter Property="Margin" Value="24,7,0,0"/>
        <Setter Property="Background" Value="{StaticResource UpsGrooveOnSub}"/>
        <Setter Property="BorderBrush" Value="{StaticResource UpsOnRimSub}"/>
        <Setter Property="Tag" Value="{StaticResource UpsLedOnSub}"/>
    </Style>

