<UserControl x:Class="UniPlaySong.Controls.Settings.ExperimentalPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UniPlaySong"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UniPlaySong;component/Controls/Settings/SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <!-- Music Library Stats -->
            <TextBlock Text="Music Library" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- Row 1: Core metrics -->
            <UniformGrid Columns="4" Margin="0,0,0,5">
                <Border Background="#1A2636" BorderBrush="#2A4A6A" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,5,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding StatsTotalSongs}" FontSize="14" FontWeight="Bold" Foreground="#88BBDD" HorizontalAlignment="Center"/>
                        <TextBlock Text="Total Songs" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A2636" BorderBrush="#2A4A6A" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,5,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding StatsTotalSize}" FontSize="14" FontWeight="Bold" Foreground="#88BBDD" HorizontalAlignment="Center"/>
                        <TextBlock Text="Total Size of Songs" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A2636" BorderBrush="#2A4A6A" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,5,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding StatsGamesWithMusic}" FontSize="14" FontWeight="Bold" Foreground="#88BBDD" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="Games in Library with Music" FontSize="10" Foreground="Gray" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A2636" BorderBrush="#2A4A6A" BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding StatsAvgSongsPerGame}" FontSize="14" FontWeight="Bold" Foreground="#88BBDD" HorizontalAlignment="Center"/>
                        <TextBlock Text="Average #Songs / Game" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Row 2: Audio metrics (populated by background scan) -->
            <UniformGrid Columns="3" Margin="0,0,0,10">
                <Border Background="#1A2636" BorderBrush="#2A4A6A" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,5,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding StatsAvgSongLength}" FontSize="14" FontWeight="Bold" Foreground="#88BBDD" HorizontalAlignment="Center"/>
                        <TextBlock Text="Avg Song Length" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A2636" BorderBrush="#2A4A6A" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,5,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding StatsTotalPlaytime}" FontSize="14" FontWeight="Bold" Foreground="#88BBDD" HorizontalAlignment="Center"/>
                        <TextBlock Text="Total Playtime" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#1A2636" BorderBrush="#2A4A6A" BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding StatsId3Coverage}" FontSize="14" FontWeight="Bold" Foreground="#88BBDD" HorizontalAlignment="Center"/>
                        <TextBlock Text="Songs With ID3 Tags" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Top Games by Song Count -->
            <Border Background="#1A2636" BorderBrush="#2A4A6A" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Top Games by Song Count" FontSize="11" FontWeight="SemiBold" Foreground="#88BBDD" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding StatsTopGames}" FontSize="11" Foreground="#6699AA" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Song Format Distribution -->
            <Border Background="#1A2636" BorderBrush="#2A4A6A" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Song Format Distribution" FontSize="11" FontWeight="SemiBold" Foreground="#88BBDD" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding StatsFormatBreakdown}" FontSize="11" Foreground="#6699AA" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Song Bitrate Distribution -->
            <Border Background="#1A2636" BorderBrush="#2A4A6A" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Song Bitrate Distribution" FontSize="11" FontWeight="SemiBold" Foreground="#88BBDD" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding StatsBitrateDistribution}" FontSize="11" Foreground="#6699AA" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Reducible Track Size (teal/cyan accent — actionable insight) -->
            <Border Background="#0F2A2A" BorderBrush="#2D8B8B" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Reducible Track Size" FontSize="11" FontWeight="SemiBold" Foreground="#5ECECE" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding StatsReducibleSpace}" FontSize="11" Foreground="#4AABAB" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Experimental Features" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
            <Border Background="#3A2A00" BorderBrush="#CC8800" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,5,0,20">
                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#FFCC66">
                    <Run FontWeight="SemiBold">Warning:</Run>
                    <Run Text=" These features are experimental and under active development. They may not work correctly, cause minor audio glitches, or behave unexpectedly. They may be changed or removed in future versions. Enable at your own discretion."/>
                </TextBlock>
            </Border>

            <!-- Release Audio When Idle (issue #81 — moved from General tab in v1.5.4) -->
            <TextBlock Text="Release Audio When Idle" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,8">
                <TextBlock Text="Release after: " VerticalAlignment="Center" Width="100"/>
                <TextBlock Text="{Binding Settings.IdleAudioDeviceTeardownMinutes}"
                           VerticalAlignment="Center"
                           Width="25"
                           Margin="0,0,3,0"/>
                <TextBlock Text="min" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider Minimum="0" Maximum="60"
                        Value="{Binding Settings.IdleAudioDeviceTeardownMinutes}"
                        Width="200"
                        IsSnapToTickEnabled="True"
                        SmallChange="1"
                        LargeChange="5"
                        TickFrequency="1"
                        TickPlacement="None"
                        AutoToolTipPlacement="TopLeft"/>
            </StackPanel>
            <TextBlock Text="Releases UniPlaySong's audio device after this many minutes of no audible music (paused or stopped), so Windows can sleep. 0 disables idle release. UniPlaySong also releases its audio device immediately when you lock the PC or it suspends (regardless of this setting)."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,5"/>
            <TextBlock Text="&#x26A0; Experimental: still being ironed out — behavior may change."
                       FontSize="11"
                       Foreground="Orange"
                       TextWrapping="Wrap"
                       Margin="20,0,0,15"/>

            <!-- Audio Buffer Size (v1.7.2) -->
            <TextBlock Text="Audio Buffer Size" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,8">
                <TextBlock Text="Buffer: " VerticalAlignment="Center" Width="100"/>
                <ComboBox ItemsSource="{Binding AudioBufferOptions}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Samples"
                          SelectedValue="{Binding Settings.AudioBufferSamples}"
                          Width="340"/>
            </StackPanel>
            <TextBlock Text="How much audio UniPlaySong prepares ahead of the speakers. A smaller buffer starts sounds sooner — most noticeable on short notification sounds like achievement and controller dings — but gives the audio thread less headroom, so a busy machine may crackle or drop out. Increase it if you hear stuttering; leave it at 2048 if playback is fine."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,5"/>
            <TextBlock Text="&#x26A0; Takes effect after restarting Playnite — the buffer is fixed when the audio device opens."
                       FontSize="11"
                       Foreground="Orange"
                       TextWrapping="Wrap"
                       Margin="20,0,0,15"/>

            <!-- Download Notification Sound -->
            <TextBlock Text="Download Notifications" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <CheckBox Content="Play sound when downloads complete"
                      IsChecked="{Binding Settings.PlaySoundOnDownloadComplete}"
                      Margin="0,5,0,5"/>
            <TextBlock Text="Briefly pauses music and plays a system notification sound when any music download finishes (single game, batch, auto-download, Download From URL)."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,10"/>

            <!-- Song Progress Indicator -->
            <TextBlock Text="Song Progress Indicator" FontSize="14" FontWeight="SemiBold" Margin="0,15,0,10"/>
            <CheckBox Content="Show song progress bar (Desktop mode)"
                      IsChecked="{Binding Settings.ShowProgressBar}"
                      Command="{Binding SetRestartRequired}"
                      CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                      Margin="0,5,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="20,5,0,5"
                        IsEnabled="{Binding Settings.ShowProgressBar}">
                <TextBlock Text="Position:" VerticalAlignment="Center" FontSize="11" Foreground="Gray"/>
                <ComboBox SelectedIndex="{Binding Settings.ProgressBarPosition, Converter={StaticResource ProgressBarPositionConverter}}"
                          Margin="8,0,0,0" Width="170">
                    <ComboBoxItem Content="After skip button"/>
                    <ComboBoxItem Content="After visualizer"/>
                    <ComboBoxItem Content="After now playing"/>
                    <ComboBoxItem Content="Below now playing"/>
                </ComboBox>
            </StackPanel>
            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="20,0,0,10">
                <Run Foreground="Gray">Thin bar showing song playback position.</Run>
                <Run Foreground="Orange">Requires Playnite restart to take effect.</Run>
            </TextBlock>

            <!-- Peak Meter -->
            <Separator Margin="0,15"/>
            <TextBlock Text="Peak Meter (VU Display)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <CheckBox Content="Show Peak Meter in top panel"
                      IsChecked="{Binding Settings.ShowPeakMeter}"
                      Margin="0,5,0,5"/>
            <TextBlock Text="Real-time L/R audio level meter with green/yellow/red LED-style bars. Requires NAudio player (auto-enabled). May impact performance on some systems."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,5"/>
            <TextBlock Text="&#x26A0; Experimental: This feature may cause lag on some systems."
                       FontSize="11"
                       Foreground="Orange"
                       TextWrapping="Wrap"
                       Margin="20,0,0,10"/>

            <!-- Media Key Control -->
            <Separator Margin="0,15"/>
            <TextBlock Text="Media Key Control" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>

            <CheckBox Content="Control music with keyboard media keys"
                      IsChecked="{Binding Settings.EnableMediaKeyControl}"
                      Margin="0,5,0,5"/>
            <TextBlock Text="Control music playback using your keyboard's media keys (Play/Pause, Next Track, etc) if your keyboard has them. If another application (e.g. Spotify) has already claimed the media keys, some keys may not register. Requires Playnite restart to take effect."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,10"/>

            <!-- NAudio Fade Curve Tuning -->
            <Separator Margin="0,15"/>
            <TextBlock Text="NAudio Fade Curves" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBlock Text="Only applies when Live Effects or Visualizer is enabled (NAudio pipeline)"
                       FontSize="11" FontStyle="Italic" Foreground="#90A8A0" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                <TextBlock Text="Fade-in curve:" VerticalAlignment="Center" Width="110"/>
                <ComboBox SelectedIndex="{Binding Settings.NaudioFadeInCurve, Converter={StaticResource FadeCurveTypeConverter}}"
                          Width="150">
                    <ComboBoxItem Content="Linear"/>
                    <ComboBoxItem Content="Quadratic"/>
                    <ComboBoxItem Content="Cubic"/>
                    <ComboBoxItem Content="S-Curve"/>
                    <ComboBoxItem Content="Logarithmic"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                <TextBlock Text="Fade-out curve:" VerticalAlignment="Center" Width="110"/>
                <ComboBox SelectedIndex="{Binding Settings.NaudioFadeOutCurve, Converter={StaticResource FadeCurveTypeConverter}}"
                          Width="150">
                    <ComboBoxItem Content="Linear"/>
                    <ComboBoxItem Content="Quadratic"/>
                    <ComboBoxItem Content="Cubic"/>
                    <ComboBoxItem Content="S-Curve"/>
                    <ComboBoxItem Content="Logarithmic"/>
                </ComboBox>
            </StackPanel>

            <TextBlock Text="Linear: constant rate. Quadratic: moderate curve. Cubic: aggressive perceptual decay (default fade-out). S-Curve: gentle start/end, fast middle. Logarithmic: fast initial change, slow tail."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,10"/>

            <!-- Icon Glow -->
            <Separator Margin="0,15"/>
            <Grid Margin="0,0,0,5">
                <TextBlock Text="Icon Glow" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="Reset Icon Glow" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="ResetIconGlow_Click" Padding="8,3" FontSize="11"/>
            </Grid>
            <CheckBox Content="Enable Icon Glow (Desktop only)"
                      IsChecked="{Binding Settings.EnableIconGlow}"
                      Margin="0,12,0,4"
                      ToolTip="Adds a pulsating colored border around the selected game's icon. Color is extracted from the game's icon art. Audio-reactive when Live Effects/Visualizer is enabled." />
            <DockPanel Margin="20,8,0,8" IsEnabled="{Binding Settings.EnableIconGlow}">
                <TextBlock Text="Preset:" VerticalAlignment="Center" Width="130"/>
                <ComboBox SelectedValue="{Binding Settings.IconGlowPreset}"
                          SelectedValuePath="Tag"
                          Width="160" HorizontalAlignment="Left">
                    <ComboBoxItem Content="Custom" Tag="{x:Static local:IconGlowPreset.Custom}"/>
                    <!-- Audio-reactive presets (most reactive first) -->
                    <ComboBoxItem Content="Reactive" Tag="{x:Static local:IconGlowPreset.Reactive}"/>
                    <ComboBoxItem Content="Pulse" Tag="{x:Static local:IconGlowPreset.Pulse}"/>
                    <ComboBoxItem Content="Bass Punch" Tag="{x:Static local:IconGlowPreset.BassPunch}"/>
                    <ComboBoxItem Content="Neon" Tag="{x:Static local:IconGlowPreset.Neon}"/>
                    <ComboBoxItem Content="Mellow" Tag="{x:Static local:IconGlowPreset.Mellow}"/>
                    <!-- Visual-only presets -->
                    <ComboBoxItem Content="Ambient" Tag="{x:Static local:IconGlowPreset.Ambient}"/>
                    <ComboBoxItem Content="Subtle" Tag="{x:Static local:IconGlowPreset.Subtle}"/>
                    <ComboBoxItem Content="Sharp Static" Tag="{x:Static local:IconGlowPreset.SharpStatic}"/>
                    <ComboBoxItem Content="Sharp Bright" Tag="{x:Static local:IconGlowPreset.SharpBright}"/>
                    <ComboBoxItem Content="Sharp Vivid" Tag="{x:Static local:IconGlowPreset.SharpVivid}"/>
                    <ComboBoxItem Content="Sharp Warm" Tag="{x:Static local:IconGlowPreset.SharpWarm}"/>
                    <ComboBoxItem Content="Sharp Cool" Tag="{x:Static local:IconGlowPreset.SharpCool}"/>
                    <ComboBoxItem Content="Sharp Pulse" Tag="{x:Static local:IconGlowPreset.SharpPulse}"/>
                </ComboBox>
            </DockPanel>
            <StackPanel IsEnabled="{Binding Settings.IconGlowSlidersEnabled}">
            <CheckBox Content="Enable pulse animation (SDL2 fallback)"
                      IsChecked="{Binding Settings.EnableIconGlowPulse}"
                      Margin="20,0,0,4"
                      IsEnabled="{Binding Settings.EnableIconGlow}"
                      ToolTip="When Live Effects/Visualizer is off, the glow pulses at a gentle fixed rate. Disable for a static glow." />
            <CheckBox Content="Enable slow spin"
                      IsChecked="{Binding Settings.EnableIconGlowSpin}"
                      Margin="20,0,0,4"
                      IsEnabled="{Binding Settings.EnableIconGlow}"
                      ToolTip="Slowly rotates the glow image around the icon. Works with both audio-reactive and static glow." />
            <CheckBox Content="Beat-reactive spin acceleration"
                      IsChecked="{Binding Settings.EnableIconGlowSpinAcceleration}"
                      Margin="40,0,0,4"
                      IsEnabled="{Binding Settings.EnableIconGlowSpin}"
                      ToolTip="When enabled, the glow spin speeds up on audio beats." />
            <DockPanel Margin="40,4,0,4" IsEnabled="{Binding Settings.EnableIconGlowSpin}">
                <TextBlock Text="Spin Speed (sec/turn):" VerticalAlignment="Center" Width="150"/>
                <TextBlock Text="{Binding Settings.IconGlowSpinSpeed, StringFormat='{}{0:F0}s'}"
                           VerticalAlignment="Center" Width="30" TextAlignment="Center" DockPanel.Dock="Right"/>
                <Slider Value="{Binding Settings.IconGlowSpinSpeed}"
                        Minimum="5" Maximum="60"
                        TickFrequency="5" IsSnapToTickEnabled="True"
                        ToolTip="Seconds per full rotation. Higher = slower spin. Default: 20s." />
            </DockPanel>
            <DockPanel Margin="20,8,0,4" IsEnabled="{Binding Settings.EnableIconGlow}">
                <TextBlock Text="Glow Intensity:" VerticalAlignment="Center" Width="130"/>
                <TextBlock Text="{Binding Settings.IconGlowIntensity, StringFormat='{}{0:F1}'}"
                           VerticalAlignment="Center" Width="30" TextAlignment="Center" DockPanel.Dock="Right"/>
                <Slider Value="{Binding Settings.IconGlowIntensity}"
                        Minimum="0.5" Maximum="3.0"
                        TickFrequency="0.1" IsSnapToTickEnabled="True"
                        ToolTip="Controls glow brightness. Higher values produce a brighter, more vivid glow." />
            </DockPanel>
            <DockPanel Margin="20,4,0,4" IsEnabled="{Binding Settings.EnableIconGlow}">
                <TextBlock Text="Glow Size:" VerticalAlignment="Center" Width="130"/>
                <TextBlock Text="{Binding Settings.IconGlowSize, StringFormat='{}{0:F1}'}"
                           VerticalAlignment="Center" Width="30" TextAlignment="Center" DockPanel.Dock="Right"/>
                <Slider Value="{Binding Settings.IconGlowSize}"
                        Minimum="2.0" Maximum="12.0"
                        TickFrequency="0.5" IsSnapToTickEnabled="True"
                        ToolTip="How far the glow extends from the icon. Higher = wider, softer glow." />
            </DockPanel>
            <DockPanel Margin="20,4,0,4" IsEnabled="{Binding Settings.EnableIconGlow}">
                <TextBlock Text="Pulse Speed (sec):" VerticalAlignment="Center" Width="130"/>
                <TextBlock Text="{Binding Settings.IconGlowPulseSpeed, StringFormat='{}{0:F1}'}"
                           VerticalAlignment="Center" Width="30" TextAlignment="Center" DockPanel.Dock="Right"/>
                <Slider Value="{Binding Settings.IconGlowPulseSpeed}"
                        Minimum="0.5" Maximum="4.0"
                        TickFrequency="0.1" IsSnapToTickEnabled="True"
                        ToolTip="SDL2 fallback pulse cycle duration. Lower = faster pulse. Only used when Live Effects/Visualizer is off." />
            </DockPanel>
            <DockPanel Margin="20,4,0,4" IsEnabled="{Binding Settings.EnableIconGlow}">
                <TextBlock Text="Audio Sensitivity:" VerticalAlignment="Center" Width="130"/>
                <TextBlock Text="{Binding Settings.IconGlowAudioSensitivity, StringFormat='{}{0:F1}'}"
                           VerticalAlignment="Center" Width="30" TextAlignment="Center" DockPanel.Dock="Right"/>
                <Slider Value="{Binding Settings.IconGlowAudioSensitivity}"
                        Minimum="0.5" Maximum="4.0"
                        TickFrequency="0.1" IsSnapToTickEnabled="True"
                        ToolTip="Audio reactivity multiplier. Higher = more responsive to music peaks. Only used with Live Effects/Visualizer." />
            </DockPanel>
            </StackPanel>

            <!-- List Icon Glow -->
            <Separator Margin="0,15"/>
            <TextBlock Text="List Icon Glow" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <CheckBox Content="Enable List Icon Glow (Desktop only)"
                      IsChecked="{Binding Settings.EnableListIconGlow}"
                      Margin="0,12,0,4"
                      ToolTip="Highlights game icons in the list/grid view. Hover shows a colored shadow, selected game gets a full rendered glow. Independent from the Icon Glow visual reactor." />
            <CheckBox Content="Subtle glow (softer effect)"
                      IsChecked="{Binding Settings.SubtleListGlow}"
                      Margin="20,0,0,4"
                      IsEnabled="{Binding Settings.EnableListIconGlow}"
                      ToolTip="Uses a softer, less intense glow on the selected game's list icon. Disable for the full-strength rendered glow." />

            <!-- Sidebar Glow -->
            <Separator Margin="0,15"/>
            <TextBlock Text="Sidebar Glow" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>

            <CheckBox Content="Enable Audio-Reactive Sidebar Background (Desktop only)"
                      IsChecked="{Binding Settings.EnableSidebarGlow}"
                      Margin="0,5,0,5"/>
            <TextBlock Text="Colors the sidebar icon strip background based on the selected game's icon. Brightness shifts with audio energy when music is playing with Live Effects enabled."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,5"/>

            <StackPanel Orientation="Horizontal" Margin="20,5,0,5"
                        IsEnabled="{Binding Settings.EnableSidebarGlow}">
                <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Width="160"
                          SelectedIndex="{Binding Settings.SidebarGlowMode, Converter={StaticResource SidebarGlowModeConverter}}"
                          IsEnabled="{Binding Settings.EnableSidebarGlow}">
                    <ComboBoxItem Content="Breathing"/>
                    <ComboBoxItem Content="Glow Bars"/>
                    <ComboBoxItem Content="Plasma Grid"/>
                    <ComboBoxItem Content="Plasma Tinted"/>
                    <ComboBoxItem Content="Pixel Grid"/>
                    <ComboBoxItem Content="Rain Drops"/>
                    <ComboBoxItem Content="Waveform"/>
                    <ComboBoxItem Content="Fire"/>
                    <ComboBoxItem Content="Starfield"/>
                    <ComboBoxItem Content="Ripple"/>
                    <ComboBoxItem Content="Aurora"/>
                    <ComboBoxItem Content="Heartbeat"/>
                    <ComboBoxItem Content="Waterfall"/>
                    <ComboBoxItem Content="Nebula"/>
                    <ComboBoxItem Content="DNA Helix"/>
                    <ComboBoxItem Content="DNA Helix Bloom"/>
                    <ComboBoxItem Content="Matrix"/>
                    <ComboBoxItem Content="Laser"/>
                    <ComboBoxItem Content="Pulse Waves"/>
                    <ComboBoxItem Content="Voronoi"/>
                    <ComboBoxItem Content="Equalizer Grid"/>
                    <ComboBoxItem Content="Snow"/>
                    <ComboBoxItem Content="Neon Line"/>
                </ComboBox>
            </StackPanel>

            <!-- Auto-launch Spotify (Experimental) -->
            <Separator Margin="0,15"/>
            <TextBlock Text="Auto-launch Spotify (Experimental)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <CheckBox Content="Auto-launch Spotify on startup if not running"
                      IsChecked="{Binding Settings.AutoLaunchSpotifyOnStartup}"
                      Margin="0,5,0,0"/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="20,0,0,8"
                       Text="When Spotify is your Radio Mode or Default Music source and the Spotify desktop app isn't running, UniPlaySong opens it on startup so music can begin. Only acts when Spotify is your active source. Media controls need Spotify running."/>
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0"
                        IsEnabled="{Binding Settings.AutoLaunchSpotifyOnStartup}">
                <TextBlock Text="Spotify path (optional): " VerticalAlignment="Center"/>
                <TextBox Text="{Binding Settings.SpotifyExePath, UpdateSourceTrigger=PropertyChanged}"
                         Width="300" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="Browse..." Command="{Binding BrowseSpotifyExeCommand}" Padding="10,4"/>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="20,3,0,0"
                       Text="Leave empty for standard installs (auto-detected at %APPDATA%\Spotify\Spotify.exe). For Microsoft Store or custom installs, point this at Spotify.exe or its shortcut (.lnk)."/>

            <!-- Music Dashboard -->
            <Separator Margin="0,15"/>
            <TextBlock Text="Music Dashboard" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>

            <CheckBox Content="Enable Music Dashboard sidebar panel (Desktop only)"
                      IsChecked="{Binding Settings.ShowMusicDashboard}"
                      Margin="0,5,0,5"/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="20,0,0,10">
                A dedicated sidebar panel with spectrum visualizer, now playing display, playback controls, song list for the selected game, and music library stats.
            </TextBlock>

        </StackPanel>
    </ScrollViewer>
</UserControl>
