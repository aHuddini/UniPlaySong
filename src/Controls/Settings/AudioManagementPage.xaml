<UserControl x:Class="UniPlaySong.Controls.Settings.AudioManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UniPlaySong"
             xmlns:ups="clr-namespace:UniPlaySong.Controls.Settings"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ups:SharedResourceDictionary Source="pack://application:,,,/UniPlaySong;component/Controls/Settings/SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- A row: the button on the left, its description filling the rest and wrapping (a horizontal StackPanel
                 gives text unlimited width, so it never wrapped and ran off the page) -->
            <Style x:Key="ActionRow" TargetType="DockPanel">
                <Setter Property="Margin" Value="0,10"/>
                <Setter Property="LastChildFill" Value="True"/>
            </Style>
            <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource UpsButton}">
                <Setter Property="Width" Value="220"/>
                <Setter Property="Margin" Value="0,0,16,0"/>
                <Setter Property="DockPanel.Dock" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <!-- The description beside a button. UpsHint is made for text under a toggle (32 px indent, 12 px gap below),
                 which here pushed the text above the button's centre and far from it -->
            <Style x:Key="ActionText" TargetType="TextBlock" BasedOn="{StaticResource UpsHint}">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="ActionDanger" TargetType="TextBlock" BasedOn="{StaticResource UpsDangerNote}">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource UpsPage}">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">

            <TextBlock Text="Audio Management" Style="{StaticResource UpsPageTitle}"/>
            <TextBlock Style="{StaticResource UpsPageSubtitle}" Text="Run an operation across the whole library, or clean up what is on disk."/>

            <Expander Style="{StaticResource UpsSection}">
                <Expander.Header>
                    <TextBlock ups:TrackedCaps.Text="Bulk Actions" Style="{StaticResource UpsSectionTitle}"/>
                </Expander.Header>
                <StackPanel>
                    <DockPanel Style="{StaticResource ActionRow}" Margin="0,5,0,10">
                        <Button Style="{StaticResource ActionButton}" Content="Normalize All Music Files"
                                Command="{Binding NormalizeAllMusicCommand}"/>
                        <TextBlock Text="Normalize all music in your library to consistent volume. Uses your normalization settings in Audio Editing page."
                                   Style="{StaticResource ActionText}"/>
                    </DockPanel>

                    <DockPanel Style="{StaticResource ActionRow}">
                        <Button Style="{StaticResource ActionButton}" Content="Trim Silence - All Files"
                                Command="{Binding TrimAllMusicCommand}"/>
                        <TextBlock Text="Remove leading silence from all music files."
                                   Style="{StaticResource ActionText}"/>
                    </DockPanel>

                    <DockPanel Style="{StaticResource ActionRow}">
                        <Button Style="{StaticResource ActionButton}" Content="Create Folders for All Games"
                                Command="{Binding CreateMissingMusicFoldersCommand}"/>
                        <TextBlock Text="Create a music folder for every game in your library that doesn't have one yet."
                                   Style="{StaticResource ActionText}"/>
                    </DockPanel>
                </StackPanel>
            </Expander>

            <Expander Style="{StaticResource UpsSection}">
                <Expander.Header>
                    <TextBlock ups:TrackedCaps.Text="File Management" Style="{StaticResource UpsSectionTitle}"/>
                </Expander.Header>
                <StackPanel>
                    <DockPanel Style="{StaticResource ActionRow}" Margin="0,5,0,10">
                        <Button Style="{StaticResource ActionButton}" Content="Open Game Index"
                                Command="{Binding OpenGameIndexCommand}"/>
                        <TextBlock Text="Open the game index listing all games with music folders and their IDs."
                                   Style="{StaticResource ActionText}"/>
                    </DockPanel>

                    <DockPanel Style="{StaticResource ActionRow}">
                        <Button Style="{StaticResource ActionButton}" Content="Open Preserved Folder"
                                Command="{Binding OpenPreservedOriginalsFolderCommand}"/>
                        <TextBlock Text="Open the folder containing backup copies of original files."
                                   Style="{StaticResource ActionText}"/>
                    </DockPanel>

                    <DockPanel Style="{StaticResource ActionRow}">
                        <Button Style="{StaticResource ActionButton}" Content="Restore Original Files"
                                Command="{Binding RestoreNormalizedFilesCommand}"/>
                        <TextBlock Text="Restore originals and delete normalized/trimmed versions."
                                   Style="{StaticResource ActionText}"/>
                    </DockPanel>

                    <DockPanel Style="{StaticResource ActionRow}">
                        <Button Style="{StaticResource ActionButton}" Content="Delete Preserved Originals"
                                Command="{Binding DeletePreservedOriginalsCommand}"/>
                        <TextBlock Text="Permanently delete all preserved originals to free disk space."
                                   Style="{StaticResource ActionDanger}"/>
                    </DockPanel>
                </StackPanel>
            </Expander>

            <Expander Style="{StaticResource UpsSection}">
                <Expander.Header>
                    <TextBlock ups:TrackedCaps.Text="Diagnostics" Style="{StaticResource UpsSectionTitle}"/>
                </Expander.Header>
                <StackPanel>
                    <DockPanel Style="{StaticResource ActionRow}" Margin="0,5,0,10">
                        <Button Style="{StaticResource ActionButton}" Content="Find Songs Not Normalized"
                                Command="{Binding FindSongsNotNormalizedCommand}"/>
                        <TextBlock Text="Lists the songs that haven't been normalized yet, such as ones you added yourself, and offers to normalize just those."
                                   Style="{StaticResource ActionText}"/>
                    </DockPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
