<UserControl x:Class="UniPlaySong.Controls.Settings.DebugPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UniPlaySong"
             xmlns:ups="clr-namespace:UniPlaySong.Controls.Settings"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UniPlaySong;component/Controls/Settings/SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource UpsPage}">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Text="Debug" Style="{StaticResource UpsPageTitle}"/>
            <TextBlock Style="{StaticResource UpsPageSubtitle}" Text="Logging, for when something needs reporting."/>

            <CheckBox Style="{StaticResource UpsToggle}" Content="Enable Debug Logging"
                      IsChecked="{Binding Settings.EnableDebugLogging}"
                      Margin="0,5"/>
            <TextBlock Text="When enabled, writes detailed debug information to UniPlaySong.log in the extension folder. Disable for normal use to reduce log file size."
                       Style="{StaticResource UpsHint}"
                       TextWrapping="Wrap"
                       Margin="20,0,0,10"/>

            <Button Style="{StaticResource UpsButton}" Content="Open Log Folder"
                    Width="160"
                    Margin="0,5,0,15"
                    HorizontalAlignment="Left"
                    Command="{Binding OpenLogFolderCommand}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>