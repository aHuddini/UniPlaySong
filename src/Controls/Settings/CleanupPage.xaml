<UserControl x:Class="UniPlaySong.Controls.Settings.CleanupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UniPlaySong"
             xmlns:ups="clr-namespace:UniPlaySong.Controls.Settings"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UniPlaySong;component/Controls/Settings/SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer Style="{StaticResource UpsPage}">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Cleanup &amp; Reset" Style="{StaticResource UpsPageTitle}"/>
            <TextBlock Text="Reset UniPlaySong settings and remove all downloaded content." Style="{StaticResource UpsPageSubtitle}"/>

            <!-- Warning Banner -->
            <Border Style="{StaticResource UpsCardDanger}" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="WARNING: These actions cannot be undone!"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#FF6666"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="Factory Reset will permanently delete all downloaded music files, preserved originals, and reset all settings to their defaults. Make sure you have backups if needed."
                               FontSize="11"
                               Foreground="#FFAAAA"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Current Storage Info -->
            <Border Style="{StaticResource UpsCard}" CornerRadius="4" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <Border Style="{StaticResource UpsSectionBar}"><TextBlock ups:TrackedCaps.Text="Current Storage Usage" Style="{StaticResource UpsSectionTitle}"/></Border>
                    <TextBlock Text="{Binding CleanupStorageInfo}"
                               Style="{StaticResource UpsHint}"
                               TextWrapping="Wrap"/>
                    <Button Style="{StaticResource UpsButton}" Content="Refresh"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Padding="10,5"
                            Command="{Binding RefreshCleanupStorageInfoCommand}"/>
                </StackPanel>
            </Border>

            <!-- Destructive actions, collapsed so they are not the first thing a
                 user reaches for. Reset Settings and Factory Reset stay expanded
                 below: they are the recovery path, not routine maintenance. -->
            <Expander Style="{StaticResource UpsSection}" IsExpanded="False">
                <Expander.Header>
                    <TextBlock ups:TrackedCaps.Text="Delete Actions" Style="{StaticResource UpsSectionTitle}"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">
                <!-- Delete All Music -->
                <StackPanel Margin="0,0,0,20">
                    <Border Style="{StaticResource UpsSectionBar}"><TextBlock ups:TrackedCaps.Text="Delete All Music" Style="{StaticResource UpsSectionTitle}"/></Border>
                    <TextBlock Text="Removes all downloaded music files and game folders. Settings will be preserved."
                               Style="{StaticResource UpsHint}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <Button Style="{StaticResource UpsButton}" Content="Delete All Music Files"
                            Command="{Binding DeleteAllMusicCommand}"
                            Padding="15,8"
                            HorizontalAlignment="Left"
                            Background="#882222"
                            Foreground="White"/>
                </StackPanel>
    
                <!-- Delete Long Songs -->
                <StackPanel Margin="0,0,0,20">
                    <Border Style="{StaticResource UpsSectionBar}"><TextBlock ups:TrackedCaps.Text="Delete Long Songs" Style="{StaticResource UpsSectionTitle}"/></Border>
                    <TextBlock Text="Scans your music library and deletes songs longer than 10 minutes. Useful for removing accidentally downloaded full albums, podcasts, or corrupted files that break bulk operations."
                               Style="{StaticResource UpsHint}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <Button Style="{StaticResource UpsButton}" Content="Delete Songs &gt; 10 Minutes"
                            Command="{Binding DeleteLongSongsCommand}"
                            Padding="15,8"
                            HorizontalAlignment="Left"
                            Background="#664422"
                            Foreground="White"/>
                </StackPanel>
                </StackPanel>
            </Expander>

            <Expander Style="{StaticResource UpsSection}" IsExpanded="False">
                <Expander.Header>
                    <TextBlock ups:TrackedCaps.Text="Cleanup" Style="{StaticResource UpsSectionTitle}"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">
                <!-- Clean Up Orphaned Music -->
                <StackPanel Margin="0,0,0,20">
                    <Border Style="{StaticResource UpsSectionBar}"><TextBlock ups:TrackedCaps.Text="Clean Up Orphaned Music" Style="{StaticResource UpsSectionTitle}"/></Border>
                    <TextBlock Text="Scans for music folders belonging to games that are no longer in your Playnite library and removes them."
                               Style="{StaticResource UpsHint}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <CheckBox Style="{StaticResource UpsToggle}" Content="Automatically delete music when games are removed from library"
                              IsChecked="{Binding Settings.AutoDeleteMusicOnGameRemoval}"
                              Margin="0,0,0,10"/>
                    <Button Style="{StaticResource UpsButton}" Content="Clean Up Orphaned Music"
                            Command="{Binding CleanupOrphanedMusicCommand}"
                            Padding="15,8"
                            HorizontalAlignment="Left"
                            Background="#664422"
                            Foreground="White"/>
                </StackPanel>
    
                <!-- Clear Trailer-Audio Cache -->
                <StackPanel Margin="0,0,0,20">
                    <Border Style="{StaticResource UpsSectionBar}"><TextBlock ups:TrackedCaps.Text="Clear Trailer-Audio Cache" Style="{StaticResource UpsSectionTitle}"/></Border>
                    <TextBlock Text="Deletes the audio extracted from game video trailers (used by the experimental &quot;Stream audio from the game's EML trailer (no-music games only)&quot; default-music option). Files are re-extracted automatically the next time such a game is played."
                               Style="{StaticResource UpsHint}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <Button Style="{StaticResource UpsButton}" Content="Clear Trailer-Audio Cache"
                            Command="{Binding ClearTrailerAudioCacheCommand}"
                            Padding="15,8"
                            HorizontalAlignment="Left"
                            Background="#664422"
                            Foreground="White"/>
                </StackPanel>
                </StackPanel>
            </Expander>

            <!-- Reset Settings Only -->
            <StackPanel Margin="0,0,0,20">
                <Border Style="{StaticResource UpsSectionBar}"><TextBlock ups:TrackedCaps.Text="Reset Settings Only" Style="{StaticResource UpsSectionTitle}"/></Border>
                <TextBlock Text="Resets all settings to their default values. Music files will be preserved."
                           Style="{StaticResource UpsHint}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>
                <Button Style="{StaticResource UpsButton}" Content="Reset Settings to Defaults"
                        Command="{Binding ResetSettingsCommand}"
                        Padding="15,8"
                        HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- Factory Reset -->
            <StackPanel Margin="0,0,0,20">
                <Border Style="{StaticResource UpsSectionBar}"><TextBlock ups:TrackedCaps.Text="Factory Reset" Style="{StaticResource UpsSectionTitle}"/></Border>
                <TextBlock Text="Completely resets UniPlaySong to its initial state. This will:"
                           Style="{StaticResource UpsHint}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,5"/>
                <TextBlock Style="{StaticResource UpsHint}" Margin="10,0,0,10">
                    <Run Text="- Delete all downloaded music files"/>
                    <LineBreak/>
                    <Run Text="- Delete all preserved original files"/>
                    <LineBreak/>
                    <Run Text="- Remove all game music folders"/>
                    <LineBreak/>
                    <Run Text="- Clear the search cache"/>
                    <LineBreak/>
                    <Run Text="- Reset all settings to defaults"/>
                </TextBlock>
                <Button Style="{StaticResource UpsButton}" Content="Factory Reset"
                        Command="{Binding FactoryResetCommand}"
                        Padding="15,8"
                        HorizontalAlignment="Left"
                        Background="#AA2222"
                        Foreground="White"
                        FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
