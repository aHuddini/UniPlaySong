<UserControl x:Class="UniPlaySong.Controls.Settings.CleanupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UniPlaySong"
             xmlns:ups="clr-namespace:UniPlaySong.Controls.Settings"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UniPlaySong;component/Controls/Settings/SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Two levels, and only two. Section bars name the three GROUPS of work; each individual
         action is a card. Before this, both were section bars, so "Delete Actions" and "Delete
         All Music" carried identical weight and the page read as nine equal headings with no
         hierarchy at all.

         Button colour is the severity scale, and it is the fastest thing to read on the page:
         neutral is safe and reversible, amber removes files you can re-download, red is
         irreversible. -->

    <ScrollViewer Style="{StaticResource UpsPage}">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Text="Cleanup &amp; Reset" Style="{StaticResource UpsPageTitle}"/>
            <TextBlock Text="Remove downloaded content, or put settings back to how they started." Style="{StaticResource UpsPageSubtitle}"/>

            <Border Style="{StaticResource UpsCardDanger}">
                <StackPanel>
                    <TextBlock Text="Nothing on this page can be undone" Style="{StaticResource UpsCardTitle}"
                               Foreground="#F09292"/>
                    <TextBlock Style="{StaticResource UpsHint}" Margin="0,0,0,0" Foreground="#D9AFAF"
                               Text="Deleted music is gone, not recycled. If you want a way back, export your settings first from Advanced, Backup."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource UpsCardNavy}">
                <StackPanel>
                    <TextBlock Text="Current storage usage" Style="{StaticResource UpsCardTitle}"/>
                    <TextBlock Text="{Binding CleanupStorageInfo}" Style="{StaticResource UpsHint}" Margin="0,0,0,10"/>
                    <Button Content="Refresh" Style="{StaticResource UpsButton}"
                            HorizontalAlignment="Left"
                            Command="{Binding RefreshCleanupStorageInfoCommand}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource UpsSectionBar}">
                <TextBlock ups:TrackedCaps.Text="Tidy Up" Style="{StaticResource UpsSectionTitle}"/>
            </Border>

            <Border Style="{StaticResource UpsCard}">
                <StackPanel>
                    <TextBlock Text="Orphaned music" Style="{StaticResource UpsCardTitle}"/>
                    <TextBlock Style="{StaticResource UpsHint}" Margin="0,0,0,4"
                               Text="Finds music folders for games that are no longer in your Playnite library, and removes them."/>
                    <CheckBox Content="Delete a game's music when it leaves the library"
                              Style="{StaticResource UpsToggle}"
                              IsChecked="{Binding Settings.AutoDeleteMusicOnGameRemoval}"/>
                    <TextBlock Style="{StaticResource UpsHint}" Margin="36,1,0,10"
                               Text="Keeps this from building up again, with no prompt at the time."/>
                    <Button Content="Clean up orphaned music" Style="{StaticResource UpsButtonCaution}"
                            HorizontalAlignment="Left"
                            Command="{Binding CleanupOrphanedMusicCommand}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource UpsCard}">
                <StackPanel>
                    <TextBlock Text="Trailer-audio cache" Style="{StaticResource UpsCardTitle}"/>
                    <TextBlock Style="{StaticResource UpsHint}" Margin="0,0,0,10"
                               Text="Deletes audio extracted from game video trailers, used by the experimental trailer default-music option. It is re-extracted automatically next time such a game is played, so this one really is just a cache."/>
                    <Button Content="Clear trailer-audio cache" Style="{StaticResource UpsButton}"
                            HorizontalAlignment="Left"
                            Command="{Binding ClearTrailerAudioCacheCommand}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource UpsSectionBar}">
                <TextBlock ups:TrackedCaps.Text="Remove Music" Style="{StaticResource UpsSectionTitle}"/>
            </Border>

            <Border Style="{StaticResource UpsCard}">
                <StackPanel>
                    <TextBlock Text="Delete all music" Style="{StaticResource UpsCardTitle}"/>
                    <TextBlock Style="{StaticResource UpsHint}" Margin="0,0,0,10"
                               Text="Removes every downloaded file and game folder. Settings are kept."/>
                    <Button Content="Delete all music files" Style="{StaticResource UpsButtonDanger}"
                            HorizontalAlignment="Left"
                            Command="{Binding DeleteAllMusicCommand}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource UpsCard}">
                <StackPanel>
                    <TextBlock Text="Delete long songs" Style="{StaticResource UpsCardTitle}"/>
                    <TextBlock Style="{StaticResource UpsHint}" Margin="0,0,0,10"
                               Text="Deletes anything over ten minutes. Catches full albums, podcasts and corrupted files that were downloaded by mistake and that break bulk operations."/>
                    <Button Content="Delete songs over 10 minutes" Style="{StaticResource UpsButtonCaution}"
                            HorizontalAlignment="Left"
                            Command="{Binding DeleteLongSongsCommand}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource UpsSectionBar}">
                <TextBlock ups:TrackedCaps.Text="Start Over" Style="{StaticResource UpsSectionTitle}"/>
            </Border>

            <Border Style="{StaticResource UpsCard}">
                <StackPanel>
                    <TextBlock Text="Reset settings only" Style="{StaticResource UpsCardTitle}"/>
                    <TextBlock Style="{StaticResource UpsHint}" Margin="0,0,0,10"
                               Text="Puts every setting back to its default. Your music files are left alone."/>
                    <Button Content="Reset settings to defaults" Style="{StaticResource UpsButtonCaution}"
                            HorizontalAlignment="Left"
                            Command="{Binding ResetSettingsCommand}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource UpsCardDanger}">
                <StackPanel>
                    <TextBlock Text="Factory reset" Style="{StaticResource UpsCardTitle}" Foreground="#F09292"/>
                    <TextBlock Style="{StaticResource UpsHint}" Margin="0,0,0,4"
                               Text="Returns UniPlaySong to the state it was in on install:"/>
                    <TextBlock Style="{StaticResource UpsHint}" Margin="10,0,0,10">
                        <Run Text="• Deletes all downloaded music"/><LineBreak/>
                        <Run Text="• Deletes all preserved originals"/><LineBreak/>
                        <Run Text="• Removes every game music folder"/><LineBreak/>
                        <Run Text="• Clears the search cache"/><LineBreak/>
                        <Run Text="• Resets every setting"/>
                    </TextBlock>
                    <Button Content="Factory reset" Style="{StaticResource UpsButtonDanger}"
                            HorizontalAlignment="Left" FontWeight="SemiBold"
                            Command="{Binding FactoryResetCommand}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
