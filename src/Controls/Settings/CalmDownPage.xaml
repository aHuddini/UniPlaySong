<UserControl x:Class="UniPlaySong.Controls.Settings.CalmDownPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UniPlaySong"
             xmlns:ups="clr-namespace:UniPlaySong.Controls.Settings"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UniPlaySong;component/Controls/Settings/SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource UpsPage}">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">

            <TextBlock Text="Calm Down" Style="{StaticResource UpsPageTitle}"/>
            <TextBlock Style="{StaticResource UpsPageSubtitle}"
                       Text="Softens the music instead of stopping it — rolls off the treble and eases the volume down, then back up when you turn it off."/>

            <Border Style="{StaticResource UpsSectionBar}">
                <TextBlock ups:TrackedCaps.Text="Mode" Style="{StaticResource UpsSectionTitle}"/>
            </Border>

            <CheckBox Style="{StaticResource UpsToggleAmber}" Content="Calm Down Mode on"
                      IsChecked="{Binding Settings.CalmDownModeEnabled}"/>
            <TextBlock Style="{StaticResource UpsHintFlush}" Margin="0,4,0,12"
                       Text="Also on the Fullscreen quick menu, and on the Desktop top panel if you turned that button on under Media Controls. Uses the NAudio player while it is on."/>

            <Border Style="{StaticResource UpsSectionBar}">
                <TextBlock ups:TrackedCaps.Text="Character" Style="{StaticResource UpsSectionTitle}"/>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                <TextBlock Text="Preset" Style="{StaticResource UpsLabel}" Width="140"/>
                <ComboBox Style="{StaticResource UpsComboBox}" Width="220"
                          SelectedIndex="{Binding Settings.SelectedCalmDownPreset, Converter={StaticResource CalmDownPresetConverter}}"
                          SelectionChanged="CalmDownPreset_SelectionChanged">
                    <ComboBoxItem Content="Custom"/>
                    <ComboBoxItem Content="Default"/>
                    <ComboBoxItem Content="Subtle"/>
                    <ComboBoxItem Content="Warm"/>
                    <ComboBoxItem Content="Muffled"/>
                    <ComboBoxItem Content="Distant"/>
                    <ComboBoxItem Content="Whisper"/>
                </ComboBox>
            </StackPanel>
            <TextBlock Style="{StaticResource UpsHintFlush}" Margin="0,4,0,12"
                       Text="Default is how Calm Down has always sounded. Subtle takes the edge off; Warm dulls the top without dropping much volume; Muffled is through-the-wall; Distant is pronounced and slow; Whisper almost disappears. Moving any slider below switches to Custom."/>

            <Border Style="{StaticResource UpsSectionBar}">
                <TextBlock ups:TrackedCaps.Text="Fine Tuning" Style="{StaticResource UpsSectionTitle}"/>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                <TextBlock Text="High cut" Style="{StaticResource UpsLabel}" Width="140"/>
                <Slider Minimum="200" Maximum="8000" Width="220" VerticalAlignment="Center"
                        Value="{Binding Settings.CalmDownLowPassCutoffHz}"
                        TickFrequency="100" IsSnapToTickEnabled="True"
                        ValueChanged="Tuning_ValueChanged"/>
                <TextBlock Style="{StaticResource UpsValue}" Margin="12,0,0,0"
                           Text="{Binding Settings.CalmDownLowPassCutoffHz, StringFormat='{}{0:F0} Hz'}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource UpsHintFlush}" Margin="0,0,0,10"
                       Text="Everything above this is rolled off. Lower is more muffled."/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="Volume" Style="{StaticResource UpsLabel}" Width="140"/>
                <Slider Minimum="0.05" Maximum="1.0" Width="220" VerticalAlignment="Center"
                        Value="{Binding Settings.CalmDownVolumeMultiplier}"
                        TickFrequency="0.05" IsSnapToTickEnabled="True"
                        ValueChanged="Tuning_ValueChanged"/>
                <TextBlock Style="{StaticResource UpsValue}" Margin="12,0,0,0"
                           Text="{Binding Settings.CalmDownVolumeMultiplier, StringFormat='{}{0:P0}'}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource UpsHintFlush}" Margin="0,0,0,10"
                       Text="Where the level settles while Calm Down is on, relative to your normal volume. 100% means high cut only, no volume change."/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <TextBlock Text="Transition" Style="{StaticResource UpsLabel}" Width="140"/>
                <Slider Minimum="0.1" Maximum="10" Width="220" VerticalAlignment="Center"
                        Value="{Binding Settings.CalmDownTransitionDurationSeconds}"
                        TickFrequency="0.1" IsSnapToTickEnabled="True"
                        ValueChanged="Tuning_ValueChanged"/>
                <TextBlock Style="{StaticResource UpsValue}" Margin="12,0,0,0"
                           Text="{Binding Settings.CalmDownTransitionDurationSeconds, StringFormat='{}{0:F1}s'}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource UpsHintFlush}" Margin="0,0,0,12"
                       Text="How long it takes to settle when you switch it on or off."/>

            <Button Style="{StaticResource UpsButton}" HorizontalAlignment="Left"
                    Content="Reset Calm Down" Click="ResetCalmDown_Click"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
