<UserControl x:Class="UniPlaySong.Controls.Settings.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UniPlaySong"
             xmlns:ups="clr-namespace:UniPlaySong.Controls.Settings"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UniPlaySong;component/Controls/Settings/SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Cards rather than sections. This page is read, not operated: flat headings over prose
         collapse into one wall of text, whereas a tinted box makes each block skippable and its
         tint says what kind of block it is before a word is read. -->

    <ScrollViewer Style="{StaticResource UpsPage}">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">

            <TextBlock Text="UniPlaySong" Style="{StaticResource UpsPageTitle}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Version " Style="{StaticResource UpsHint}" Margin="0"/>
                <TextBlock Text="{Binding PluginVersion}" Style="{StaticResource UpsHint}"
                           Margin="0" FontWeight="SemiBold" Foreground="{StaticResource UpsAccent}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource UpsPageSubtitle}"
                       Text="A console-like game music preview experience for Playnite. Music plays while browsing your library, with controller-friendly song management and fade transitions between selections."/>

            <Border Style="{StaticResource UpsCardGood}">
                <StackPanel>
                    <TextBlock Style="{StaticResource UpsCardTitle}">
                        <Run Text="What's New in v"/><Run Text="{Binding PluginVersion, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource UpsBody}">
                        <Run FontWeight="SemiBold">Fixed:</Run> Preview buttons only played once per settings session — clicking Preview again now works without reopening this window.
                    </TextBlock>
                    <TextBlock Style="{StaticResource UpsBody}">
                        <Run FontWeight="SemiBold">Changed:</Run> Removed the System beep sound option. If you had it selected, that sound now uses the bundled jingle.
                    </TextBlock>
                    <TextBlock Style="{StaticResource UpsHint}" Margin="0,4,0,0">
                        This covers the current release only. Full history:
                        <Hyperlink Style="{StaticResource UpsLink}"
                                   NavigateUri="https://github.com/aHuddini/UniPlaySong/blob/main/Manifest/installer.yaml"
                                   RequestNavigate="AboutHyperlink_RequestNavigate">installer manifest on GitHub</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource UpsCard}">
                <StackPanel>
                    <TextBlock Text="Supported Audio Formats" Style="{StaticResource UpsCardTitle}"/>
                    <TextBlock Style="{StaticResource UpsHint}" Margin="0,0,0,8"
                               Text="Formats tested with UPS's audio system. Drop files matching these extensions into a game's music folder."/>
                    <TextBlock Style="{StaticResource UpsBullet}" FontWeight="SemiBold">• MP3    • OGG Vorbis    • FLAC    • WAV</TextBlock>

                    <TextBlock Style="{StaticResource UpsBody}" Margin="0,10,0,4" FontWeight="SemiBold"
                               Text="Retro chiptune, via the bundled Game Music Emu"/>
                    <TextBlock Style="{StaticResource UpsBullet}" Margin="10,0,0,3"><Run FontWeight="SemiBold">• .vgm / .vgz</Run> — Sega Genesis / Mega Drive / Sega CD</TextBlock>
                    <TextBlock Style="{StaticResource UpsBullet}" Margin="10,0,0,3"><Run FontWeight="SemiBold">• .nsf</Run> — NES / Famicom</TextBlock>
                    <TextBlock Style="{StaticResource UpsBullet}" Margin="10,0,0,3"><Run FontWeight="SemiBold">• .spc</Run> — SNES / Super Famicom</TextBlock>
                    <TextBlock Style="{StaticResource UpsBullet}" Margin="10,0,0,0"><Run FontWeight="SemiBold">• .hes</Run> — NEC TurboGrafx-16 / PC Engine (needs a sibling .m3u for multi-track playback)</TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource UpsCardAccent}">
                <StackPanel>
                    <TextBlock Text="Officially Supported Fullscreen Themes" Style="{StaticResource UpsCardTitle}"/>
                    <TextBlock Style="{StaticResource UpsHint}" Margin="0,0,0,8"
                               Text="Themes that use the theme-integration API (UPS_MusicControl) to pause music during intro sequences, login screens and overlays."/>
                    <TextBlock Style="{StaticResource UpsBullet}" FontWeight="SemiBold">• ANIKI REMAKE</TextBlock>
                    <TextBlock Style="{StaticResource UpsBullet}" FontWeight="SemiBold" Margin="2,0,0,8">• PS5 Experience (by saVantCZ)</TextBlock>
                    <TextBlock Style="{StaticResource UpsHint}" Margin="0,0,0,0"
                               Text="PS5 Experience needs its compatibility toggle: Advanced → Theme Support."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource UpsCardWarn}">
                <StackPanel>
                    <TextBlock Text="Troubleshooting / Known Quirks" Style="{StaticResource UpsCardTitle}"/>
                    <TextBlock Style="{StaticResource UpsHint}" Margin="0,0,0,10"
                               Text="Real-world edge cases users have hit."/>

                    <TextBlock Style="{StaticResource UpsBody}" FontWeight="SemiBold" Margin="0,0,0,2"
                               Text="Windows may not auto-sleep while Playnite is running"/>
                    <TextBlock Style="{StaticResource UpsHint}" Margin="10,0,0,10"
                               Text="UPS holds the audio device open between songs to avoid stutter, and Windows can read that as active audio, which may prevent sleep. If your PC doesn't sleep on its own, exit Playnite when you step away."/>

                    <TextBlock Style="{StaticResource UpsBody}" FontWeight="SemiBold" Margin="0,0,0,2"
                               Text="Pause on focus loss can be unreliable"/>
                    <TextBlock Style="{StaticResource UpsHint}" Margin="10,0,0,10"
                               Text="If music gets stuck silent after exiting a game, turn off &quot;Ignore brief focus loss&quot;. If it still happens, send a log."/>

                    <TextBlock Style="{StaticResource UpsBody}" FontWeight="SemiBold" Margin="0,0,0,2"
                               Text="Active theme music options in Playback settings require theme support"/>
                    <TextBlock Style="{StaticResource UpsHint}" Margin="10,0,0,0"
                               Text="This option needs the theme to ship a UPS_BackgroundAudio audio file. Ask the theme's developer to add one to their theme directories"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
