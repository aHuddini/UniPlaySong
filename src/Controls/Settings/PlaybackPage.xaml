<UserControl x:Class="UniPlaySong.Controls.Settings.PlaybackPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UniPlaySong"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UniPlaySong;component/Controls/Settings/SettingsResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <Grid Margin="0,0,0,10">
                <TextBlock Text="Playback Settings" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="Reset to Defaults" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="ResetPlaybackTab_Click" Padding="8,3" FontSize="11"/>
            </Grid>
            <TextBlock Text="Configure music playback, volume, fades, and default music" FontSize="11" Foreground="#90A8A0" FontStyle="Italic" Margin="0,0,0,20"/>

            <!-- Moved from the General tab: these three decide WHEN music plays at
                 all, so they belong at the head of Playback rather than under
                 general options. Deliberately not collapsed — they are the first
                 thing a user needs and should be visible on arrival. -->
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="Play Music State: " VerticalAlignment="Center" Width="150"/>
                <ComboBox SelectedIndex="{Binding Settings.MusicState, Converter={StaticResource AudioStateConverter}}"
                          Width="200"
                          Margin="0,0,0,0">
                    <ComboBoxItem Content="Never"/>
                    <ComboBoxItem Content="Desktop Only"/>
                    <ComboBoxItem Content="Fullscreen Only"/>
                    <ComboBoxItem Content="Desktop + Fullscreen"/>
                </ComboBox>
            </StackPanel>
            <TextBlock Text="Controls when music plays: Never, Desktop only, Fullscreen only, or Both. To prevent automatic playback in Desktop mode entirely, set to &quot;Fullscreen Only&quot;. For more granular automatic playback control in Desktop, see the &quot;Automatic Playback&quot; option below."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,10"/>

            <CheckBox Content="Automatic Playback on First Launch (Desktop)"
                      IsChecked="{Binding Settings.AutoPlayOnFirstLaunchDesktop}"
                      Margin="0,5"/>
            <TextBlock Text="When unchecked, automatic playback is disabled in Desktop until you manually press Play. After the first manual Play, game switches will automatically play music for the rest of the session. Resets on Playnite restart."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,10"/>

            <CheckBox Content="Do not play music on startup (Fullscreen)"
                      IsChecked="{Binding Settings.SkipFirstSelectionAfterModeSwitch}"
                      Margin="0,5"/>
            <TextBlock Text="When enabled, music will not play on the first game selection after switching to fullscreen mode"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,10"/>

            <Separator Margin="0,15"/>

            <!-- Volume -->
            <Expander IsExpanded="False" Margin="0,0,0,10">
                <Expander.Header>
                    <TextBlock Text="Volume" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="Music Volume: " VerticalAlignment="Center" Width="120"/>
                <Slider Minimum="0" Maximum="100"
                        Value="{Binding Settings.MusicVolume}"
                        Width="200" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Settings.MusicVolume}"
                           VerticalAlignment="Center"
                           Width="30"/>
            </StackPanel>

            <!-- Fullscreen volume boost -->
            <StackPanel Orientation="Horizontal" Margin="0,5,0,2">
                <TextBlock Text="Fullscreen Boost: " VerticalAlignment="Center" Width="120"/>
                <Slider Minimum="0" Maximum="20" IsSnapToTickEnabled="True" TickFrequency="1"
                        Value="{Binding Settings.FullscreenVolumeBoostPercent}"
                        Width="200" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Settings.FullscreenVolumeBoostPercent, StringFormat='+{0}%'}"
                           VerticalAlignment="Center"
                           Width="40"/>
            </StackPanel>
            <TextBlock Text="Slightly nudges music volume up in Fullscreen mode to compensate for Playnite's built-in Background Volume reduction. Only active in Fullscreen; Desktop mode is unaffected. Default 0%."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="120,0,0,10"/>

            <CheckBox Content="Lower Volume When Idle (To 25%)"
                      IsChecked="{Binding Settings.LowerVolumeOnIdle}"
                      Margin="0,10,0,5"/>
            <TextBlock Text="Gradually lowers music volume after inactivity instead of pausing. Volume restores instantly on any input."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="20,5,0,5"
                        IsEnabled="{Binding Settings.LowerVolumeOnIdle}">
                <TextBlock Text="Idle timeout:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider Minimum="1" Maximum="60"
                        Value="{Binding Settings.IdleVolumeTimeoutMinutes}"
                        Width="200" TickFrequency="5" IsSnapToTickEnabled="False"/>
                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0"
                           Text="{Binding Settings.IdleVolumeTimeoutMinutes, StringFormat='{}{0} min'}"/>
            </StackPanel>
                </StackPanel>
            </Expander>

            <!-- Fade Effects -->
            <Expander IsExpanded="False" Margin="0,0,0,10">
                <Expander.Header>
                    <TextBlock Text="Fade Effects" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">
            <TextBlock Text="Control how music transitions in and out. With Live Effects enabled, fades may feel different due to reverb tail processing."
                       FontSize="12"
                       FontStyle="Italic"
                       Foreground="#808090"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <!-- Fade In Duration -->
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="Fade-In Duration: " VerticalAlignment="Center" Width="120"/>
                <TextBlock Text="{Binding Settings.FadeInDuration, StringFormat='{}{0:F2}'}"
                           VerticalAlignment="Center"
                           Width="35"
                           Margin="0,0,3,0"/>
                <TextBlock Text="s" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider Minimum="0.10" Maximum="5"
                        Value="{Binding Settings.FadeInDuration}"
                        Width="200"
                        IsSnapToTickEnabled="True"
                        SmallChange="0.05"
                        LargeChange="0.5"
                        TickFrequency="0.05"
                        TickPlacement="None"
                        AutoToolTipPlacement="TopLeft"
                        AutoToolTipPrecision="2"/>
            </StackPanel>
            <TextBlock Text="How long music fades in (longer = smoother)"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,5"/>

            <!-- Fade Out Duration -->
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="Fade-Out Duration: " VerticalAlignment="Center" Width="120"/>
                <TextBlock Text="{Binding Settings.FadeOutDuration, StringFormat='{}{0:F2}'}"
                           VerticalAlignment="Center"
                           Width="35"
                           Margin="0,0,3,0"/>
                <TextBlock Text="s" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider Minimum="0.10" Maximum="5"
                        Value="{Binding Settings.FadeOutDuration}"
                        Width="200"
                        IsSnapToTickEnabled="True"
                        SmallChange="0.05"
                        LargeChange="0.5"
                        TickFrequency="0.05"
                        TickPlacement="None"
                        AutoToolTipPlacement="TopLeft"
                        AutoToolTipPrecision="2"/>
            </StackPanel>
            <TextBlock Text="How long music fades out (shorter = snappier)"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,10"/>

            <!-- Song End Fade-Out -->
            <CheckBox Content="Fade out before song ends (Radio Mode / Randomize on Song End)"
                      IsChecked="{Binding Settings.FadeOutBeforeSongEnd}"
                      Margin="0,12,0,4"
                      ToolTip="Only active when Radio Mode or Randomize on Song End is enabled. Fades the current song out in the final seconds before it ends naturally, creating a smooth transition to the next track." />
            <StackPanel Orientation="Horizontal"
                        Margin="20,0,0,0"
                        IsEnabled="{Binding Settings.FadeOutBeforeSongEnd}">
                <TextBlock Text="Fade duration:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider Minimum="0.2" Maximum="5"
                        Value="{Binding Settings.FadeOutBeforeSongEndDuration}"
                        Width="150" TickFrequency="0.1" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Settings.FadeOutBeforeSongEndDuration, StringFormat='{}{0:F1}s'}"
                           VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
            </StackPanel>

            <!-- True Crossfade Mode (opt-in) -->
            <CheckBox Content="Enable True Crossfade (DJ-style overlap)"
                      IsChecked="{Binding Settings.EnableTrueCrossfade}"
                      Margin="0,12,0,4"
                      ToolTip="When enabled, during auto-advance transitions (Radio Mode / RandomizeOnMusicEnd / pool-based default music) the next song starts playing simultaneously with the current song fading out. Forces NAudio backend. Takes effect on the next song transition — enabling mid-playback does NOT retrofit the currently-playing song."/>
            <TextBlock Text="When on, replaces the sequential fade-out above with a parallel overlap for auto-advance transitions only. Manual song changes still use instant switching. Forces NAudio backend. Default 9s is recommended for natural-sounding transitions; shorter values feel abrupt."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,6"/>
            <StackPanel Orientation="Horizontal"
                        Margin="20,0,0,0"
                        IsEnabled="{Binding Settings.EnableTrueCrossfade}">
                <TextBlock Text="Crossfade duration:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider Minimum="1" Maximum="10"
                        Value="{Binding Settings.CrossfadeDurationSeconds}"
                        Width="200" TickFrequency="1" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Settings.CrossfadeDurationSeconds, StringFormat='{}{0}s'}"
                           VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"/>
            </StackPanel>
            <TextBlock Text="Songs shorter than the crossfade duration + 2 seconds fall back to the sequential fade above."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,4,0,0"
                       IsEnabled="{Binding Settings.EnableTrueCrossfade}"/>
                </StackPanel>
            </Expander>

            <!-- Preview Mode -->
            <Expander IsExpanded="False" Margin="0,0,0,10">
                <Expander.Header>
                    <TextBlock Text="Preview Mode" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">
            <TextBlock Text="Limit playback duration for game-specific music tracks" FontSize="11" Foreground="Gray" Margin="0,0,0,10"/>

            <CheckBox Content="Enable Preview Mode"
                      IsChecked="{Binding Settings.EnablePreviewMode}"
                      Margin="0,5"/>
            <TextBlock Text="When enabled, game music will restart after the specified duration. Does not affect default music."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,10"/>

            <!-- Preview Duration -->
            <StackPanel Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="Preview Duration: " VerticalAlignment="Center" Width="120"/>
                <TextBlock Text="{Binding Settings.PreviewDuration}"
                           VerticalAlignment="Center"
                           Width="35"
                           Margin="0,0,3,0"/>
                <TextBlock Text="s" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider Minimum="15" Maximum="300"
                        Value="{Binding Settings.PreviewDuration}"
                        Width="180"
                        SmallChange="5"
                        LargeChange="15"
                        TickFrequency="15"
                        TickPlacement="BottomRight"
                        AutoToolTipPlacement="TopLeft"/>
            </StackPanel>
            <TextBlock Text="How long each game music track plays before restarting (15-300 seconds)"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,10"/>
                </StackPanel>
            </Expander>

            <!-- Song Randomization -->
            <Expander IsExpanded="False" Margin="0,0,0,10">
                <Expander.Header>
                    <TextBlock Text="Song Randomization" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">
            <TextBlock Text="Control when songs are randomized during playback" FontSize="11" Foreground="Gray" Margin="0,0,0,10"/>

            <CheckBox Content="Randomize song upon selection"
                      IsChecked="{Binding Settings.RandomizeOnEverySelect}"
                      Margin="0,5"/>
            <TextBlock Text="When enabled, a random song will be selected each time you select a game (after primary song plays)."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,10"/>

            <CheckBox Content="Randomize song when current song ends"
                      IsChecked="{Binding Settings.RandomizeOnMusicEnd}"
                      Margin="0,5"/>
            <TextBlock Text="When enabled, after the current song finishes, a new random song will be selected from available songs."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,10"/>

            <CheckBox Content="Stop after song ends (no loop)"
                      IsChecked="{Binding Settings.StopAfterSongEnds}"
                      Margin="0,5"/>
            <TextBlock Text="When enabled, music stops after the current song finishes instead of looping or advancing to the next song. Applies to regular playback and preview mode."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,15"/>
                </StackPanel>
            </Expander>

            <Expander IsExpanded="False" Margin="0,0,0,10">
                <Expander.Header>
                    <TextBlock Text="Random Game Picker" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                </Expander.Header>
                <StackPanel Margin="0,10,0,0">
                    <CheckBox Content="Play music while browsing the random game picker"
                              IsChecked="{Binding Settings.EnableRandomPickerMusic}"
                              Margin="0,5,0,5"/>
                    <TextBlock Text="Plays each game's music as you click 'Pick Another' in Playnite's random game picker dialog. Music restores to your library selection when the dialog closes."
                               FontSize="11"
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               Margin="20,0,0,10"/>
                </StackPanel>
            </Expander>

            <Separator Margin="0,15"/>

            <!-- Default Music -->
            <TextBlock Text="Default Music" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock Text="Play fallback music when no game music is found. Disable to maintain silence when no game music is found." FontSize="11" Foreground="Gray" Margin="0,0,0,10"/>

            <CheckBox Content="Enable Default Music"
                      IsChecked="{Binding Settings.EnableDefaultMusic}"
                      Margin="0,5"/>
            <TextBlock Text="When enabled, plays default music when a selected game has no music files"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,10"/>

            <!-- Keep same default track on game switch (for pool-based sources) -->
            <CheckBox Content="Keep Same Default Track On Game Switch"
                      IsChecked="{Binding Settings.DefaultMusicContinueSameSong}"
                      IsEnabled="{Binding Settings.EnableDefaultMusic}"
                      Margin="0,5"/>
            <TextBlock Text="Applies to Random Game, Custom Folder, Custom Rotation, and Completion Status Pool sources. When enabled, the same default song keeps playing as you browse games instead of picking a new random song each time. Pair with 'Auto-advance Default Music on song end' below (disable it) for a fully persistent single-track backdrop."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,10"/>

            <CheckBox Content="Auto-advance Default Music on song end"
                      IsChecked="{Binding Settings.RandomizeDefaultMusicOnEnd}"
                      IsEnabled="{Binding Settings.EnableDefaultMusic}"
                      Margin="0,5"/>
            <TextBlock Text="Only affects pool-based sources (Random Game, Custom Folder, Custom Rotation, Completion Status Pool). When enabled (default), default music rotates to a new random track when the current one ends — radio-style. When disabled, the current track loops instead. For fully persistent single-track behavior, also enable 'Keep Same Default Track On Game Switch' above — otherwise game hovers still re-roll the pool. Independent from the 'Randomize on Music End' setting above, which only affects game music."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,10"/>

            <!-- Default Music Source: Bundled Preset -->
            <RadioButton Content="Use bundled preset"
                         IsChecked="{Binding Settings.DefaultMusicSourceOption, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=BundledPreset}"
                         IsEnabled="{Binding Settings.EnableDefaultMusic}"
                         GroupName="DefaultMusicSource"
                         Margin="20,5,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="40,5,0,0">
                <TextBlock Text="Preset: " VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding BundledPresets}"
                          SelectedValue="{Binding Settings.SelectedBundledPreset}"
                          SelectedValuePath="File"
                          DisplayMemberPath="DisplayName"
                          IsEnabled="{Binding Settings.IsBundledPresetPickerEnabled}"
                          Width="350"
                          Margin="5,0,0,0"/>
            </StackPanel>
            <TextBlock Text="Bundled ambient tracks"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="40,3,0,5"/>

            <!-- v1.5.0: Randomize bundled track across sessions -->
            <CheckBox Content="Randomize bundled track every startup"
                      IsChecked="{Binding Settings.RandomizeBundledTrackOnStartup}"
                      IsEnabled="{Binding Settings.EnableDefaultMusic}"
                      Margin="40,3,0,0"/>
            <TextBlock Text="When on, UPS picks one bundled preset at random each time Playnite starts and uses it for the whole session. The manual preset picker above is ignored while this is enabled."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="60,3,0,10"/>

            <!-- Default Music Source: Custom File -->
            <RadioButton Content="Use custom music file"
                         IsChecked="{Binding Settings.DefaultMusicSourceOption, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=CustomFile}"
                         IsEnabled="{Binding Settings.EnableDefaultMusic}"
                         GroupName="DefaultMusicSource"
                         Margin="20,5,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="40,5,0,0">
                <TextBox Text="{Binding Settings.DefaultMusicPath}"
                         Width="330"
                         Margin="0,0,10,0"
                         IsReadOnly="True"
                         IsEnabled="{Binding Settings.EnableDefaultMusic}"/>
                <Button Content="Browse..."
                        Width="80"
                        Margin="0,0,5,0"
                        IsEnabled="{Binding Settings.EnableDefaultMusic}"
                        Command="{Binding BrowseForDefaultMusicFile}"/>
                <Button Content="Download..."
                        Width="90"
                        IsEnabled="{Binding Settings.EnableDefaultMusic}"
                        Command="{Binding DownloadDefaultMusic}"/>
            </StackPanel>
            <TextBlock Text="Select a music file (MP3, WAV, FLAC, etc.) to play when no game music is available"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="40,3,0,10"/>

            <!-- v1.5.0: "Use Playnite native theme music" radio removed.
                 The DefaultMusicSource.NativeTheme enum value is
                 marked [Obsolete] and silently migrated to
                 BundledPreset on settings load. UPS now ships
                 Shades of Orange (the same track Playnite's
                 default Fullscreen theme uses) as a bundled
                 preset, avoiding the file-handle conflict UPS
                 had when reading Playnite's installed theme
                 directly. See NOTICES.txt for attribution. -->

            <!-- Default Music Source: Active Theme UPS Audio (v1.5.2) -->
            <RadioButton Content="Use active theme's UPS audio file (advanced — theme support required)"
                         IsChecked="{Binding Settings.DefaultMusicSourceOption, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ActiveThemeMusic}"
                         IsEnabled="{Binding Settings.EnableDefaultMusic}"
                         GroupName="DefaultMusicSource"
                         Margin="20,5,0,0"/>
            <TextBlock Text="Plays UPS_BackgroundAudio.{mp3,ogg,wav,flac} from the active Fullscreen theme's audio folder. Theme developers must add this file for the option to work."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="40,0,0,5"/>

            <!-- State A: Ready — UPS file is present -->
            <StackPanel Margin="40,0,0,10"
                        Visibility="{Binding IsActiveThemeReady, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock FontSize="11" Foreground="#90C090" TextWrapping="Wrap">
                    <Run Text="✓ Detected: UPS_BackgroundAudio in "/>
                    <Run Text="{Binding ActiveThemeStatus.ThemeName, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
            </StackPanel>

            <!-- State B: CanBeCreated — has background.* but no UPS file; offer copy button -->
            <StackPanel Margin="40,0,0,10"
                        Visibility="{Binding IsActiveThemeCanBeCreated, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock FontSize="11" Foreground="#D0B070" TextWrapping="Wrap">
                    <Run Text="⚠ Your active theme ("/>
                    <Run Text="{Binding ActiveThemeStatus.ThemeName, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text=") doesn't ship a UPS audio file, but it has a background.* file that Playnite uses for its own audio player."/>
                </TextBlock>
                <Button Content="Create UPS_BackgroundAudio from theme's background file"
                        Command="{Binding CreateUpsAudioFromBackgroundCommand}"
                        Padding="10,4"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,4"/>
                <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                           Text="Makes a copy with the UPS filename so UPS plays it without fighting Playnite for the same file. Theme updates may overwrite this — re-run the helper if music goes silent after updating your theme."/>
                <!-- Result message shown after a copy attempt. Color reflects success/error.
                     Stays hidden until the user clicks the button (message is null initially). -->
                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="{Binding ActiveThemeCopyResultMessage}"
                           Visibility="{Binding ActiveThemeCopyResultMessage, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#90C090"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveThemeCopyResultIsError}" Value="True">
                                    <Setter Property="Foreground" Value="#E0805F"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- State C: Unsupported — no UPS file and no background.* file either -->
            <StackPanel Margin="40,0,0,10"
                        Visibility="{Binding IsActiveThemeUnsupported, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock FontSize="11" Foreground="#E08070" TextWrapping="Wrap">
                    <Run Text="✗ Not supported by your current theme ("/>
                    <Run Text="{Binding ActiveThemeStatus.ThemeName, Mode=OneWay}" FontWeight="SemiBold"/>
                    <Run Text="). Ask the theme developer to add UPS_BackgroundAudio.{mp3,ogg,wav,flac} to their audio folder, or pick a different default music source."/>
                </TextBlock>
            </StackPanel>

            <!-- State D: NotApplicable — could not resolve fullscreen theme (Desktop only / lookup failed) -->
            <StackPanel Margin="40,0,0,10"
                        Visibility="{Binding IsActiveThemeNotApplicable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                           Text="ℹ This option applies in Fullscreen mode. UPS will resolve the file against whichever theme is active when you switch to Fullscreen."/>
            </StackPanel>

            <!-- Note: "Defer to trailer audio" lives on the Experimental tab (v1.5.4) -->

            <!-- Default Music Source: Random Game -->
            <RadioButton Content="Pick From Random Game"
                         IsChecked="{Binding Settings.DefaultMusicSourceOption, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=RandomGame}"
                         IsEnabled="{Binding Settings.EnableDefaultMusic}"
                         GroupName="DefaultMusicSource"
                         Margin="20,5,0,0"/>
            <TextBlock Text="Randomly selects a song from any game in your music library"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="40,0,0,10"/>

            <!-- Default Music Source: Custom Folder -->
            <RadioButton Content="Custom Music Folder (Playlist Mode)"
                         IsChecked="{Binding Settings.DefaultMusicSourceOption, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=CustomFolder}"
                         IsEnabled="{Binding Settings.EnableDefaultMusic}"
                         GroupName="DefaultMusicSource"
                         Margin="20,5,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="40,5,0,0">
                <TextBox Text="{Binding Settings.DefaultMusicFolderPath}"
                         Width="330"
                         Margin="0,0,10,0"
                         IsReadOnly="True"
                         IsEnabled="{Binding Settings.EnableDefaultMusic}"/>
                <Button Content="Browse..."
                        Width="80"
                        IsEnabled="{Binding Settings.EnableDefaultMusic}"
                        Command="{Binding BrowseForDefaultMusicFolder}"/>
            </StackPanel>
            <TextBlock Text="Randomly plays music from any audio files in the selected folder"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="40,3,0,10"/>

            <!-- Default Music Source: Custom Rotation -->
            <RadioButton Content="Custom Game Rotation (Playlist Mode)"
                         IsChecked="{Binding Settings.DefaultMusicSourceOption, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=CustomRotation}"
                         IsEnabled="{Binding Settings.EnableDefaultMusic}"
                         GroupName="DefaultMusicSource"
                         Margin="20,5,0,0"/>
            <StackPanel Margin="40,5,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Select Games..."
                            Width="120"
                            IsEnabled="{Binding Settings.EnableDefaultMusic}"
                            Command="{Binding SelectRotationGames}"/>
                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0"
                               Text="{Binding RotationGameCountText}"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding RotationGameNames}" Margin="0,5,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11" Foreground="#7BA4D4" Margin="5,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <TextBlock Text="Uses music from your selected games as the default rotation pool"
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="40,3,0,10"/>

            <!-- Default Music Source: Completion Status Pool -->
            <RadioButton Content="By Completion Status (Nostalgia Playlist Mode)"
                         IsChecked="{Binding Settings.DefaultMusicSourceOption, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=CompletionStatusPool}"
                         IsEnabled="{Binding Settings.EnableDefaultMusic}"
                         GroupName="DefaultMusicSource"
                         Margin="20,5,0,0"/>
            <StackPanel Margin="40,5,0,10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Select Statuses..."
                            Width="120"
                            IsEnabled="{Binding Settings.EnableDefaultMusic}"
                            Command="{Binding SelectDefaultMusicStatusPoolCommand}"/>
                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"
                               Foreground="#7BA4D4"
                               Text="{Binding DefaultMusicStatusPoolSummary}"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Pools music from all games that match the selected completion statuses. Pairs with Nostalgia Mode — e.g. select 'Completed' to hear only music from your finished games."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="40,0,0,10"/>

            <!-- Default Music Source: Trailer Audio (graduated from Experimental in v1.5.8) -->
            <RadioButton Content="Stream audio from the game's EML trailer (no-music games only)"
                         IsChecked="{Binding Settings.DefaultMusicSourceOption, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=DeferToTrailerAudio}"
                         IsEnabled="{Binding IsTrailerAudioEnabled}"
                         GroupName="DefaultMusicSource"
                         Margin="20,5,0,0"/>
            <TextBlock Text="For games with no UniPlaySong music, extracts the audio from the game's EML video trailer and plays it as the default music. The first play for each game may take a moment while the audio is extracted (it might be slow); it is cached afterward so later plays are instant. Requires FFmpeg (set in the Setup tab) and a full video trailer from the ExtraMetadataLoader extension. Games with only a micro-trailer, or no trailer, stay silent."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="40,0,0,4"/>
            <TextBlock Text="Important: in ExtraMetadataLoader's settings, enable &quot;Play videos initially without sound&quot;. Otherwise EML's own video plays its audio on top of the extracted trailer audio, and you hear the trailer even on games that have music."
                       FontSize="11"
                       Foreground="#E0A030"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="40,0,0,4"/>
            <TextBlock Text="Requires FFmpeg — set its path in the Setup tab"
                       FontSize="11"
                       Foreground="IndianRed"
                       TextWrapping="Wrap"
                       Margin="40,0,0,10"
                       Visibility="{Binding TrailerAudioFFmpegMissing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Default Music Source: Spotify (graduated from Experimental in v1.5.8) -->
            <RadioButton IsChecked="{Binding Settings.DefaultMusicSourceOption, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Spotify}"
                         IsEnabled="{Binding Settings.EnableDefaultMusic}"
                         GroupName="DefaultMusicSource"
                         Command="{Binding SetRestartRequired}"
                         CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                         Margin="20,5,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Official Spotify logomark. Brand green #1DB954, geometry from resources. -->
                    <Path Data="{StaticResource SpotifyLogoGeometry}"
                          Fill="#1DB954"
                          Stretch="Uniform"
                          Width="16" Height="16"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="Spotify (control the Spotify desktop app)" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="40,2,0,5">
                For games with no UniPlaySong music, conduct the open Spotify desktop app instead of playing a default track. Games that have their own music still play it (Spotify pauses). The visualizer and fades don't apply to Spotify audio. Restart Playnite after switching to this source so playback state is cleanly reset.
            </TextBlock>
            <CheckBox Content="Skip to a new Spotify track on each no-music game"
                      IsChecked="{Binding Settings.SpotifySkipOnGap}"
                      IsEnabled="{Binding Settings.DefaultMusicSourceOption, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Spotify}"
                      Margin="40,0,0,0"/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="60,2,0,5">
                Each time you select a game with no UniPlaySong music, advance Spotify to the next track instead of resuming the current one — a fresh song per game. Falls back to resuming if Spotify can't skip (e.g. end of queue).
            </TextBlock>

            <Separator Margin="0,15"/>

            <TextBlock Text="Play Methods" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,2"/>
            <TextBlock Text="Control which games get game-specific music. Non-matching games fall through to default music."
                       FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <CheckBox Content="Play Music Only for Installed Games"
                      IsChecked="{Binding Settings.MusicOnlyForInstalledGames}"
                      Margin="0,5"/>
            <TextBlock Text="When enabled, music only plays for selected games installed on your machine. Uninstalled games will use default music instead (or be silent if default music is off)."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,10"/>

            <!-- Play Only on Game Select -->
            <CheckBox Content="Play Only on Game Select [Fullscreen Mode]"
                      IsChecked="{Binding Settings.PlayOnlyOnGameSelect}"
                      Margin="0,5"/>
            <TextBlock Text="Game-specific music only plays when you explicitly select a game (A button). While browsing with D-pad, default music plays instead. Press B to return to default music."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,10"/>

            <!-- Nostalgia Mode -->
            <CheckBox Content="Nostalgia Mode"
                      IsChecked="{Binding Settings.NostalgiaMode}"
                      Margin="0,5"/>
            <TextBlock Text="Only play game-specific music for games that match selected completion statuses. Other games fall through to default music (or silence if default music is off)."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="20,4,0,0"
                        IsEnabled="{Binding Settings.NostalgiaMode}">
                <Button Content="Select Statuses..."
                        Command="{Binding SelectNostalgiaStatusesCommand}"
                        Padding="8,3" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding NostalgiaStatusSummary}"
                           FontSize="11"
                           Foreground="Gray"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock Margin="20,3,0,10" FontSize="11" Foreground="#90A8A0" FontStyle="Italic"
                       Text="Tip: Select 'Completed' to play only games you've finished — like a personal nostalgia playlist."/>

            <!-- Game Property Filter -->
            <CheckBox Content="Game Property Filter"
                      IsChecked="{Binding Settings.GamePropFilterEnabled}"
                      Margin="0,5"/>
            <TextBlock Text="Only play game-specific music for games matching selected platforms, genres, or sources (OR logic). Non-matching games fall through to default music."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,5"/>
            <StackPanel Margin="20,4,0,10"
                        IsEnabled="{Binding Settings.GamePropFilterEnabled}">
                <!-- Platforms row -->
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Button Content="Platforms..."
                            Command="{Binding SelectGamePropFilterPlatformsCommand}"
                            Width="90" Padding="4,3"/>
                    <TextBlock Text="{Binding GamePropFilterPlatformSummary}"
                               FontSize="11" Foreground="Gray"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <!-- Genres row -->
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Button Content="Genres..."
                            Command="{Binding SelectGamePropFilterGenresCommand}"
                            Width="90" Padding="4,3"/>
                    <TextBlock Text="{Binding GamePropFilterGenreSummary}"
                               FontSize="11" Foreground="Gray"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <!-- Sources row -->
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Button Content="Sources..."
                            Command="{Binding SelectGamePropFilterSourcesCommand}"
                            Width="90" Padding="4,3"/>
                    <TextBlock Text="{Binding GamePropFilterSourceSummary}"
                               FontSize="11" Foreground="Gray"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Margin="20,0,0,10" FontSize="11" Foreground="#90A8A0" FontStyle="Italic"
                       Text="Tip: Select 'PC' as a platform to hear music only when browsing PC games."/>

            <!-- Filter Mode -->
            <CheckBox Content="Filter Mode"
                      IsChecked="{Binding Settings.FilterModeEnabled}"
                      Margin="0,5"/>
            <TextBlock Text="Only play game-specific music when a Playnite filter preset is active. When browsing 'All Games' or using no filter, games fall through to default music."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,5"/>
            <TextBlock Margin="20,0,0,10" FontSize="11" Foreground="#90A8A0" FontStyle="Italic"
                       Text="Tip: Create a filter preset (e.g. 'RPGs') — music plays only while that filter is active."/>

            <!-- Radio Mode -->
            <CheckBox Content="Radio Mode"
                      IsChecked="{Binding Settings.RadioModeEnabled}"
                      Margin="0,5"/>
            <TextBlock Text="Ignore game selection entirely — music plays continuously from a fixed pool, like background radio. Overrides both game-specific and default music while active."
                       FontSize="11"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       Margin="20,0,0,5"/>
            <StackPanel Margin="20,4,0,10"
                        IsEnabled="{Binding Settings.RadioModeEnabled}">
                <RadioButton Content="Full Library (every downloaded song)"
                             IsChecked="{Binding Settings.RadioMusicSource, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=FullLibrary}"
                             Margin="0,2"/>
                <RadioButton Content="Custom Folder"
                             IsChecked="{Binding Settings.RadioMusicSource, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=CustomFolder}"
                             Margin="0,2"/>
                <!-- Radio's own custom folder (v1.5.8) — inside the RadioModeEnabled-gated group, so no own gate -->
                <StackPanel Orientation="Horizontal" Margin="20,2,0,0">
                    <TextBox Text="{Binding Settings.RadioCustomFolderPath}"
                             Width="330" Margin="0,0,10,0" IsReadOnly="True"/>
                    <Button Content="Browse..." Width="80"
                            Command="{Binding BrowseForRadioCustomFolder}"/>
                </StackPanel>
                <TextBlock Text="Plays random music from any audio files in the selected folder. If left empty, uses your Default Music folder."
                           FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="20,3,0,4"/>
                <RadioButton Content="Custom Game Rotation"
                             IsChecked="{Binding Settings.RadioMusicSource, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=CustomRotation}"
                             Margin="0,2"/>
                <RadioButton Content="Completion Status Pool"
                             IsChecked="{Binding Settings.RadioMusicSource, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=CompletionStatusPool}"
                             Margin="0,2"/>
                <RadioButton IsChecked="{Binding Settings.RadioMusicSource, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Spotify}"
                             Command="{Binding SetRestartRequired}"
                             CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                             Margin="0,2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource SpotifyLogoGeometry}"
                              Fill="#1DB954"
                              Stretch="Uniform"
                              Width="16" Height="16"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="Spotify (desktop app)" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
            <TextBlock Margin="20,0,0,10" FontSize="11" Foreground="#90A8A0" FontStyle="Italic"
                       Text="Tip: 'Full Library' shuffles every song you've downloaded. Other pool sources reuse your Default Music pool configuration."/>
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="20,0,0,5">
                'Spotify' plays the Spotify desktop app continuously as background music instead of a UPS pool. Requires the Spotify desktop app to be open. UPS pauses/resumes it on game launch, video, focus loss, and lock — it does not play Spotify's audio itself, so the visualizer and fades don't apply. Restart Playnite after selecting so playback state is cleanly reset.
            </TextBlock>

        </StackPanel>
    </ScrollViewer>
</UserControl>
