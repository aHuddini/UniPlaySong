<Window x:Class="UniPlaySong.DeskMediaControl.NowPlayingCard" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="340" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False" Topmost="False"
        Background="Transparent" Foreground="#F2F4F8" FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display">
    <!-- No window frame; the glass frame extends over the whole client area so Windows 11's acrylic backdrop shows -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- The card's own text style. Set explicitly on every TextBlock: a theme's global TextBlock style reaches text
             inside templates (list rows, footer links) past any implicit style here, so only an explicit one wins -->
        <Style x:Key="CardText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontStyle" Value="Normal"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <SolidColorBrush x:Key="Accent" Color="#5CC8FF"/>
        <!-- Icons as vector paths on a 16 x 16 grid -->
        <Geometry x:Key="IconPrev">M2,2 H4.2 V14 H2 Z M14,2.6 V13.4 L5.4,8 Z</Geometry>
        <Geometry x:Key="IconNext">M11.8,2 H14 V14 H11.8 Z M2,2.6 V13.4 L10.6,8 Z</Geometry>
        <Geometry x:Key="IconPause">M3,2 H6.6 V14 H3 Z M9.4,2 H13 V14 H9.4 Z</Geometry>
        <Geometry x:Key="IconPlay">M4.5,2 L14,8 L4.5,14 Z</Geometry>
        <!-- Radio Mode: a dot between two pairs of waves -->
        <Geometry x:Key="IconRadio">M6.1,8 A1.9,1.9 0 1 1 9.9,8 A1.9,1.9 0 1 1 6.1,8 Z M10.96,4.48 A4.6,4.6 0 0 1 10.96,11.52 L9.93,10.30 A3,3 0 0 0 9.93,5.70 Z M5.04,4.48 A4.6,4.6 0 0 0 5.04,11.52 L6.07,10.30 A3,3 0 0 1 6.07,5.70 Z M12.82,2.26 A7.5,7.5 0 0 1 12.82,13.74 L11.73,12.44 A5.8,5.8 0 0 0 11.73,3.56 Z M3.18,2.26 A7.5,7.5 0 0 0 3.18,13.74 L4.27,12.44 A5.8,5.8 0 0 1 4.27,3.56 Z</Geometry>
        <!-- Spotify's logomark, as on the settings pages (SettingsResources.xaml): green when on, grey when off -->
        <Geometry x:Key="IconSpotify">M84,0 C37.6,0 0,37.6 0,84 C0,130.4 37.6,168 84,168 C130.4,168 168,130.4 168,84 C168,37.6 130.4,0 84,0 Z M122.5,121.2 C121,123.7 117.8,124.4 115.4,122.9 C95.9,111 71.4,108.3 42.5,114.9 C39.7,115.5 37,113.8 36.3,111 C35.7,108.2 37.4,105.5 40.2,104.8 C71.8,97.6 98.9,100.7 120.8,114.1 C123.2,115.6 124,118.8 122.5,121.2 Z M132.8,98.3 C130.9,101.4 126.9,102.3 123.8,100.4 C101.5,86.7 67.5,82.7 41.1,90.7 C37.6,91.8 33.9,89.8 32.8,86.3 C31.8,82.8 33.8,79.1 37.3,78 C67.4,68.9 104.9,73.3 130.5,89.1 C133.6,91 134.6,95.1 132.8,98.3 Z M133.7,74.4 C107,58.5 62.9,57.1 37.4,64.8 C33.2,66.1 28.8,63.7 27.5,59.5 C26.3,55.3 28.7,50.9 32.9,49.6 C62.2,40.7 110.9,42.4 141.6,60.6 C145.4,62.9 146.6,67.8 144.4,71.5 C142.2,75.3 137.4,76.6 133.7,74.4 Z</Geometry>
        <Geometry x:Key="IconMoon">M10.6,1.4 A6.8,6.8 0 1 0 14.6,11 A5.6,5.6 0 0 1 10.6,1.4 Z</Geometry>
        <!-- A window with an arrow leaving its corner -->
        <Geometry x:Key="IconPopOut">F1 M2,4 H7.5 V5.5 H3.5 V12.5 H10.5 V8.5 H12 V14 H2 Z M9,2 H14 V7 H12.5 V4.6 L7.6,9.5 L6.5,8.4 L11.4,3.5 H9 Z</Geometry>
        <Geometry x:Key="IconPin">M10.5,1.5 L14.5,5.5 L12.9,6.1 L10.3,8.7 L10.6,11.9 L9.3,13.2 L6.5,10.4 L2.9,14 L2,13.1 L5.6,9.5 L2.8,6.7 L4.1,5.4 L7.3,5.7 L9.9,3.1 Z</Geometry>
        <Geometry x:Key="IconNowPlaying">M1,9 H4 V15 H1 Z M6.5,3 H9.5 V15 H6.5 Z M12,6 H15 V15 H12 Z</Geometry>
        <Geometry x:Key="IconChevronUp">M2.5,10.5 L8,5 L13.5,10.5 L12.4,11.6 L8,7.2 L3.6,11.6 Z</Geometry>
        <Geometry x:Key="IconChevronDown">M2.5,5.5 L8,11 L13.5,5.5 L12.4,4.4 L8,8.8 L3.6,4.4 Z</Geometry>
        <Geometry x:Key="IconSpeakerMuted">M1.5,5.5 H4.5 L8.5,2 V14 L4.5,10.5 H1.5 Z M10.6,6.85 L11.45,6 L14.9,9.45 L14.05,10.3 Z M14.05,6 L14.9,6.85 L11.45,10.3 L10.6,9.45 Z</Geometry>
        <Geometry x:Key="IconSpeaker">M1.5,5.5 H4.5 L8.5,2 V14 L4.5,10.5 H1.5 Z M10.5,5.2 A3.6,3.6 0 0 1 10.5,10.8 L11.4,11.8 A5,5 0 0 0 11.4,4.2 Z</Geometry>
        <!-- Three faders, knobs at different heights (F1: overlapping parts fill rather than cancel) -->
        <Geometry x:Key="IconEqualizer">F1 M2.4,1 H4.6 V15 H2.4 Z M1,8.6 H6 V11.4 H1 Z M6.9,1 H9.1 V15 H6.9 Z M5.5,3.8 H10.5 V6.6 H5.5 Z M11.4,1 H13.6 V15 H11.4 Z M10,10.2 H15 V13 H10 Z</Geometry>
        <!-- The game's primary song: its title (and the playing marker, when it plays) in this colour -->
        <SolidColorBrush x:Key="PrimaryTint" Color="#E9A8F2"/>

        <!-- The song list's right-click menu, drawn like the card (a theme's menu styles would otherwise apply) -->
        <Style x:Key="CardMenu" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#F2191D26" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" Padding="4">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardMenuItem" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="10,6">
                            <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" Foreground="#F2F4F8"
                                       FontFamily="Segoe UI" FontSize="12.5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Geometry x:Key="IconFolder">M1.5,3.5 A1,1 0 0 1 2.5,2.5 H6.1 L7.6,4.1 H13.5 A1,1 0 0 1 14.5,5.1 V12.5 A1,1 0 0 1 13.5,13.5 H2.5 A1,1 0 0 1 1.5,12.5 Z</Geometry>

        <!-- Round icon button: equal square box, icon centred; Tag carries the geometry -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="14">
                            <Path Data="{TemplateBinding Tag}" Fill="{TemplateBinding Foreground}" Stretch="Uniform"
                                  Width="{TemplateBinding FontSize}" Height="{TemplateBinding FontSize}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#26FFFFFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="SmallIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Foreground" Value="#1B1E26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#F0FFFFFF" CornerRadius="15">
                            <Path Data="{TemplateBinding Tag}" Fill="{TemplateBinding Foreground}" Stretch="Uniform"
                                  Width="{TemplateBinding FontSize}" Height="{TemplateBinding FontSize}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#FFFFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A footer action: icon + text, no chrome -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#D9F2F4F8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="5" Padding="4,3">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{TemplateBinding Tag}" Fill="{TemplateBinding Foreground}" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Style="{StaticResource CardText}" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="Visible"/>

        <!-- Slim scrollbar: a thumb only, no arrows or track -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#4DFFFFFF" CornerRadius="3" Margin="1,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Glass edge: a rim that catches the light at the top left and fades around the card, plus a faint inner sheen
         along the top. Corners stay at Windows' own 8 px, the only radius it draws anti-aliased. -->
    <Border x:Name="Frame" CornerRadius="8" BorderThickness="1" ClipToBounds="True">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:Name="RimTopLeft" Color="#14FFFFFF" Offset="0"/>
                <GradientStop x:Name="RimMid" Color="#05FFFFFF" Offset="0.45"/>
                <GradientStop x:Name="RimEnd" Color="#0FFFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Grid>
        <!-- Backdrop: the look's layers, bottom to top. A banner look sizes it to the banner; a whole-card look lets it
             fill the card, so banner and list are one surface. Bitmaps and brushes only, no effects. -->
        <Grid x:Name="Backdrop" VerticalAlignment="Top" IsHitTestVisible="False" ClipToBounds="True">
            <!-- Progressive blur: the heavily blurred art everywhere, the lightly blurred art over it fading out towards
                 the bottom. Both prepared once per game and look. -->
            <Rectangle>
                <Rectangle.Fill>
                    <ImageBrush x:Name="BannerArt" ImageSource="{Binding Banner}" Stretch="UniformToFill"/>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <ImageBrush x:Name="BannerArtSharp" ImageSource="{Binding BannerSharp}" Stretch="UniformToFill"/>
                </Rectangle.Fill>
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF000000" Offset="0"/>
                        <GradientStop x:Name="MaskMid" Color="#8A000000" Offset="0.51"/>
                        <GradientStop x:Name="MaskEnd" Color="#00000000" Offset="0.65"/>
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <!-- Tint: the art's two colours, vivid top left, dark bottom right; both fade between songs -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="TintStopVivid" Color="#00000000" Offset="0"/>
                        <GradientStop x:Name="TintStopDark" Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="Veil"/>
            <!-- The list alone: starts where the banner ends (whole-card looks) -->
            <Rectangle x:Name="ListShade"/>
            <!-- Vignette: edges and corners darkened, the centre left lit -->
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush x:Name="Vignette" Center="0.5,0.31" GradientOrigin="0.5,0.31" RadiusX="0.89" RadiusY="0.85">
                        <GradientStop x:Name="VignetteClear" Color="#00000000" Offset="0.34"/>
                        <GradientStop x:Name="VignetteMid" Color="#78000000" Offset="0.75"/>
                        <GradientStop x:Name="VignetteEdge" Color="#69000000" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- Frost (a milky layer, so glass reads lighter than what's behind it) and grain (breaks up banding) -->
            <Rectangle x:Name="Frost"/>
            <Rectangle x:Name="Grain" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Grid>
        <StackPanel>
            <!-- Banner: song centred (title up to two lines, artist only when there is one), transport row below, then a
                 clear gap above the progress edge. Its backdrop is the Backdrop above. -->
            <Grid x:Name="BannerArea" Background="Transparent" MouseRightButtonUp="Banner_RightClick">
            <Grid x:Name="BannerVeil" ClipToBounds="True">
                <!-- Toggles, grey off and blue on: modes on the left (as Aniki ReMake groups them), audio and the pin on the right -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0">
                    <Button x:Name="RadioModeButton" Style="{StaticResource SmallIconButton}" Tag="{StaticResource IconRadio}" ToolTip="Radio Mode"
                            Click="Radio_Click" Foreground="#8A8F9A" FontSize="15"/>
                    <Button x:Name="SpotifyButton" Style="{StaticResource SmallIconButton}" Tag="{StaticResource IconSpotify}" ToolTip="Radio plays Spotify"
                            Click="Spotify_Click" Foreground="#8A8F9A" FontSize="13"/>
                    <Button x:Name="CalmDownButton" Style="{StaticResource SmallIconButton}" Tag="{StaticResource IconMoon}" ToolTip="Calm Down" Click="CalmDown_Click" Foreground="#8A8F9A"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
                    <Button x:Name="EqButton" Style="{StaticResource SmallIconButton}" Tag="{StaticResource IconEqualizer}" ToolTip="Equalizer"
                            Click="Eq_Click" Foreground="#8A8F9A" FontSize="13"/>
                    <Button x:Name="FxButton" Style="{StaticResource SmallIconButton}" ToolTip="Live Effects"
                            Click="Fx_Click" Foreground="#8A8F9A" FontSize="13"/>
                    <Button x:Name="PinButton" Style="{StaticResource SmallIconButton}" Tag="{StaticResource IconPin}" ToolTip="Pin: keep the card open"
                            Click="Pin_Click" Foreground="#8A8F9A"/>
                </StackPanel>

                <StackPanel Margin="14,12,14,13">
                    <TextBlock Style="{StaticResource CardText}" Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" LineHeight="18" LineStackingStrategy="BlockLineHeight"
                               TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" Margin="70,0"/>
                    <TextBlock Text="{Binding Artist}" Opacity="0.75" LineHeight="16" LineStackingStrategy="BlockLineHeight"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="70,1,70,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CardText}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid Margin="0,10,0,0" Height="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CardText}" Text="{Binding Position}" FontSize="10.5" Opacity="0.7" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconPrev}" ToolTip="Previous" Click="Previous_Click"/>
                            <Button x:Name="PlayPauseButton" Style="{StaticResource PrimaryButton}" Tag="{StaticResource IconPause}" Click="PlayPause_Click"/>
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconNext}" ToolTip="Next" Click="Next_Click"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource CardText}" Grid.Column="2" Text="{Binding Duration}" FontSize="10.5" Opacity="0.7" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>

                <!-- Progress line; click or drag to seek where the song allows it (12 px hit strip, thicker on hover) -->
                <Grid x:Name="SeekStrip" VerticalAlignment="Bottom" Height="12" Background="Transparent"
                      MouseLeftButtonDown="Seek_MouseDown" MouseMove="Seek_MouseMove" MouseLeftButtonUp="Seek_MouseUp"
                      LostMouseCapture="Seek_LostCapture">
                    <Grid x:Name="SeekLine" VerticalAlignment="Bottom" Height="3">
                        <Rectangle Fill="#2EFFFFFF"/>
                        <Rectangle Fill="#E6FFFFFF" RenderTransformOrigin="0,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="ProgressScale" ScaleX="0"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </Grid>
            </Grid>
            </Grid>

            <!-- Context-aware list -->
            <StackPanel Margin="14,0,14,0" Visibility="{Binding ShowList, Converter={StaticResource Visible}}">
                <TextBlock Style="{StaticResource CardText}" Text="{Binding ListHeader}" FontSize="10" Opacity="0.6" Margin="0,10,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Volume: a slim vertical slider down the list's left edge (folds away with the list); drag or wheel.
                         At least 96 px tall, so a one-song list still gets a usable track.
                         Music Volume, applied live while dragging and saved on release. The slider hides while Spotify
                         plays (its volume isn't ours to set); the mute below it stays, muting Spotify's own audio. -->
                    <Grid x:Name="VolumeColumn" Width="18" Margin="-6,2,6,2" MinHeight="96">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid x:Name="VolumeTrack" Background="Transparent" Cursor="Hand"
                              Visibility="{Binding CanSetVolume, Converter={StaticResource Visible}}"
                              MouseLeftButtonDown="Volume_MouseDown" MouseMove="Volume_MouseMove" MouseLeftButtonUp="Volume_MouseUp"
                              LostMouseCapture="Volume_LostCapture" MouseWheel="Volume_Wheel">
                            <Border Width="4" CornerRadius="2" Background="#2EFFFFFF" HorizontalAlignment="Center"/>
                            <Border x:Name="VolumeFill" Width="4" CornerRadius="2" Background="{StaticResource Accent}"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="0"/>
                            <Ellipse x:Name="VolumeThumb" Width="10" Height="10" Fill="#F2F4F8" HorizontalAlignment="Center"
                                     VerticalAlignment="Bottom"/>
                        </Grid>
                        <!-- Mute toggle: blue speaker-with-X while muted. Under the slider; centred in the column when the
                             slider is hidden (Spotify) -->
                        <Button x:Name="MuteButton" Tag="{StaticResource IconSpeaker}"
                                Width="18" Height="18" FontSize="11" HorizontalAlignment="Center"
                                Foreground="#99F2F4F8" ToolTip="Mute" Click="Mute_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SmallIconButton}">
                                    <Setter Property="Grid.Row" Value="1"/>
                                    <Setter Property="Margin" Value="0,2,0,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanSetVolume}" Value="False">
                                            <Setter Property="Grid.Row" Value="0"/>
                                            <Setter Property="Grid.RowSpan" Value="2"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                <ScrollViewer Grid.Column="1" x:Name="TrackScroll" MaxHeight="128" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl x:Name="TrackList" ItemsSource="{Binding Tracks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="Track_Click" MouseRightButtonUp="Track_RightClick" Focusable="False" Cursor="Hand" IsEnabled="{Binding Playable}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Row" Background="Transparent" CornerRadius="5" Padding="6,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Now-playing bars, still. While the song plays and the card is open, CompositionBars draws
                                                         bouncing bars in their place (compositor-animated) and these hide -->
                                                    <StackPanel x:Name="NowIcon" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                Height="10" Visibility="Hidden">
                                                        <Rectangle x:Name="Bar1" Width="2.4" Height="10" Fill="{StaticResource Accent}" VerticalAlignment="Bottom"
                                                                   RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.55"/></Rectangle.RenderTransform></Rectangle>
                                                        <Rectangle x:Name="Bar2" Width="2.4" Height="10" Fill="{StaticResource Accent}" VerticalAlignment="Bottom" Margin="1.4,0"
                                                                   RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="1"/></Rectangle.RenderTransform></Rectangle>
                                                        <Rectangle x:Name="Bar3" Width="2.4" Height="10" Fill="{StaticResource Accent}" VerticalAlignment="Bottom"
                                                                   RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.75"/></Rectangle.RenderTransform></Rectangle>
                                                    </StackPanel>
                                                    <TextBlock x:Name="RowTitle" Style="{StaticResource CardText}" Grid.Column="1" Text="{Binding Title}" Opacity="0.82"/>
                                                    <TextBlock Style="{StaticResource CardText}" Grid.Column="2" Text="{Binding Detail}" Opacity="0.5" Margin="10,0,0,0" MaxWidth="90"/>
                                                    <TextBlock Style="{StaticResource CardText}" Grid.Column="3" Text="{Binding Length}" Opacity="0.5" Margin="10,0,0,0"
                                                               FontSize="11" VerticalAlignment="Center" TextTrimming="None"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter TargetName="RowTitle" Property="Foreground" Value="{StaticResource Accent}"/>
                                                    <Setter TargetName="RowTitle" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="NowIcon" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                    <Setter TargetName="RowTitle" Property="Foreground" Value="{StaticResource PrimaryTint}"/>
                                                    <Setter TargetName="RowTitle" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="RowTitle" Property="ToolTip" Value="Primary song"/>
                                                    <Setter TargetName="Bar1" Property="Fill" Value="{StaticResource PrimaryTint}"/>
                                                    <Setter TargetName="Bar2" Property="Fill" Value="{StaticResource PrimaryTint}"/>
                                                    <Setter TargetName="Bar3" Property="Fill" Value="{StaticResource PrimaryTint}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#12FFFFFF"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Grid>
            </StackPanel>

            <!-- Footer -->
            <Grid Margin="14,8,14,0">
                <!-- Separator with the collapser in a gap in the middle of the line: a bare chevron, no chrome -->
                <Grid VerticalAlignment="Top" Height="14" Margin="0,-7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Line halves around the chevron, only while the list shows: collapsed, the footer sits right under
                         the banner and a line there is clutter -->
                    <Rectangle Height="1" Fill="#1AFFFFFF" VerticalAlignment="Center"
                               Visibility="{Binding ShowList, Converter={StaticResource Visible}}"/>
                    <Button x:Name="CollapseButton" Grid.Column="1" Width="28" Height="14" Focusable="False" Cursor="Hand" Click="Collapse_Click"
                            Visibility="{Binding HasList, Converter={StaticResource Visible}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <Path x:Name="Chevron" Data="{TemplateBinding Tag}" Fill="#99F2F4F8" Stretch="Uniform" Width="10" Height="10"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chevron" Property="Fill" Value="#FFFFFFFF"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Rectangle Grid.Column="2" Height="1" Fill="#1AFFFFFF" VerticalAlignment="Center"
                               Visibility="{Binding ShowList, Converter={StaticResource Visible}}"/>
                </Grid>
            <Border Padding="0,5,0,9" Margin="0,1,0,0">
                <DockPanel LastChildFill="False">
                    <Button Style="{StaticResource LinkButton}" Tag="{StaticResource IconFolder}" Content="Open music folder"
                            IsEnabled="{Binding CanOpenFolder}" Click="OpenFolder_Click" Margin="-4,0,0,0"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Tag="{StaticResource IconPopOut}" Content="Pop out"
                            IsEnabled="False" ToolTip="Coming in a later update" ToolTipService.ShowOnDisabled="True" Margin="0,0,-4,0"/>
                </DockPanel>
            </Border>
            </Grid>
        </StackPanel>
            <Border CornerRadius="7" BorderThickness="1" IsHitTestVisible="False">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#26FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.35"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>
        </Grid>
    </Border>
</Window>
