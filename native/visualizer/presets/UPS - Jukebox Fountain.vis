#define DET_HAT_SPLIT uP[140]
float hash(vec2 q) { return fract(sin(dot(q, vec2(12.9898, 78.233))) * 43758.5453); }
// ---- the PSP's visualizers ----
float pspBand(float x) { float f = clamp(x, 0.0, 1.0) * 47.0; int i = int(f); return mix(uPsp[i], uPsp[min(i + 1, 47)], fract(f)); }
float vnoise(vec2 p) { vec2 i = floor(p), f = fract(p); f = f * f * (3.0 - 2.0 * f);
  return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y); }
float fbm(vec2 p) { float v = 0.0, a = 0.5; for (int k = 0; k < 4; k++) { v += a * vnoise(p); p *= 2.03; a *= 0.5; } return v; }
// 1 dot spectrum - the firmware's LED meter, drawn as it draws it, in the PSP's 480x272 pixels (scaled to the height,
// centred): 12 columns 37 px apart from x 18, 8 rows 21 px apart from y 209 up, each LED a 38 px sprite. Rows 0-3 use
// the blue LED, 4-6 the yellow, 7 the red. Both layers add: the unlit pill at alpha max(b, 32) and the lit pill at
// b^2/255, b the LED's brightness. Last, the XMB theme colour washes over the whole screen, additively, 0.3 of it at the
// top left to 0.65 at the bottom right, at alpha 0.7. Pill colours are the textures' (music_tex_led_*), measured; so is
// their luster (a lighter 1 px band along the top edge, a reflection along the bottom, a white line through the lit
// core). Edges are anti-aliased in screen pixels, so the meter stays as crisp as on the PSP's own small screen. The HD
// grid packs 24 x 16 smaller LEDs into the same space.
float sdRBox(vec2 p, vec2 h, float r) { vec2 q = abs(p) - h + r; return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r; }
vec3 ledMeter(vec2 q, float sc, float refl) {   // refl: 1 = as seen in the floor (lit LEDs only, softer)
  float C = uLedGrid.x, R = uLedGrid.y, k = 12.0 / C;        // k: the LED's size against the firmware's
  float px = 37.0 * k, py = 21.0 * 8.0 / R, aa = mix(0.75 / sc, 1.2 * k, refl);
  vec3 col = vec3(0.0);
  float ci = floor((q.x - 18.0 * k - 18.5 * k + px * 0.5) / px), ri = floor((227.0 + py * 0.5 - q.y) / py);
  for (int dr = -2; dr <= 2; dr++) for (int dc = -2; dc <= 2; dc++) {
    float c = ci + float(dc), r = ri + float(dr);
    if (c < 0.0 || c > C - 1.0 || r < 0.0 || r > R - 1.0) continue;
    float b = texelFetch(uLedTex, ivec2(int(c), int(r)), 0).r;
    vec2 p = q - vec2(18.0 * k + 18.5 * k + px * c, 227.0 - py * r);
    vec3 body, core, halo;
    if (PSP_PALCOL > 0.5) {
      float t = r / max(R - 1.0, 1.0);
      vec3 hue = t < 0.5 ? mix(uMeterLo, uMeterMid, t * 2.0) : mix(uMeterMid, uMeterHi, t * 2.0 - 1.0);
      body = hue * 0.68; core = mix(hue, vec3(1.0), 0.82); halo = hue;
    } else {
      float band = r / R;
      body = band >= 0.875 ? vec3(181, 30, 27) : band >= 0.5 ? vec3(190, 141, 43) : vec3(61, 171, 140);
      core = band >= 0.875 ? vec3(251, 222, 221) : band >= 0.5 ? vec3(216, 196, 170) : vec3(213, 243, 240);
      halo = band >= 0.875 ? vec3(229, 30, 22) : band >= 0.5 ? vec3(241, 145, 24) : vec3(86, 190, 191);
      body /= 255.0; core /= 255.0; halo /= 255.0;
    }
    float hy = 3.5 * k;
    float d = sdRBox(p, vec2(5.5, 3.5) * k, 2.0 * k), dc2 = sdRBox(p, vec2(4.0, 2.0) * k, 1.5 * k);
    float inBody = smoothstep(aa, -aa, d), rim = smoothstep(-1.5 * k, -0.5 * k, d);
    // the luster: v runs -1 at the pill's top edge to 1 at its bottom; a highlight band just inside the top, a fainter
    // reflection just inside the bottom (the textures' lighter edge rows)
    float v = p.y / hy, shine = exp(-pow((v + 0.72) / 0.2, 2.0)) + 0.6 * exp(-pow((v - 0.74) / 0.2, 2.0));
    vec3 sheenCol = mix(body * 1.4, vec3(1.0), 0.45);
    // unlit pill: the body colour, its 1 px rim dark, the luster on top
    vec3 norml = (body * mix(0.7, 0.25, rim) + sheenCol * shine * PSP_SHEEN * 0.9) * inBody;
    // lit pill: a near-white core (white along its middle), a saturated rim, and the halo fading out over ~12 px
    vec3 lit = (mix(halo, mix(core, vec3(1.0), smoothstep(1.0 * k, 0.0, abs(p.y + 0.5 * k))), smoothstep(aa, -aa, dc2))
                + vec3(1.0) * shine * max(0.0, PSP_SHEEN - 0.5) * 0.8) * inBody
             + halo * (1.0 - inBody) * (0.52 * pow(max(0.0, 1.0 - max(d, 0.0) / (12.0 * k)), 1.3)
                                        + PSP_BLOOM * 0.22 * exp(-max(d, 0.0) / (9.0 * k)));
    col += norml * max(b, 32.0) / 255.0 * (1.0 - refl) + lit * b * b / 65025.0;
    // metal bezel: a thin ring round the pill, lit from above
    if (PSP_GLINT > 0.0 && refl < 0.5) {
      float bez = smoothstep(1.4 * k, 0.6 * k, d) * smoothstep(-aa, aa, d);
      col += vec3(0.55, 0.58, 0.64) * (0.35 + 0.65 * smoothstep(0.8, -1.0, v)) * bez * 0.35 * PSP_GLINT;
    }
  }
  return col;
}
vec3 pspDots() {
  float sc = uRes.y / 272.0;
  vec2 q = vec2((gl_FragCoord.x - uRes.x * 0.5) / sc + 240.0, 272.0 - gl_FragCoord.y / sc);   // PSP pixels, y down
  // the glossy floor: the meter lifts to make room, and below its foot the floor reflects it - only the lit LEDs and
  // their glow (the dim pills don't show in a reflection), squashed by the viewing angle, softened, fading with depth
  float lift = PSP_FLOOR > 0.0 ? 26.0 : 0.0;
  vec3 col = ledMeter(q + vec2(0.0, lift), sc, 0.0);
  if (PSP_FLOOR > 0.0) {
    float yF = 227.0 + 21.0 * 8.0 / uLedGrid.y * 0.5 + 3.0 - lift;
    if (q.y > yF) {
      float dy = q.y - yF; vec2 qr = vec2(q.x, yF - dy * 1.35 + lift);
      vec3 r = ledMeter(qr, sc, 1.0) * 0.5 + (ledMeter(qr + vec2(0.0, 2.0), sc, 1.0) + ledMeter(qr - vec2(0.0, 2.0), sc, 1.0)) * 0.25;
      col += r * PSP_FLOOR * 0.4 * exp(-dy / 26.0);
    }
  }
  // the theme wash (the PSP's XMB colour - the user's theme on a PSP; a cool silver-blue here, at a third of the
  // firmware's strength since the PSP's own colour value isn't known)
  vec2 uvw = gl_FragCoord.xy / uRes;
  col += vec3(0.55, 0.62, 0.75) * mix(mix(0.5, 0.65, uvw.x), mix(0.3, 0.4, uvw.x), uvw.y) * 0.7 * 0.35 * PSP_WASH;
  // the PSP screen's backlight: it shows through the black, a little brighter toward the edges, slightly cool
  if (PSP_LCD > 0.0) {
    vec2 e2 = abs(q / vec2(480.0, 272.0) - 0.5) * 2.0;
    col += vec3(0.018, 0.022, 0.032) * (1.0 + 0.8 * pow(max(e2.x, e2.y), 3.0)) * PSP_LCD;
  }
  return col;
}
// 2 glowing strings: 14 thin lines pinned at both ends, swelling toward the middle, each a pair of moving waves sized by
// its own band; dense crossings run white; the hue drifts blue -> violet -> pink over a minute and a half
vec3 pspStrings() {
  vec2 uv = gl_FragCoord.xy / uRes;
  vec3 hueC = uPspHue < 0.5 ? mix(vec3(0.25, 0.5, 1.0), vec3(0.55, 0.35, 1.0), uPspHue * 2.0) : mix(vec3(0.55, 0.35, 1.0), vec3(1.0, 0.35, 0.7), uPspHue * 2.0 - 1.0);
  vec3 col = vec3(0.05, 0.05, 0.06);
  float x0 = 0.04, x1 = 0.96, xs = (uv.x - x0) / (x1 - x0);
  if (xs < 0.0 || xs > 1.0) return col;
  float acc = 0.0, e = 0.002;
  for (int i = 0; i < 14; i++) {
    float fi = float(i), h1 = fract(sin(fi * 12.9898) * 43758.5), h2 = fract(sin(fi * 78.233) * 43758.5);
    float amp = (0.03 + 0.28 * clamp(pspBand(fi / 14.0) * PSP_GAIN, 0.0, 1.2)) * (0.6 + 0.4 * h1);
    float k1 = 2.0 + floor(h1 * 3.0), k2 = 4.0 + floor(h2 * 4.0), ph = uTime * (0.8 + h2 * 1.6) + fi * 1.7;
    float ya = 0.5 + pow(sin(3.14159 * xs), 1.3) * amp * (0.7 * sin(k1 * 3.14159 * xs + ph) + 0.3 * sin(k2 * 3.14159 * xs - ph * 1.3));
    float xb = xs + e, yb = 0.5 + pow(sin(3.14159 * xb), 1.3) * amp * (0.7 * sin(k1 * 3.14159 * xb + ph) + 0.3 * sin(k2 * 3.14159 * xb - ph * 1.3));
    float slope = (yb - ya) * uRes.y / (e * (x1 - x0) * uRes.x), d = abs(uv.y - ya) * uRes.y / sqrt(1.0 + slope * slope);
    acc += exp(-d * d / 1.2) * 0.9 + exp(-d / 5.0) * 0.1;
  }
  return col + hueC * (1.0 - exp(-acc * 0.9)) + vec3(1.0) * smoothstep(1.5, 4.0, acc) * 0.45;
}
// 3 swirl: underwater blue; a ring of cyan specks turning round a slowly wandering centre (wider with the bass), the
// turn tighter near the centre, and loose specks drifting along the bottom
vec3 pspSwirl() {
  vec2 uv = gl_FragCoord.xy / uRes, p = (uv - 0.5) * vec2(uRes.x / uRes.y, 1.0);
  float bass = 0.0; for (int k = 0; k < 8; k++) bass += uPsp[k] / 8.0;
  bass = clamp(bass * PSP_GAIN, 0.0, 1.0);
  vec2 q = p - vec2(0.15 * sin(uTime * 0.23), 0.08 * cos(uTime * 0.31));
  float r = length(q), a = atan(q.y, q.x) + uTime * 0.35 + 0.25 / (r + 0.1);
  vec2 w = vec2(cos(a), sin(a)) * r;
  float ring = exp(-pow((r - (0.17 + 0.09 * bass)) / (0.08 + 0.04 * bass), 2.0));
  float cloud = ring * smoothstep(0.4, 0.8, fbm(w * 5.0 + uTime * 0.1));
  // specks: one round point per cell of the turning space, some cells empty, each twinkling at its own pace
  vec2 sc = w * 34.0 + vec2(uTime * 0.6, 0.0), sci = floor(sc), sco = vec2(hash(sci), hash(sci + 7.1));
  float sd = length(fract(sc) - (0.25 + 0.5 * sco)), on1 = step(0.45, hash(sci + 3.3)) * (0.6 + 0.4 * sin(uTime * 3.0 + sco.x * 20.0));
  float specks = smoothstep(0.22, 0.05, sd) * on1 * (ring * 1.3 + 0.35 * smoothstep(0.0, -0.45, p.y));
  // smoke colours by place and slow time, like the firmware thumbnail: red, magenta, violet, blue, yellow
  float hh = fbm(p * 1.6 + vec2(uTime * 0.05, -uTime * 0.04)) * 1.6 + uTime * 0.02;
  vec3 smoke = 0.5 + 0.5 * cos(6.2832 * (hh + vec3(0.0, 0.33, 0.67)));
  smoke = mix(smoke, vec3(1.0, 0.25, 0.5), 0.25);
  vec3 col = vec3(0.02, 0.015, 0.03) + smoke * 0.18 * smoothstep(0.9, 0.0, length(p));
  return col + smoke * cloud * (0.7 + clamp(uLevel * 1.5, 0.0, 0.8)) + mix(smoke, vec3(1.0), 0.6) * specks * 0.6;
}
// 4 tile band: square tiles in a band across pale sky blue. Two rows always on; each column grows up by its level and
// down by a neighbouring band's; pale tiles show where the level just was (its falling peak)
vec3 pspTiles() {
  vec2 uv = gl_FragCoord.xy / uRes;
  vec3 bg = mix(mix(vec3(0.80, 0.91, 0.98), vec3(0.70, 0.86, 0.97), uv.y), vec3(0.82, 0.82, 0.83), uPspHue);
  vec3 tc = mix(vec3(0.16, 0.6, 0.92), vec3(0.86, 0.22, 0.42), uPspHue);
  float cell = uRes.y / 22.0, cols = floor(uRes.x / cell);
  vec2 tp = gl_FragCoord.xy - vec2((uRes.x - cols * cell) * 0.5, 0.0), ci = floor(tp / cell), f = fract(tp / cell);
  if (ci.x < 0.0 || ci.x >= cols) return bg;
  float rel = ci.y - floor(uRes.y * 0.45 / cell), x = (ci.x + 0.5) / cols, x2 = fract(x * 1.7 + 0.3);
  float lv = rel >= 0.0 ? pspBand(x) * 2.5 : pspBand(x2) * 1.5, k = rel >= 0.0 ? rel : -rel - 1.0;
  float pk = (rel >= 0.0 ? uPspPk[int(x * 47.0)] * 2.5 : uPspPk[int(x2 * 47.0)] * 1.5) * PSP_GAIN;
  lv *= PSP_GAIN;
  float solid = k < 1.0 ? 1.0 : step(k, lv), pale = (1.0 - solid) * step(k, pk + 0.5);
  float tile = step(0.08, f.x) * step(f.x, 0.92) * step(0.08, f.y) * step(f.y, 0.92);
  return mix(mix(bg, tc, tile * solid), mix(bg, tc, 0.4), tile * pale);
}
// 5 light trail: one glowing ribbon looping over lime green - two slow sweeps and a small curl - thin and fading behind
vec3 pspTrail() {
  vec2 uv = gl_FragCoord.xy / uRes, p = (uv - 0.5) * vec2(uRes.x / uRes.y, 1.0);
  vec3 col = mix(vec3(0.62, 0.78, 0.1), vec3(0.8, 0.9, 0.25), smoothstep(0.9, 0.0, length(p)));
  float acc = 0.0;
  for (int i = 0; i < 47; i++) {
    vec2 a = uTrail[i], b = uTrail[i + 1], ab = b - a;
    float h = clamp(dot(p - a, ab) / max(dot(ab, ab), 1e-6), 0.0, 1.0), d = length(p - a - ab * h);
    float age = (float(i) + h) / 47.0, wd = mix(0.014, 0.003, age);
    acc += (exp(-d * d / (wd * wd)) * 0.7 + exp(-d / 0.03) * 0.03) * pow(1.0 - age, 1.5);
  }
  return col + vec3(1.0, 1.0, 0.85) * min(acc, 1.2) * 0.85;
}
void main() {
  if (PSP > 0.5) { outColor = vec4(clamp(PSP < 1.5 ? pspDots() : PSP < 2.5 ? pspStrings() : PSP < 3.5 ? pspSwirl() : PSP < 4.5 ? pspTiles() : pspTrail(), 0.0, 1.0), 1.0); return; }
  vec2 uv0 = gl_FragCoord.xy / uRes, cc = uv0 - 0.5;
  // CRT: a slight curve, the picture bulging toward the viewer
  vec2 uv = 0.5 + cc * (1.0 + CRT * 0.12 * dot(cc, cc));
  // heat haze: the air shimmers - more above the line, and the hotter and louder the music runs
  float hz = HAZE * (uv.y > 0.5 ? 1.0 : 0.45) * clamp(uWarm * 0.7 + uLevel * 1.5, 0.0, 1.0);
  vec2 suv = uv + hz * 0.006 * vec2(sin(uv.y * 70.0 + uTime * 3.1 + sin(uv.x * 23.0 + uTime)), 0.5 * sin(uv.x * 55.0 - uTime * 2.3));
  // wind: the fountain leans - the further from the line, the further over - in a gust that swings with the stereo side
  suv.x += WIND * 0.22 * (uv.y - 0.5) * (0.45 + 0.35 * sin(uTime * 0.7) + 0.6 * uBalC);
  // gravity well: the cover is a mass - each point's light comes from nearer the centre and turned a little, so the
  // picture stretches and swirls around the cover
  if (WELL > 0.0) {
    vec2 cv = (suv - 0.5) * vec2(uRes.x / uRes.y, 1.0); float rw = length(cv);
    float pull = WELL * 0.014 / max(rw, 0.12), tw = WELL * 0.05 / max(rw, 0.12);
    cv = (cv - normalize(cv) * pull) * mat2(cos(tw), -sin(tw), sin(tw), cos(tw));
    suv = cv / vec2(uRes.x / uRes.y, 1.0) + 0.5;
  }
  // in pixels no wider than at 2050 px, as the dots (scene shader)
  vec2 o = vec2(FRINGE * smoothstep(0.2, 1.0, length(suv - 0.5) * 2.0) * min(1.0, 2050.0 / uRes.x), 0.0);
  vec3 c = vec3(texture(uScene, suv + o).r, texture(uScene, suv).g, texture(uScene, suv - o).b);
  vec3 b1 = texture(uB1, suv).rgb, b2 = texture(uB2, suv).rgb, b3 = texture(uB3, suv).rgb;
  // zoom pulse: on the bar's ONE, a radial blur outward from the cover (uZoom is eased in and out)
  if (uZoom > 0.001) {
    vec3 zs = c; float wsum = 1.0;
    for (float k = 1.0; k <= 8.0; k += 1.0) { float w = 1.0 - k / 9.0; zs += texture(uScene, mix(suv, vec2(0.5), k * 0.012 * uZoom)).rgb * w; wsum += w; }
    c = zs / wsum;
  }
  // water surface: below the water line the picture becomes the fountain's reflection - mirrored about the line,
  // wavering sideways more with depth (and with the Liquid surface), cooler and dimmer. The fountain is symmetric about
  // its line, so a reflection drawn further down only landed on its own lower half; this replaces that half instead
  float wl = 0.5 - REFLECT_Y;
  if (REFLECT > 0.0 && uv.y < wl) {
    float dd = wl - uv.y;
    vec2 ruv = vec2(uv.x + (0.25 + 0.75 * REFLECT_RIPPLE) * (0.002 + 0.006 * LIQUID) * sin(uv.y * 150.0 + uTime * 2.6) * (0.4 + dd * 12.0), wl + dd);
    vec3 tint = vec3(0.8, 0.88, 1.0) * 0.6 * exp(-dd * 3.0);
    c = mix(c, texture(uScene, ruv).rgb * tint, REFLECT);
    b1 = mix(b1, texture(uB1, ruv).rgb * tint, REFLECT); b2 = mix(b2, texture(uB2, ruv).rgb * tint, REFLECT); b3 = mix(b3, texture(uB3, ruv).rgb * tint, REFLECT);
  }
  // focus pull: full, busy sections sharper, quiet ones softer
  vec3 base = mix(c, b1 * 1.2 + b2 * 0.6 + c * 0.25, DEFOCUS * mix(1.0, 0.35, FOCUS_PULL * uFull));
  // LED board: the picture through a grid of round LEDs. Each LED shows the colour at its cell's centre (picture plus
  // its first blur, so it glows smoothly) at full hue - a dim area lights its LED dimly but in its true colour; unlit
  // LEDs keep a faint cool base; a glint at the top left of the lens and a soft halo into the gap
  if (LED > 0.0) {
    float cell = max(3.0, LED_SIZE * uRes.y / 100.0);
    vec2 pxl = gl_FragCoord.xy / cell, ci = floor(pxl) + 0.5, f = pxl - ci, cuv = ci * cell / uRes;
    vec3 src = texture(uScene, cuv).rgb + texture(uB1, cuv).rgb * 0.6;
    float lum = max(src.r, max(src.g, src.b)), on = clamp(lum * 1.4, 0.0, 1.0);
    if (LED_LEVELS > 0.5) on = ceil(on * LED_LEVELS - 0.15) / LED_LEVELS;
    vec3 hue = src / max(lum, 1e-3);
    float dd = length(f), lens = smoothstep(0.42, 0.34, dd);
    vec3 led = lens * (hue * on * (0.85 + 0.3 * (1.0 - dd * 2.0)) + LED_OFF * 0.05 * vec3(0.6, 0.65, 0.8));
    led += lens * smoothstep(0.2, 0.0, length(f - vec2(-0.12, 0.12))) * on * 0.3;
    led += hue * exp(-dd * dd * 10.0) * on * 0.25;
    base = mix(base, led, LED);
  }
  // scan sweep: a band crossing the frame left to right once per bar; the dots under it brighten (the background
  // doesn't), and a faint scan line marks it
  float scanX = fract(uSpinC / 6.2832), scanB = SCAN * exp(-pow((uv.x - scanX) / 0.018, 2.0));
  base *= 1.0 + 1.6 * scanB;
  // the glow's colour by temperature: the cool colour while the music runs cool, the palette's hot colour as it heats
  vec3 coolGlow = mix(uCoolA, uCoolB, COOL_HUE); coolGlow /= max(coolGlow.r, max(coolGlow.g, coolGlow.b));
  vec3 glowCol = mix(coolGlow, uGlowHot, uWarm);
  // the wide bloom keeps mostly the palette's own tint, leaning a little with temperature (all the way, it hazed
  // every palette in the cool colour)
  vec3 glow = b2 * BLOOM_NEAR + b3 * BLOOM_WIDE * mix(uBloomTint, glowCol, 0.3 * COOL_AIR);
  // lens streaks: the brightest beads smear sideways, like an anamorphic lens (only what's above a threshold)
  if (STREAKS > 0.0) {
    vec3 st = vec3(0.0);
    for (float k = -7.0; k <= 7.0; k += 1.0) st += max(texture(uB2, suv + vec2(k * 0.018, 0.0)).rgb - 0.18, 0.0) * exp(-abs(k) * 0.3);
    glow += st * STREAKS * 0.35 * mix(vec3(0.75, 0.85, 1.0), uGlint / max(uGlint.r, max(uGlint.g, uGlint.b)), 0.5);
  }
  float r = length((uv - 0.5) * vec2(uRes.x / uRes.y, 1.0));
  // shockwave ring: on a drop, a ring of light expands out from the cover and fades (faded in over 0.12 s)
  if (SHOCK_RING > 0.0 && uRingT < 4.0) {
    float ring = exp(-pow((r - (0.16 + uRingT * 0.55)) / 0.012, 2.0)) * smoothstep(0.0, 0.12, uRingT) * exp(-uRingT * 1.6);
    glow += glowCol * ring * SHOCK_RING * 0.8;
  }
  if (SCAN > 0.0) glow += uGlint / max(uGlint.r, max(uGlint.g, uGlint.b)) * scanB * 0.05 * smoothstep(0.42, 0.2, abs(uv.y - 0.5));
  // orbit ring: 24 beads circling the cover once per bar, glowing with the music
  if (ORBIT > 0.0 && abs(r - 0.205) < 0.03) {
    vec2 cvo = (uv - 0.5) * vec2(uRes.x / uRes.y, 1.0);
    for (float k = 0.0; k < 24.0; k += 1.0) { float an = k / 24.0 * 6.2832 + uSpinC; vec2 bp = 0.205 * vec2(cos(an), sin(an));
      glow += glowCol * ORBIT * (0.35 + 0.9 * clamp(uLevel * 2.0, 0.0, 1.0)) * exp(-dot(cvo - bp, cvo - bp) / 0.000025) * 0.6; }
  }
  // melody ribbon: the last two seconds of the melody's place, on both wings, rising above the line as they age
  if (MELODY_RIBBON > 0.0 && uv.y > 0.5) {
    float gapM = 0.11 * uRes.y / uRes.x, wingM = 0.46 - gapM;
    for (int k = 0; k < 32; k++) {
      if (uMelStr[k] < 0.02) continue;
      float age = float(k) / 16.0, yy = 0.5 + 0.04 + age * 0.2, xo = gapM + wingM * uMelPos[k];
      vec2 d1 = (uv - vec2(0.5 - xo, yy)) * vec2(uRes.x / uRes.y, 1.0), d2 = (uv - vec2(0.5 + xo, yy)) * vec2(uRes.x / uRes.y, 1.0);
      glow += mix(glowCol, vec3(1.0), 0.4) * MELODY_RIBBON * uMelStr[k] * (1.0 - age / 2.0) * (exp(-dot(d1, d1) / 0.00003) + exp(-dot(d2, d2) / 0.00003)) * 0.7;
    }
  }
  vec2 d = (uv - 0.5) * vec2(0.8, 3.0);
  // the glow behind the line: violet while the music runs cool, warming toward the palette's hot colour only as the
  // columns heat up (it was a fixed red-pink - a red fog over every palette)
  vec3 back = glowCol * exp(-length(d) * 4.0) * (0.06 + GLOW_PULSE * clamp(uLevel * 2.5, 0.0, 1.0) + PAD_GLOW * 0.35 * uPad + CHORD_PULSE * 0.25 * uChord);
  // menu waves: three soft ribbons of light flowing across behind the fountain, each a thin bright line in a wide soft
  // band, their swell growing with the music
  if (MENU_WAVES > 0.0) {
    float wv = 0.0;
    for (int k = 0; k < 3; k++) { float fk = float(k);
      float y0 = 0.5 + (0.10 + 0.05 * fk) * sin(uv.x * (2.0 + fk * 0.7) + uTime * (0.25 + 0.1 * fk) + fk * 2.0) * (0.6 + 0.8 * clamp(uLevel * 2.0, 0.0, 1.0));
      float dy = uv.y - y0; wv += exp(-dy * dy / (0.0008 + 0.0006 * fk)) * (0.32 - 0.08 * fk) + exp(-dy * dy / 0.02) * 0.05; }
    back += mix(glowCol, vec3(1.0), 0.35) * wv * MENU_WAVES;
  }
  // bubble lights: 14 out-of-focus orbs drifting up at their own pace, a bright rim like a lens's bokeh, brighter with
  // the music
  if (ORBS > 0.0) {
    for (int k = 0; k < 14; k++) { float fk = float(k);
      vec2 hs = fract(sin(vec2(fk * 12.9898 + 1.3, fk * 78.233 + 4.1)) * 43758.5453);
      vec2 c0 = vec2(hs.x, fract(hs.y + uTime * (0.015 + 0.03 * fract(hs.x * 5.7))));
      float rad = 0.03 + 0.05 * fract(hs.x * 7.3), od = length((uv - c0) * vec2(uRes.x / uRes.y, 1.0));
      float orb = smoothstep(rad, rad * 0.85, od) * (0.5 + 0.5 * smoothstep(rad * 0.3, rad, od));
      back += mix(glowCol, uGlint / max(uGlint.r, max(uGlint.g, uGlint.b)), fract(hs.x * 3.1)) * orb * ORBS * 0.1 * (0.4 + 1.5 * clamp(uLevel, 0.0, 1.0)); }
  }
  vec2 e = min(uv, 1.0 - uv);
  float fade = smoothstep(0.0, 0.05, e.x) * smoothstep(0.0, 0.14, e.y);
  float shadow = mix(0.25, 1.0, smoothstep(0.15, 0.21, r));
  vec3 col = clamp((base + glow + back) * fade * shadow - 0.02, 0.0, 1.0) / 0.98;
  // CRT: scanlines and darker edges; film grain (faint, scaled by the picture so black stays black)
  col *= 1.0 - CRT * 0.22 * (0.5 + 0.5 * cos(gl_FragCoord.y * 3.14159));
  col *= mix(1.0, smoothstep(0.85, 0.25, length(cc)), CRT * 0.55);
  col = clamp(col + GRAIN * 0.05 * (hash(gl_FragCoord.xy + fract(uTime * 7.13) * 100.0) - 0.5) * (0.3 + col), 0.0, 1.0);
  outColor = vec4(col, 1.0);
}
