vec2 H2(float c, float s) { return fract(sin(vec2(dot(vec2(c, s), vec2(12.9898, 78.233)), dot(vec2(c, s), vec2(39.3468, 11.135)))) * 43758.5453); }
vec3 ACES(vec3 x) { return clamp(x * (2.51 * x + 0.03) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0); }
float CurveB(float x) { float s = clamp(x / 0.205, 0.0, 1.0); return x < 0.205 ? 0.745 * s * s * (3.0 - 2.0 * s) : 1.0 - 0.255 * exp(-5.3 * (x - 0.205)); }
const vec3 LUM = vec3(0.2126, 0.7152, 0.0722);
// how far a dot has turned to an accent: 0 below its own threshold s (0..1), 1 once the strength is 0.4 past it -
// the strength sets how many dots turn, and each dot turns over a band of it (never at once)
float popDot(float amount, float s) { return smoothstep(s, s + 0.4, amount); }
// an accent colour at the dot's own brightness: a change of colour, not a flash
vec3 lumMatch(vec3 c, vec3 ref) { return c * dot(ref, LUM) / max(dot(c, LUM), 1e-4); }
// an accent softened toward its own grey (30% less saturated), so it comes in naturally over the palette
vec3 soften(vec3 c) { return mix(vec3(dot(c, LUM)), c, 0.7); }
float CurveA(float x) { float s = clamp(x / 0.49, 0.0, 1.0); return x < 0.49 ? 0.6 * s * s * (3.0 - 2.0 * s) : 0.6 * (1.0 - x) / 0.51; }
// The fountain at one point in column space: fx = along the wing (0 at the cover .. 48 at the tip), zy = across it in
// column widths (out from the line), left = which wing, dxs = how wide a column is here against its base width (a ring's
// columns widen outward; scaling dx keeps the dots their size)
vec3 fountain(float fx, float zy, bool left, float dxs) {
  float i = clamp(floor(fx), 0.0, 47.0);
  float dx = (fx - i - 0.5) * dxs;
  float g = left ? 47.0 - i : 48.0 + i;
  vec3 acc = vec3(0.0);
  if (fx >= 0.0 && fx <= 48.0 && abs(dx) < 0.42) {
    vec4 A = texelFetch(uColA, ivec2(int(g), 0), 0);   // live, kick envelope, slow level, rate
    vec4 B = texelFetch(uColB, ivec2(int(g), 0), 0);   // fling, fling velocity
    vec4 C = texelFetch(uColC, ivec2(int(g), 0), 0);   // melody highlight, place in the spectrum (0 low .. 1 high), reach
    float live = A.x;
    // beyond the column's reach this frame no dot of it can be here (the engine works the reach out, every multiplier at
    // its ceiling) - skip them all
    if (abs(zy) <= C.z) for (float s = 0.0; s < 30.0; s += 1.0) {
      vec2 h = H2(g, s);
      vec2 u = H2(g + 97.0, s + 13.0);
      float life = sqrt(1.0 + LIFE_SPREAD * h.x);
      float na = fract(uTime / life + h.y);
      float born = texelFetch(uHist, ivec2(int(g), int(min(floor(na * life * 60.0), 127.0))), 0).r;
      float b = mix(CurveB(na), 1.0, LIVE);
      float level = mix(born, live, b);
      float k = (1.0 - 2.0 * u.x) * (u.y - 0.5);
      k = sign(k) * pow(abs(k) * 2.0, CORE) * 0.5;
      float tip = abs(k) * 2.0;
      level = mix(level, A.z, CORE_HOLD * (1.0 - smoothstep(0.0, CORE_SIZE, tip)));
      // launch: 07's motion - the dot leaves the line and rises over its life
      float ls = LAUNCH_SPEED, e1 = 1.0 - exp(-ls);
      float travel = mix(1.0, (1.0 - exp(-ls * na)) / e1, LAUNCH);
      float travelD = LAUNCH * ls * exp(-ls * na) / e1 / life;
      // fountain arc: up and back down under gravity over the dot's life (a parabola, peak at mid-life)
      travel = mix(travel, 4.0 * na * (1.0 - na), GRAVITY);
      travelD = mix(travelD, 4.0 * (1.0 - 2.0 * na) / life, GRAVITY);
      // rain: one-sided gravity - up first (whichever side the dot started on), peak at 0.3 of its life, back through
      // the line, down to a floor FLOOR below it, bouncing with BOUNCE of its speed each time (three bounces)
      if (RAIN > 0.0) {
        float gv = 22.2, v0 = 6.67, tt = na, zr = v0 * tt - 0.5 * gv * tt * tt, vr = v0 - gv * tt;
        float t1 = (v0 + sqrt(v0 * v0 + 2.0 * gv * FLOOR)) / gv;
        if (tt > t1) {
          float vb = -(v0 - gv * t1) * BOUNCE, ts = t1;
          for (int bb = 0; bb < 3; bb++) {
            float tn = ts + 2.0 * vb / gv, u2 = min(tt, tn) - ts;
            zr = -FLOOR + vb * u2 - 0.5 * gv * u2 * u2; vr = vb - gv * u2;
            if (tt <= tn) break;
            vb *= BOUNCE; ts = tn; zr = -FLOOR; vr = 0.0;
          }
        }
        travel = mix(travel, zr * sign(k), RAIN);
        travelD = mix(travelD, vr * sign(k) / life, RAIN);
      }
      // fling: the column's spring, felt by the outer dots
      float tipW = pow(tip, FLING_TIP);
      float flm = 1.0 + FLING * B.x * tipW;
      float flD = FLING * B.y * tipW;
      // breakdown breathing: in quiet sections the columns slowly swell and settle (every 4 s)
      float calm = DYNAMICS * (1.0 - uSection);
      float cool = COOL_AIR * (1.0 - smoothstep(0.0, 0.35, B.z));   // how quiet this column is right now (faded)
      float base = level * k * 2.0 * REACH * (1.0 + BREATH * calm * sin(uTime * 1.5708)) * (1.0 + 0.35 * TENSION * uTension);
      base *= 1.0 + 0.18 * cool * sin(uTime * 1.3 + g * 0.35);   // a slow sway travelling along the quiet columns
      base *= 1.0 + PAD_SWELL * uPad * (1.0 - smoothstep(0.0, 0.6, tip));   // held chords swell the inner dots
      base *= 1.0 + 0.6 * CHORD_PULSE * uChord * (1.0 - smoothstep(0.0, 0.6, tip));   // ...and a new chord, for a moment
      base *= 1.0 + 0.45 * MELODY * C.x;   // the melody's place lifts a little
      float z = base * travel * flm;
      // the dot's own speed (column widths a second): launch, fling and level change
      float vz = base * (travelD * flm + travel * flD) + k * 2.0 * REACH * travel * flm * A.w * 60.0 * b;
      float stretch = 1.0 + STRETCH_MAX * clamp(abs(vz) * STRETCH_GAIN, 0.0, 1.0);
      float size = (0.25 + 0.15 * fract(h.x * 7.31 + u.x * 3.17)) * SIZE;
      // dots keep the pixel size they have at 2050 px wide (the bench on a 2880 px screen, where the look was tuned): a
      // column is wing * width / 48 px, so on a wider frame (Playnite's 2560) they'd grow with it and read ~25% softer
      size *= min(1.0, 2050.0 / uRes.x);
      // splash: in the last 14% of its life a landing dot bounces a little and scatters to one side of its column
      float spl = GRAVITY * SPLASH * smoothstep(0.86, 1.0, na);
      float zs = z + sign(k) * 0.6 * GRAVITY * SPLASH * sin(3.14159 * smoothstep(0.86, 1.0, na));
      // digital steps: the height snapped to a grid (0.6 to 3 column widths) - a segmented readout
      if (QUANTIZE > 0.0) { float qs = mix(0.6, 3.0, QUANTIZE); zs = floor(zs / qs + 0.5) * qs; }
      vec2 d = vec2(dx - (h.x > 0.5 ? 0.3 : -0.3) * spl, (zy - zs) / stretch) / size;
      float disc = 1.0 - smoothstep(0.0, 1.0, length(d));
      if (disc <= 0.0) continue;   // not inside this dot: it adds nothing here, so skip its colour
      // ---- colour: the palette first, accents on top. Every accent follows one rule - its strength decides HOW MANY
      // dots take its colour (each dot has its own threshold per accent), never how far every dot shifts - so a bar is
      // always a mix of the palette and accents, never one flat tint. Each accent has a coverage budget so the palette
      // keeps the majority (cool air had ~70% of all dots - anything not hot counted as cool): heat <= ~1/3 of the dots
      // even at loud tips, cool <= ~1/4, breakdown <= ~1/3; a kick passes, so it may take more for a moment. The strengths are faded upstream and each dot
      // turns over a band of them, so nothing snaps; accents keep the dot's brightness. Where they overlap the later
      // one wins: heat, cool, breakdown, kick.
      // the palette's own blend: random per dot, lows to highs, or core to tips
      float cg = uGrad == 1 ? C.y : (uGrad == 2 ? tip : (uGrad == 4 ? g / 95.0 : fract(h.y * 5.17 + u.y * 2.31)));
      cg = mix(cg, smoothstep(0.45, 0.55, cg), uSplit);   // two-tone palettes: one colour or the other
      // temperature: the column's faded loudness, cooler toward the core (COLOR_TIPS), only the loud parts high
      // (COLOR_CURVE)
      float T = pow(clamp(B.z * 1.5, 0.0, 1.0), COLOR_CURVE) * mix(1.0, smoothstep(0.1, 0.9, tip), COLOR_TIPS);
      // the harmony's temperature: major chords and wandering from the home key warm the line (more dots take the hot
      // colour, as loudness does); minor chords cool it (below)
      T = min(1.0, T + 0.35 * MODE_TEMP * max(uMode, 0.0) + 0.45 * KEY_HEAT * uAway);
      // sections and chords: they lean the palette's balance between its own two colours (a chorus might run warmer) -
      // the palette stays itself; only a small hue turn is left for them below
      cg = clamp(cg + 0.3 * clamp(SECTION_LOOK * uSecHue / 0.85 + HARMONY_HUE * uHarm * 0.6, -1.0, 1.0), 0.0, 1.0);
      // heat: the hotter the spot, the more of its dots take the palette's hot colour (loud tips ~half, the core none)
      cg = mix(cg, uHotMax, min(1.0, (0.4 + 0.6 * ACCENT) * COLOR_LEVEL * uHeatGain) * popDot(T * (0.6 + TEMP_AMOUNT), fract(h.y * 9.13 + u.x * 4.71)));
      vec3 col = (uColMid.x < 0.0 ? mix(uColMin, uColMax, cg) : (cg < 0.5 ? mix(uColMin, uColMid, cg * 2.0) : mix(uColMid, uColMax, cg * 2.0 - 1.0))) * 0.12;
      if (uGrad == 3) col = (1.0 + 6.0 * (0.5 + 0.5 * cos(6.2832 * (C.y * 0.8 + vec3(0.0, 0.33, 0.67))))) * 0.12;
      // cool: the cooler the spot (the core, small rings, quiet columns) and while a throw settles back, the more of
      // its dots take the palette's cool shade (Cool colour picks between its two)
      float coolT = 1.0 - smoothstep(0.0, 0.45, T);
      float coolness = coolT + (1.0 - coolT) * MOVE_COOL * B.w * smoothstep(0.2, 0.8, tip);
      coolness = min(1.0, coolness + 0.6 * MODE_TEMP * max(-uMode, 0.0));
      vec3 airCol = soften(lumMatch(mix(uCoolA, uCoolB, COOL_HUE), col));
      col = mix(col, airCol, clamp(ACCENT * COOL_AIR * uCoolGain, 0.0, 1.0) * popDot(coolness * (0.25 + 0.5 * TEMP_AMOUNT), fract(h.x * 6.37 + u.y * 2.93)));
      // breakdown: in a quiet stretch with a weak beat, some dots take the palette's breakdown colours
      vec3 calmCol = soften(lumMatch(mix(uCalmA, uCalmB, fract(h.y * 3.7 + u.x * 1.9)), col));
      col = mix(col, calmCol, ACCENT * popDot(CALM_COLOR * calm * 0.6, fract(h.x * 3.31 + u.y * 8.17)));
      // kick (and a drop, and a build-up's tension): some of the thrown outer dots take the kick colour
      float kickAmt = (KICK_COLOR * A.y + DYNAMICS * uDrop * 0.6 + TENSION * uTension * 0.5) * tipW;
      col = mix(col, soften(lumMatch(uKick, col)), min(1.0, ACCENT * 1.2) * popDot(kickAmt, fract(h.y * 7.71 + u.x * 2.57)));
      // hi-hat sparkle: in the treble columns, a changing few dots glint toward white-cyan with the hats - colour only
      float treble = smoothstep(0.58, 0.83, C.y);
      float ph = uTime * 4.0 + fract(h.x * 7.7 + u.y * 3.1);   // each dot's own quarter-second slot
      float pick = step(0.82, fract(h.x * 13.7 + u.y * 5.3 + floor(ph) * 0.37)) * pow(sin(3.14159 * fract(ph)), 2.0);
      vec3 glint = lumMatch(uGlint, col);
      col = mix(col, glint, clamp(DYNAMICS * SPARKLE * treble * pick * (A.y * 1.5 + TENSION * uTension * 0.6), 0.0, 1.0));
      // the hits whiten a dot (its own brightness, no hue) rather than tint it: the glint's pale cyan, brightness-matched
      // to a dim magenta dot, is mostly green - on dense guitar songs the snare flare turned the wings visibly green
      vec3 white = vec3(dot(col, LUM));
      // hats (the high band's hits): the treble columns' dots flash whiter with them - colour only
      col = mix(col, white, clamp(HAT_SPARKLE * treble * pick * 2.5 * uHitHigh, 0.0, 1.0));
      // snare (the mid band's hits, 1.5-5 kHz - the columns from ~0.2 to ~0.46 along the wing): a crack of light - some
      // of their dots whiten, and only a slight lift (kicks change colour, not brightness: photosensitivity)
      float midW = smoothstep(0.12, 0.22, C.y) * (1.0 - smoothstep(0.46, 0.6, C.y));
      float snare = SNARE_FLARE * uHitMid * midW;
      col = mix(col, white, popDot(snare, fract(h.x * 5.91 + u.y * 7.37)));
      col *= 1.0 + 0.25 * min(1.0, snare);
      // phrase colour drift: every 8 bars the hue turns a little (about the grey axis, so brightness holds)
      // phrase, harmony and section turn the hue only a little (at most ~12 degrees): more would carry every palette
      // off its own colours (an orange palette went magenta at 60)
      // (with the section sweep, a new section's hue reaches each column as a front running out from the cover)
      float secH = SECTION_SWEEP > 0.5 ? mix(uSecPrev, uSecNext, smoothstep(fx / 48.0 - 0.15, fx / 48.0, uSweep * 1.15)) : uSecHue;
      float ang = clamp(PHRASE_HUE * 0.6 * sin(uPhrase * 2.39996) + HARMONY_HUE * 1.2 * uHarm + SECTION_LOOK * secH, -1.0, 1.0) * 0.21;
      vec3 kk = vec3(0.57735);
      col = col * cos(ang) + cross(kk, col) * sin(ang) + kk * dot(kk, col) * (1.0 - cos(ang));
      col = max(col, vec3(0.0));
      // only the kicked outer dots flash; a streak spreads its light rather than adding to it
      float alpha = mix(CurveA(na), 0.6 * smoothstep(0.0, 0.08, na) * (1.0 - smoothstep(0.94, 1.0, na)), max(GRAVITY, RAIN));
      acc += col * disc * disc * alpha * BRIGHT * (1.0 + FLASH * A.y * tipW + 0.8 * MELODY * C.x) / mix(1.0, stretch, STRETCH_DIM);
    }
  }
  // embers: six small sparks per column, thrown up on the hits (the column's kick), drifting side to side as they rise
  // and fade; mostly upward. Colour: the palette's sparkle, at a fixed modest brightness
  if (EMBERS > 0.0 && fx >= 0.0 && fx <= 48.0) {
    vec4 Ae = texelFetch(uColA, ivec2(int(g), 0), 0);
    for (float s = 0.0; s < 6.0; s += 1.0) {
      vec2 h = H2(g + 311.0, s);
      float life = 1.2 + 1.2 * h.x, na = fract(uTime / life + h.y);
      float z = (h.y > 0.2 ? 1.0 : -1.0) * pow(na, 0.8) * (8.0 + 18.0 * h.x);
      float ex = dx - 0.25 * sin(na * 12.0 + h.x * 6.2832);
      vec2 de = vec2(ex, zy - z) / 0.12;
      float glow = max(0.0, 1.0 - dot(de, de));
      acc += uGlint * 0.12 * 0.6 * glow * glow * pow(1.0 - na, 1.5) * smoothstep(0.0, 0.1, na) * (0.15 + Ae.y) * EMBERS * BRIGHT;
    }
  }
  return acc;
}
// the line's own shape, as an offset from straight in column widths: wing bend and tilt, a travelling wave, heartbeat
// spikes, a plucked string's modes
float lineShape(float fx, bool left) {
  float wf = clamp(fx / 48.0, 0.0, 1.0);
  // wing bend: the bass lifts the wing tips (a bow); tilt toward the louder stereo side
  float y = BEND * uBend * 6.0 * wf * wf + BALANCE * uBal * 6.0 * wf * (left ? 1.0 : -1.0);
  // travelling wave: two crests across a wing, rolling out from the cover once per bar, taller with the music
  y += WAVE_LINE * (0.6 + 2.4 * uLevelL) * sin(6.2832 * (wf * 2.0 - uBarPhase));
  // heartbeat: each recent beat is a spike (and a small dip behind it) running out along the line
  for (int b = 0; b < 4; b++) { float x = wf - uBeatAge[b] * 1.4; y += HEARTBEAT * uBeatAmp[b] * 3.0 * (exp(-x * x / 0.0004) - 0.4 * exp(-(x + 0.035) * (x + 0.035) / 0.0009)); }
  // raised wings: a V in full sections and on drops, a droop in breakdowns
  y += WINGS * (uSection * 1.4 - 0.4 + uDrop * 1.2) * wf * 10.0;
  // plucked string: the wing's six modes, pinned at the cover and the tip
  for (int m = 0; m < 6; m++) y += STRING * (left ? uModesL[m] : uModesR[m]) * sin(float(m + 1) * 3.14159 * wf);
  return y;
}
// a layout: where in column space this pixel is, for the line (0), a halo ring (1), an arch (2) or a spiral (3)
vec3 layoutAt(float L, vec2 p) {
  float aspect = uRes.x / uRes.y;
  if (L > 3.5) {
    // horizon: the wings recede toward the distance - the tips smaller, and the line rising toward a horizon. Screen
    // position u along a wing maps to depth fxn by u = fxn (1 + a) / (1 + a fxn), things there are 1 / (1 + a fxn) the size
    float gap = 0.11 / aspect, wing = 0.46 - gap, a = 2.0;
    float u = (abs(p.x - 0.5) - gap) / wing;
    float fxn = u / (1.0 + a - a * u), sc = 1.0 / (1.0 + a * fxn);
    float lift = 0.15 * (1.0 - sc) * (1.0 + a) / a;
    float zy = ((0.5 - lift) - p.y) * uRes.y / (wing * uRes.x / 48.0) / sc;
    bool left = p.x < 0.5; float fx = fxn * 48.0;
    return fountain(fx, zy - lineShape(fx, left), left, 1.0);
  }
  if (L < 0.5) {
    float gap = 0.11 / aspect + STEREO_SPREAD * (uWidth - 0.25) * 0.08, wing = 0.46 - gap;   // stereo width pushes the wings out
    float fx = (abs(p.x - 0.5) - gap) / wing * 48.0;
    float zy = (0.5 - p.y) * uRes.y / (wing * uRes.x / 48.0);
    bool left = p.x < 0.5;
    return fountain(fx, zy - lineShape(fx, left), left, 1.0);
  }
  // rings: polar about the cover, in frame heights; each wing runs from the top (its bass) round to the bottom (treble)
  // - or, for the arch, to the horizon. The spiral turns the angle with the radius, and with time (once per bar)
  vec2 q = vec2((p.x - 0.5) * aspect, 0.5 - p.y);
  float r = length(q);
  float R0 = L < 1.5 ? 0.23 : (L < 2.5 ? 0.27 : 0.22);
  if (L > 2.5) { float a = atan(q.y, q.x) + (r - R0) * SPIRAL_TWIST + uSpin; q = r * vec2(cos(a), sin(a)); }
  float ang = acos(clamp(q.y / max(r, 1e-5), -1.0, 1.0));   // 0 at the top .. pi at the bottom
  float span = (L > 1.5 && L < 2.5) ? 1.5708 : 3.14159;
  if (ang > span + 0.05) return vec3(0.0);
  float fx = ang / span * 48.0, colw = span * R0 / 48.0;
  bool left = q.x < 0.0;
  return fountain(fx, (r - R0) / colw - lineShape(fx, left), left, r / R0);
}
void main() {
  vec2 p = vec2(gl_FragCoord.x / uRes.x, 1.0 - gl_FragCoord.y / uRes.y);
  vec3 acc = layoutAt(uLayoutA, p);
  if (uMorph > 0.001) acc = mix(acc, layoutAt(uLayoutB, p), uMorph);   // changing shape: a cross-fade
  outColor = vec4(ACES(acc * EXPOSURE), 1.0);
}
@@BLUR
#version 330 core
uniform sampler2D uSrc;
uniform vec2 uDir;      // one destination texel along the blur
uniform vec2 uDst;      // destination size
out vec4 outColor;
void main() {
  vec2 uv = gl_FragCoord.xy / uDst;
  float w[5] = float[](0.227, 0.194, 0.122, 0.054, 0.016);
  vec3 c = texture(uSrc, uv).rgb * w[0];
  for (int i = 1; i < 5; i++) { c += texture(uSrc, uv + uDir * float(i)).rgb * w[i]; c += texture(uSrc, uv - uDir * float(i)).rgb * w[i]; }
  outColor = vec4(c, 1.0);
}
@@COMP
#version 330 core
