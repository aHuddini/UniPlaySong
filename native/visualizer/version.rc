// Version resource for the renderer and the bridge; build.cmd compiles it once per binary, with /DVIS_BRIDGE for the
// bridge. Its own version, not the extension's: tying it to UniPlaySong's would change both binaries (and their
// VirusTotal reports) every release even when their code did not.
#include <winver.h>

#ifdef VIS_BRIDGE
#define VIS_DESCRIPTION "UniPlaySong music visualizer - Playnite display bridge"
#define VIS_NAME "UniPlaySongVisualizerBridge"
#define VIS_FILENAME "UniPlaySongVisualizerBridge.dll"
#define VIS_FILETYPE VFT_DLL
#else
#define VIS_DESCRIPTION "UniPlaySong music visualizer - renderer"
#define VIS_NAME "UniPlaySongVisualizer"
#define VIS_FILENAME "UniPlaySongVisualizer.exe"
#define VIS_FILETYPE VFT_APP
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VIS_FILETYPE
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "UniPlaySong Contributors"
      VALUE "FileDescription", VIS_DESCRIPTION
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", VIS_NAME
      VALUE "LegalCopyright", "Copyright (c) 2025-2026 UniPlaySong Contributors. MIT License."
      VALUE "OriginalFilename", VIS_FILENAME
      VALUE "ProductName", "UniPlaySong"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
